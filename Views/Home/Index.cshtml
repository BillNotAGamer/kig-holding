<section class="home-news-section home-news-section--dark section-shell relative isolate overflow-hidden" data-home-section="news">
    <div class="container-page relative z-10">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-[48rem]" data-uw-reveal="fade-up">
                <p class="text-xs font-black uppercase tracking-[0.34em] text-brand-red">TIN TỨC & ƯU ĐÃI</p>
                <h2 class="public-section-title mt-5 text-white">
                    Cập nhật mới từ Truyền Thuyết Champong
                </h2>
                <p class="mt-6 max-w-[44rem] text-sm leading-7 text-white sm:text-[1.04rem] sm:leading-8">
                    Khám phá các chương trình mới, thông tin chi nhánh, sự kiện và những cập nhật mới nhất từ Truyền Thuyết Champong.
                </p>
            </div>

            <div class="flex flex-col items-start gap-4 lg:items-end" data-uw-reveal="fade-up" data-uw-delay="100">
                <div class="flex flex-wrap items-center gap-4">
                    @if (homeNewsPosts.Count > 0)
                    {
                        <span class="inline-flex items-center rounded-full border border-white/12 bg-white/[0.06] px-4 py-2.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white shadow-[0_14px_32px_rgba(0,0,0,0.16)] backdrop-blur">
                            @homeNewsPosts.Count bài viết mới
                        </span>
                    }

                    <a href="/tin-tuc" class="inline-flex items-center justify-center rounded-full bg-brand-red px-6 py-3.5 text-[0.82rem] font-semibold uppercase tracking-[0.16em] text-white shadow-[0_18px_36px_rgba(229,9,20,0.24)] transition duration-300 hover:-translate-y-0.5 hover:bg-brand-redDark">
                        Xem tất cả tin tức
                    </a>
                </div>

                @await Component.InvokeAsync("SuggestedPostCategories", new { mode = "Home", limit = 4, poolSize = 8, rotateWithinRecentPool = true })
            </div>
        </div>

        @if (homeNewsPosts.Count > 0)
        {
            <div class="mt-12 flex items-center justify-between gap-4" data-uw-reveal="fade-up" data-uw-delay="140">
                <p class="text-xs font-black uppercase tracking-[0.28em] text-white">Nổi bật trong tuần</p>
                <div class="home-news-slider__controls">
                    <a href="/tin-tuc" class="home-news-slider__all">Xem trang tin tức</a>
                    <button type="button" class="home-news-slider__nav" data-news-slider-prev aria-controls="home-news-track" aria-label="Xem bài trước" disabled>
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
                    </button>
                    <button type="button" class="home-news-slider__nav" data-news-slider-next aria-controls="home-news-track" aria-label="Xem bài tiếp theo">
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"></path></svg>
                    </button>
                </div>
            </div>

            <div class="home-news-slider mt-7" data-news-slider data-uw-reveal="fade-up" data-uw-delay="180">
                <div id="home-news-track"
                     class="home-news-slider__track"
                     data-news-slider-track
                     role="region"
                     aria-roledescription="carousel"
                     aria-label="Bài viết mới từ Truyền Thuyết Champong"
                     tabindex="0">
                    @for (var i = 0; i < homeNewsPosts.Count; i++)
                    {
                        var post = homeNewsPosts[i];
                        var postHasImage = !string.IsNullOrWhiteSpace(post.ImageUrl);
                        var postImageUrl = postHasImage ? MediaUrlHelper.GetNewsCardImageUrl(post.ImageUrl) : string.Empty;

                        <article class="home-news-slider__card group" aria-roledescription="slide" aria-label="@(i + 1) / @homeNewsPosts.Count">
                            <a href="@post.Url" class="home-news-slider__link" aria-label="@post.Title" draggable="false">
                                <div class="home-news-slider__media @(postHasImage ? string.Empty : "is-image-missing")" data-home-news-media>
                                    <div class="home-news-slider__fallback" aria-hidden="true">
                                        <span>Truyền Thuyết Champong</span>
                                        <p>@post.Title</p>
                                    </div>

                                    @if (postHasImage)
                                    {
                                        <img src="@postImageUrl"
                                             alt=""
                                             aria-hidden="true"
                                             class="home-news-slider__backdrop"
                                             draggable="false"
                                             loading="lazy"
                                             decoding="async" />
                                        <img src="@postImageUrl"
                                             alt="@post.Title"
                                             class="home-news-slider__image"
                                             draggable="false"
                                             loading="lazy"
                                             decoding="async"
                                             onerror="this.closest('[data-home-news-media]')?.classList.add('is-image-missing'); this.closest('[data-home-news-media]')?.querySelectorAll('img').forEach(function (img) { img.remove(); });" />
                                    }

                                    @if (!string.IsNullOrWhiteSpace(post.Category))
                                    {
                                        <span class="news-card__category news-card__category--solid home-news-slider__category">
                                            @post.Category
                                        </span>
                                    }
                                </div>

                                <div class="home-news-slider__content">
                                    @if (post.PublishedAt.HasValue)
                                    {
                                        <time datetime="@post.PublishedAt.Value.ToString("yyyy-MM-dd")" class="home-news-slider__date">
                                            @post.PublishedAt.Value.ToString("dd/MM/yyyy")
                                        </time>
                                    }

                                    <h3 class="home-news-slider__title">@post.Title</h3>

                                    @if (!string.IsNullOrWhiteSpace(post.Excerpt))
                                    {
                                        <p class="home-news-slider__excerpt">@post.Excerpt</p>
                                    }

                                    <span class="home-news-slider__cta">
                                        <span>Đọc tiếp</span>
                                        <span aria-hidden="true" class="home-news-slider__arrow">→</span>
                                    </span>
                                </div>
                            </a>
                        </article>
                    }
                </div>

                <div class="home-news-slider__progress" aria-hidden="true">
                    <span class="home-news-slider__progress-bar" data-news-slider-progress></span>
                </div>
            </div>
        }
        else
        {
            <div class="mt-10 rounded-[1.6rem] border border-white/10 bg-white/[0.045] p-7 shadow-[0_24px_70px_rgba(0,0,0,0.24)] backdrop-blur" data-uw-reveal="fade-up" data-uw-delay="160">
                <p class="text-lg font-black text-white">Chưa có bài viết mới.</p>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-white/70 sm:text-base">
                    Các cập nhật mới từ Truyền Thuyết Champong sẽ sớm được đăng tải.
                </p>
                <a href="/tin-tuc" class="mt-6 inline-flex items-center justify-center rounded-full bg-brand-red px-5 py-3 text-sm font-semibold uppercase tracking-[0.16em] text-white shadow-soft transition duration-300 hover:-translate-y-0.5 hover:bg-brand-redDark">
                    Xem trang tin tức
                </a>
            </div>
        }
    </div>
</section>

<section class="home-faq section-shell" data-home-section="faq" aria-labelledby="home-faq-title">
    <div class="container-page">
        <div class="home-faq__header" data-uw-reveal="fade-up">
            <p class="home-faq__eyebrow">Câu hỏi thường gặp</p>
            <h2 id="home-faq-title" class="public-section-title mt-4 text-white">
                Nhà hàng Hàn Quốc Champong, Gogi Maru, KBB Cook
            </h2>
            <p class="home-faq__intro">
                Những thông tin thực khách hay hỏi về mì cay champong, mì tương đen, thịt nướng Hàn Quốc và buffet nướng không giới hạn trong hệ thống KIG Holding.
            </p>
        </div>

        <div class="home-faq__list" data-uw-reveal="fade-up" data-uw-delay="100">
            @foreach (var faq in homeFaqs)
            {
                <details class="home-faq__item">
                    <summary class="home-faq__question">@faq.Question</summary>
                    <p class="home-faq__answer">@faq.Answer</p>
                </details>
            }
        </div>

        <nav class="home-faq__links" aria-label="Liên kết nhanh">
            <a class="home-faq__link" href="/thuc-don/nhom/truyen-thuyet-champong">Thực đơn Truyền Thuyết Champong</a>
            <a class="home-faq__link" href="/thuc-don/nhom/gogi-maru">Thực đơn Gogi Maru</a>
            <a class="home-faq__link" href="/thuc-don/nhom/kbb-cook">Buffet nướng KBB Cook</a>
            <a class="home-faq__link" href="/chi-nhanh">Chi nhánh gần bạn</a>
            <a class="home-faq__link" href="/dat-ban">Đặt bàn online</a>
        </nav>
    </div>
</section>

<script type="application/ld+json">@Html.Raw(homeFaqJson)</script>

<section data-home-section="booking"
         class="home-booking-cta"
         data-uw-reveal="fade-up"
         data-uw-once="true">
    <div class="home-booking-cta__overlay"></div>

    <div class="section-shell home-booking-cta__inner">
        <div class="container-page">
            <div class="home-booking-cta__content"
                 data-uw-reveal="fade-up"
                 data-uw-delay="80"
                 data-uw-once="true">
                <p class="home-booking-cta__eyebrow">Reservation</p>

                <h2 class="home-booking-cta__title">
                    Đặt bàn trước cho trải nghiệm trọn vẹn
                </h2>

                <p class="home-booking-cta__description">
                    Giữ chỗ trước để đội ngũ Truyền Thuyết Champong chuẩn bị không gian
                    và trải nghiệm dùng bữa chỉn chu dành cho bạn.
                </p>

                <a href="/dat-ban"
                   class="btn-primary home-booking-cta__button"
                   aria-label="Đi tới trang đặt bàn">
                    Đặt bàn ngay
                </a>
            </div>
        </div>
    </div>
</section>

<div id="home-app-modal"
     class="home-app-modal"
     data-home-app-modal
     aria-hidden="true"
     hidden>
    <div class="home-app-modal__backdrop" data-home-app-modal-backdrop></div>

    <div class="home-app-modal__dialog"
         data-home-app-modal-dialog
         role="dialog"
         aria-modal="true"
         aria-labelledby="home-app-modal-title"
         aria-describedby="home-app-modal-description"
         tabindex="-1">
        <button type="button"
                class="home-app-modal__close"
                data-home-app-modal-close
                aria-label="Đóng cửa sổ tải ứng dụng">
            <span aria-hidden="true">&times;</span>
        </button>

        <div class="home-app-modal__layout">
            <div class="home-app-modal__qr">
                <img src="~/images/general/kig-holding-qr-app.webp"
                     alt="Mã QR tải ứng dụng Truyền Thuyết Champong"
                     class="home-app-modal__qr-image"
                     loading="lazy"
                     decoding="async" />
            </div>

            <div class="home-app-modal__content">
                <p class="home-app-modal__eyebrow">Ứng dụng Truyền Thuyết Champong</p>
                <h2 id="home-app-modal-title" class="home-app-modal__title">
                    Mang Champong về nhà thuận tiện hơn
                </h2>
                <p id="home-app-modal-description" class="home-app-modal__description">
                    Quét mã QR hoặc lựa chọn nền tảng phù hợp để tải ứng dụng.
                </p>

                <div class="home-app-modal__stores" aria-label="Tải ứng dụng">
                    <a href="https://apps.apple.com/vn/app/truy%E1%BB%81n-thuy%E1%BA%BFt-champong-%EC%A0%88%EC%84%A4%EC%9D%98%EC%A7%AC%EB%BD%BB/id6753157313?l=vi"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Tải ứng dụng trên App Store"
                       class="home-app-modal__store-link">
                        <img src="~/images/general/icons/app-store-download.svg"
                             alt="Tải ứng dụng trên App Store"
                             class="home-app-modal__store-badge"
                             asp-append-version="true" />
                    </a>

                    <a href="https://play.google.com/store/apps/details?id=com.eggstech.champong.app&pcampaignid=web_share"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Tải ứng dụng trên Google Play"
                       class="home-app-modal__store-link">
                        <img src="~/images/general/icons/google-play-download.svg"
                             alt="Tải ứng dụng trên Google Play"
                             class="home-app-modal__store-badge"
                             asp-append-version="true" />
                    </a>
                </div>

                <button type="button"
                        class="home-app-modal__continue"
                        data-home-app-modal-close>
                    Tiếp tục trên website
                </button>
            </div>
        </div>
    </div>
</div>

