@model HomeIndexViewModel

@{
    ViewData["Title"] = "Truyền Thuyết Champong - Nhà hàng Hàn Quốc: mì cay champong, buffet nướng";
    ViewData["MetaDescription"] = "Hệ thống nhà hàng Hàn Quốc KIG Holding: Truyền Thuyết Champong mì cay hải sản, mì tương đen; Gogi Maru thịt nướng Hàn Quốc; KBB Cook buffet nướng không giới hạn. Đặt bàn online.";

    var homeFaqs = new[]
    {
        (
            Question: "KIG Holding có những thương hiệu nhà hàng Hàn Quốc nào?",
            Answer: "KIG Holding VN phát triển hệ thống nhà hàng Hàn Quốc tại Việt Nam từ năm 2019 với các thương hiệu: Truyền Thuyết Champong (mì cay hải sản champong, mì tương đen), Gogi Maru (thịt nướng Hàn Quốc), KBB Cook (buffet nướng Hàn Quốc) và Seoul Gukbap (cơm canh truyền thống Hàn Quốc)."
        ),
        (
            Question: "Truyền Thuyết Champong có món gì nổi bật?",
            Answer: "Món signature là champong - mì tươi dai ngon trong nước súp hải sản cay nồng đậm vị. Bên cạnh đó là mì tương đen chuẩn vị Hàn, các món lẩu và bánh gạo truyền thống, phù hợp cho bữa ăn gia đình và nhóm bạn."
        ),
        (
            Question: "Buffet nướng Hàn Quốc KBB Cook giá bao nhiêu?",
            Answer: "KBB Cook có gói buffet nướng tiêu chuẩn 278K bao gồm tất cả các món tại quầy line và gói thượng hạng 458K kèm các món cao cấp. Giá có thể thay đổi theo thời điểm, vui lòng xem thực đơn KBB Cook hoặc liên hệ chi nhánh để cập nhật mới nhất."
        ),
        (
            Question: "Gogi Maru có gì khác so với quán nướng Hàn Quốc thông thường?",
            Answer: "Gogi Maru tập trung vào thịt nướng Hàn Quốc ủ dry-aged, kết hợp kỹ thuật lên men thịt heo và các phần bò nướng thượng hạng trên bếp than hồng, mang đến hương vị đậm đà trong từng lát cắt."
        ),
        (
            Question: "Làm sao để đặt bàn nhà hàng Truyền Thuyết Champong, Gogi Maru, KBB Cook?",
            Answer: "Bạn có thể đặt bàn online trên trang Đặt bàn: chọn chi nhánh, ngày giờ và số khách để giữ chỗ trước. Hệ thống có chi nhánh tại TP.HCM, Bình Dương, Đồng Nai, Đà Lạt và Nha Trang; xem địa chỉ và hotline từng chi nhánh tại trang Chi nhánh."
        ),
        (
            Question: "KIG Holding có nhận nhượng quyền nhà hàng Hàn Quốc không?",
            Answer: "KIG Holding VN chào đón chủ mặt bằng, nhà đầu tư và doanh nghiệp muốn hợp tác phát triển hệ thống nhà hàng Hàn Quốc. Vui lòng để lại thông tin tại trang Liên hệ nhượng quyền để được tư vấn."
        )
    };

    var homeFaqJson = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = homeFaqs.Select(faq => new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = faq.Question,
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = faq.Answer
            }
        }).ToArray()
    });

    ViewData["AutoOpenBookingModal"] = true;

    var menuBrandCards = new[]
    {
        (
            Title: "Truyền Thuyết Champong - 전설의짬뽕",
            Description: "Khám phá hương vị Hàn Quốc nguyên bản qua mì tương đen chuẩn vị trứ danh và những món ăn làm nên tên tuổi thương hiệu.",
            Href: "/thuc-don/nhom/truyen-thuyet-champong",
            ImageUrl: "/images/home/images/truyen-thuyet-champong.webp",
            Alt: "Mì cay hải sản champong và mì tương đen tại nhà hàng Truyền Thuyết Champong",
            Delay: 0,
            PreserveArtwork: false
        ),
        (
            Title: "GOGI MARU - 고기마루",
            Description: "Thưởng thức thịt nướng cao cấp theo phong cách Hàn Quốc, nổi bật với kỹ thuật dry-aged và hương vị được chăm chút trong từng lát cắt.",
            Href: "/thuc-don/nhom/gogi-maru",
            ImageUrl: "/images/home/images/gogimaru-img.webp",
            Alt: "Thịt nướng Hàn Quốc dry-aged tại nhà hàng Gogi Maru",
            Delay: 120,
            PreserveArtwork: false
        ),
        (
            Title: "KBB COOK - BUFFET NƯỚNG HÀN QUỐC 한국식 바비큐 뷔페",
            Description: "Buffet nướng Hàn Quốc đa dạng với thực đơn phong phú, không gian trẻ trung và những khoảnh khắc sum vầy trọn vẹn bên bàn tiệc.",
            Href: "/thuc-don/nhom/kbb-cook",
            ImageUrl: "/images/home/images/kbb-cook-img.webp",
            Alt: "Buffet nướng Hàn Quốc không giới hạn tại KBB Cook",
            Delay: 240,
            PreserveArtwork: false
        ),
        (
            Title: "Seoul Gukbap - 서울 국밥",
            Description: "Khám phá cơm canh truyền thống Hàn Quốc nóng hổi, đậm đà, dễ ăn và phù hợp cho mọi bữa trong ngày.",
            Href: "/thuc-don/nhom/seoul-gukbap",
            ImageUrl: "/images/home/images/seoul-gukbap.jpg",
            Alt: "Seoul Gukbap - cơm canh truyền thống Hàn Quốc",
            Delay: 360,
            PreserveArtwork: true
        )
    };
    var homeNewsPosts = Model.LatestPosts.Take(10).ToList();
}

