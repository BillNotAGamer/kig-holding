<section class="home-news-section home-news-section--dark section-shell relative isolate overflow-hidden" data-home-section="news">
    <div class="container-page relative z-10">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-[48rem]" data-uw-reveal="fade-up">
                <p class="text-xs font-black uppercase tracking-[0.34em] text-brand-red">TIN TỨC & ƯU ĐÃI</p>
                <h2 class="public-section-title mt-5 text-white">
                    Cập nhật mới từ Truyền Thuyết Champong
                </h2>
                <p class="mt-6 max-w-[44rem] text-sm leading-7 text-white sm:text-[1.04rem] sm:leading-8">
                    Khám phá các chương trình mới, thông tin chi nhánh, sự kiện và những cập nhật mới nhất từ Truyền Thuyết Champong.
                </p>
            </div>

            <div class="flex flex-col items-start gap-4 lg:items-end" data-uw-reveal="fade-up" data-uw-delay="100">
                <div class="flex flex-wrap items-center gap-4">
                    @if (homeNewsPosts.Count > 0)
                    {
                        <span class="inline-flex items-center rounded-full border border-white/12 bg-white/[0.06] px-4 py-2.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white shadow-[0_14px_32px_rgba(0,0,0,0.16)] backdrop-blur">
                            @homeNewsPosts.Count bài viết mới
                        </span>
                    }

                    <a href="/tin-tuc" class="inline-flex items-center justify-center rounded-full bg-brand-red px-6 py-3.5 text-[0.82rem] font-semibold uppercase tracking-[0.16em] text-white shadow-[0_18px_36px_rgba(229,9,20,0.24)] transition duration-300 hover:-translate-y-0.5 hover:bg-brand-redDark">
                        Xem tất cả tin tức
                    </a>
                </div>

                @await Component.InvokeAsync("SuggestedPostCategories", new { mode = "Home", limit = 4, poolSize = 8, rotateWithinRecentPool = true })
            </div>
        </div>

        @if (homeNewsPosts.Count > 0)
        {
            var leadPost = homeNewsPosts[0];
            var supportingPosts = homeNewsPosts.Skip(1).Take(2).ToList();
            var homeNewsCountClass = homeNewsPosts.Count switch
            {
                1 => "home-news--count-1",
                2 => "home-news--count-2",
                _ => "home-news--count-3"
            };
            var leadHasImage = !string.IsNullOrWhiteSpace(leadPost.ImageUrl);

            <div class="mt-12 flex items-center justify-between gap-4" data-uw-reveal="fade-up" data-uw-delay="140">
                <p class="text-xs font-black uppercase tracking-[0.28em] text-white">Nổi bật trong tuần</p>
                <a href="/tin-tuc" class="hidden text-sm font-semibold text-white transition hover:text-white sm:inline-flex">
                    Xem trang tin tức
                </a>
            </div>

            <div class="home-news @homeNewsCountClass mt-7">
                <div class="home-news__grid">
                    <article class="news-card news-card--lead home-news__lead group" data-uw-reveal="fade-up" data-uw-delay="180">
                        <a href="@leadPost.Url" class="news-card__link" aria-label="@leadPost.Title">
                            <div class="news-card__media news-card__media--lead home-news__media @(leadHasImage ? string.Empty : "is-image-missing")" data-home-news-media>
                                <div class="home-news__fallback home-news__fallback--lead" aria-hidden="true">
                                    <span class="home-news__fallback-eyebrow">Truyền Thuyết Champong</span>
                                    <p class="home-news__fallback-title home-news__fallback-title--lead">@leadPost.Title</p>
                                </div>

                                @if (leadHasImage)
                                {
                                    <img src="@MediaUrlHelper.GetNewsFeatureImageUrl(leadPost.ImageUrl)"
                                         alt="@leadPost.Title"
                                         class="news-card__image"
                                         loading="lazy"
                                         decoding="async"
                                         onerror="this.closest('[data-home-news-media]')?.classList.add('is-image-missing'); this.remove();" />
                                }

                                <div class="news-card__media-meta home-news__media-meta">
                                    <span class="news-card__category news-card__category--solid">
                                        @leadPost.Category
                                    </span>
                                    @if (leadPost.PublishedAt.HasValue)
                                    {
                                        <time datetime="@leadPost.PublishedAt.Value.ToString("yyyy-MM-dd")"
                                              class="news-card__date-pill">
                                            @leadPost.PublishedAt.Value.ToString("dd/MM/yyyy")
                                        </time>
                                    }
                                </div>
                            </div>

                            <div class="news-card__content news-card__content--lead home-news__content home-news__content--lead">
                                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-white/45">Bài nổi bật</p>
                                <h3 class="news-card__title news-card__title--lead line-clamp-3">
                                    @leadPost.Title
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(leadPost.Excerpt))
                                {
                                    <p class="news-card__excerpt news-card__excerpt--lead line-clamp-3">
                                        @leadPost.Excerpt
                                    </p>
                                }

                                <span class="news-card__cta news-card__readmore">
                                    <span>Đọc tiếp</span>
                                    <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">→</span>
                                </span>
                            </div>
                        </a>
                    </article>

                    @if (supportingPosts.Count > 0)
                    {
                        <div class="home-news__secondary">
                            @for (var i = 0; i < supportingPosts.Count; i++)
                            {
                                var post = supportingPosts[i];
                                var postHasImage = !string.IsNullOrWhiteSpace(post.ImageUrl);

                                <article class="news-card news-card--secondary home-news__support group" data-uw-reveal="fade-up" data-uw-delay="@(240 + (i * 80))">
                                    <a href="@post.Url" class="news-card__link" aria-label="@post.Title">
                                        <div class="news-card__media news-card__media--secondary home-news__media @(postHasImage ? string.Empty : "is-image-missing")" data-home-news-media>
                                            <div class="home-news__fallback" aria-hidden="true">
                                                <span class="home-news__fallback-eyebrow">Tin mới</span>
                                                <p class="home-news__fallback-title">@post.Title</p>
                                            </div>

                                            @if (postHasImage)
                                            {
                                                <img src="@MediaUrlHelper.GetNewsCardImageUrl(post.ImageUrl)"
                                                     alt="@post.Title"
                                                     class="news-card__image"
                                                     loading="lazy"
                                                     decoding="async"
                                                     onerror="this.closest('[data-home-news-media]')?.classList.add('is-image-missing'); this.remove();" />
                                            }

                                            <span class="news-card__category news-card__category--floating">
                                                @post.Category
                                            </span>
                                        </div>

                                        <div class="news-card__content news-card__content--secondary home-news__content home-news__content--secondary">
                                            @if (post.PublishedAt.HasValue)
                                            {
                                                <time datetime="@post.PublishedAt.Value.ToString("yyyy-MM-dd")" class="news-card__date">
                                                    @post.PublishedAt.Value.ToString("dd/MM/yyyy")
                                                </time>
                                            }

                                            <h3 class="news-card__title news-card__title--secondary line-clamp-2">
                                                @post.Title
                                            </h3>

                                            @if (!string.IsNullOrWhiteSpace(post.Excerpt))
                                            {
                                                <p class="news-card__excerpt news-card__excerpt--secondary line-clamp-2">
                                                    @post.Excerpt
                                                </p>
                                            }

                                            <span class="news-card__cta news-card__readmore">
                                                <span>Đọc tiếp</span>
                                                <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">→</span>
                                            </span>
                                        </div>
                                    </a>
                                </article>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="mt-10 rounded-[1.6rem] border border-white/10 bg-white/[0.045] p-7 shadow-[0_24px_70px_rgba(0,0,0,0.24)] backdrop-blur" data-uw-reveal="fade-up" data-uw-delay="160">
                <p class="text-lg font-black text-white">Chưa có bài viết mới.</p>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-white/70 sm:text-base">
                    Các cập nhật mới từ Truyền Thuyết Champong sẽ sớm được đăng tải.
                </p>
                <a href="/tin-tuc" class="mt-6 inline-flex items-center justify-center rounded-full bg-brand-red px-5 py-3 text-sm font-semibold uppercase tracking-[0.16em] text-white shadow-soft transition duration-300 hover:-translate-y-0.5 hover:bg-brand-redDark">
                    Xem trang tin tức
                </a>
            </div>
        }
    </div>
</section>

