@model ContactCreateViewModel

@{
    ViewData["Title"] = "Liên hệ";
    ViewData["MetaDescription"] = "Liên hệ Truyền Thuyết Champong để góp ý, đặt tiệc, hợp tác và nhượng quyền.";

    var hotlineHref = $"tel:{Model.Hotline.Replace(" ", string.Empty)}";
    var hasFacebook = !string.IsNullOrWhiteSpace(Model.FacebookUrl) && !string.Equals(Model.FacebookUrl, "#", StringComparison.Ordinal);
    var hasZalo = !string.IsNullOrWhiteSpace(Model.ZaloUrl) && !string.Equals(Model.ZaloUrl, "#", StringComparison.Ordinal);
    var hasTiktok = !string.IsNullOrWhiteSpace(Model.TiktokUrl) && !string.Equals(Model.TiktokUrl, "#", StringComparison.Ordinal);
}

<main class="contact-page contact-page--dark relative isolate overflow-hidden text-white">
    <div class="contact-page__shell">
        <section class="contact-page__section contact-page__section--hero">
            <div class="container-page contact-page__container">
                <div class="contact-page__hero" data-uw-reveal="fade-up" data-uw-once="true">
                    <p class="contact-page__eyebrow">LIÊN HỆ</p>
                    <h1 class="contact-page__title">Kết nối với Truyền Thuyết Champong</h1>
                    <p class="contact-page__lead">
                        Gửi thông tin để đội ngũ của chúng tôi hỗ trợ bạn nhanh chóng.
                    </p>
                    <div class="contact-page__actions">
                        <a href="@hotlineHref" class="contact-page__button contact-page__button--primary">Gọi hotline</a>
                        <a href="/chi-nhanh" class="contact-page__button contact-page__button--secondary">Xem chi nhánh</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="contact-page__section">
            <div class="container-page contact-page__container">
                <div class="contact-page__columns">
                    <aside class="contact-page__info" data-uw-reveal="fade-up" data-uw-delay="80" data-uw-once="true">
                        <p class="contact-page__eyebrow">THÔNG TIN LIÊN HỆ</p>
                        <h2 class="contact-page__section-title">@Model.BrandName</h2>

                        <div class="contact-page__meta-list" aria-label="Thông tin liên hệ chính">
                            <div class="contact-page__meta-item">
                                <p class="contact-page__meta-label">Hotline</p>
                                <a href="@hotlineHref" class="contact-page__meta-value">@Model.Hotline</a>
                            </div>
                            <div class="contact-page__meta-item">
                                <p class="contact-page__meta-label">Email</p>
                                <a href="mailto:@Model.EmailDisplay" class="contact-page__meta-value">@Model.EmailDisplay</a>
                            </div>
                            <div class="contact-page__meta-item">
                                <p class="contact-page__meta-label">Địa chỉ</p>
                                <p class="contact-page__meta-value">@Model.Address</p>
                            </div>
                            <div class="contact-page__meta-item">
                                <p class="contact-page__meta-label">Giờ mở cửa</p>
                                <p class="contact-page__meta-value">@Model.OpeningHours</p>
                            </div>
                        </div>

                        <div class="contact-page__divider"></div>

                        <div class="contact-page__social">
                            <p class="contact-page__mini-label">Mạng xã hội</p>
                            <div class="contact-page__links" aria-label="Liên kết mạng xã hội">
                                @if (hasFacebook)
                                {
                                    <a href="@Model.FacebookUrl" target="_blank" rel="noopener" class="contact-page__link">Facebook</a>
                                }
                                @if (hasZalo)
                                {
                                    <a href="@Model.ZaloUrl" target="_blank" rel="noopener" class="contact-page__link">Zalo</a>
                                }
                                @if (hasTiktok)
                                {
                                    <a href="@Model.TiktokUrl" target="_blank" rel="noopener" class="contact-page__link">TikTok</a>
                                }
                            </div>
                        </div>

                        <div class="contact-page__divider"></div>

                        <div class="contact-page__branches">
                            <p class="contact-page__mini-label">Chi nhánh hiển thị</p>
                            @if (Model.Branches.Count > 0)
                            {
                                <div class="contact-page__branch-list">
                                    @foreach (var branch in Model.Branches.Take(3))
                                    {
                                        <article class="contact-page__branch-item">
                                            <h3 class="contact-page__branch-title">@branch.Name</h3>
                                            <p class="contact-page__branch-copy">@branch.Address</p>
                                            <div class="contact-page__branch-foot">
                                                <span>@branch.OpeningHours</span>
                                                <a href="tel:@branch.Hotline.Replace(" ", string.Empty)" class="contact-page__branch-phone">@branch.Hotline</a>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="contact-page__branch-empty">Thông tin chi nhánh sẽ hiển thị sau khi kết nối cơ sở dữ liệu.</p>
                            }
                        </div>
                    </aside>

                    <div class="contact-page__form" data-uw-reveal="fade-up" data-uw-delay="120" data-uw-once="true">
                        <div class="contact-page__form-head">
                            <p class="contact-page__eyebrow">GỬI TIN NHẮN</p>
                            <h2 class="contact-page__section-title">Gửi thông tin liên hệ</h2>
                            <p class="contact-page__section-copy">Chúng tôi sẽ phản hồi trong thời gian sớm nhất.</p>
                        </div>

                        @if (Model.IsSuccess)
                        {
                            <div class="contact-page__notice contact-page__notice--success">
                                <p class="contact-page__notice-title">Cảm ơn bạn đã liên hệ.</p>
                                <p class="contact-page__notice-copy">Truyền Thuyết Champong sẽ phản hồi sớm nhất có thể.</p>
                            </div>
                        }

                        <form asp-action="Index" asp-controller="Contact" method="post" class="contact-page__form-body" novalidate>
                            @Html.AntiForgeryToken()

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div asp-validation-summary="ModelOnly" class="contact-page__validation contact-page__validation--summary"></div>
                            }

                            <div class="contact-page__form-grid">
                                <label class="contact-page__field-group">
                                    <span class="contact-page__field-label">Họ tên</span>
                                    <input asp-for="FullName" autocomplete="name" class="contact-page__field" placeholder="Nguyễn Văn A" />
                                    <span asp-validation-for="FullName" class="contact-page__validation"></span>
                                </label>

                                <label class="contact-page__field-group">
                                    <span class="contact-page__field-label">Số điện thoại</span>
                                    <input asp-for="PhoneNumber" autocomplete="tel" class="contact-page__field" placeholder="0909 888 777" />
                                    <span asp-validation-for="PhoneNumber" class="contact-page__validation"></span>
                                </label>
                            </div>

                            <div class="contact-page__form-grid">
                                <label class="contact-page__field-group">
                                    <span class="contact-page__field-label">Email</span>
                                    <input asp-for="Email" autocomplete="email" class="contact-page__field" placeholder="email@example.com" />
                                    <span asp-validation-for="Email" class="contact-page__validation"></span>
                                </label>

                                <label class="contact-page__field-group">
                                    <span class="contact-page__field-label">Chủ đề</span>
                                    <input asp-for="Subject" class="contact-page__field" placeholder="Góp ý, đặt tiệc, hợp tác..." />
                                    <span asp-validation-for="Subject" class="contact-page__validation"></span>
                                </label>
                            </div>

                            <label class="contact-page__field-group contact-page__field-group--textarea">
                                <span class="contact-page__field-label">Nội dung</span>
                                <textarea asp-for="Message" rows="6" class="contact-page__textarea" placeholder="Nhập nội dung bạn muốn gửi cho nhà hàng..."></textarea>
                                <span asp-validation-for="Message" class="contact-page__validation"></span>
                            </label>

                            <button type="submit" class="contact-page__button contact-page__button--primary contact-page__submit">Gửi liên hệ</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
