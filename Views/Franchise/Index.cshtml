@{
    ViewData["Title"] = "Liên hệ nhượng quyền";
    ViewData["MetaDescription"] = "Trao đổi cơ hội nhượng quyền cùng Truyền Thuyết Champong - mô hình ẩm thực Hàn Quốc hiện đại, tinh gọn và phù hợp mở rộng.";
}

<main class="franchise-page franchise-page--dark relative isolate overflow-hidden text-white">
    <div class="franchise-page__shell">
        <section class="franchise-page__section franchise-page__section--hero">
            <div class="container-page">
                <div class="franchise-page__hero" data-uw-reveal="fade-up" data-uw-once="true">
                    <p class="franchise-page__eyebrow">NHƯỢNG QUYỀN</p>
                    <h1 class="franchise-page__title">Đồng hành cùng Truyền Thuyết Champong</h1>
                    <p class="franchise-page__lead">
                        Một mô hình ẩm thực Hàn Quốc hiện đại, tối ưu vận hành và phù hợp mở rộng tại các khu vực tiềm năng.
                    </p>
                    <div class="franchise-page__actions">
                        <a href="/lien-he" class="franchise-page__button franchise-page__button--primary">Liên hệ tư vấn</a>
                        <a href="/chi-nhanh" class="franchise-page__button franchise-page__button--secondary">Xem hệ thống chi nhánh</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="franchise-page__section">
            <div class="container-page">
                <div class="franchise-page__section-head" data-uw-reveal="fade-up" data-uw-delay="80" data-uw-once="true">
                    <p class="franchise-page__eyebrow">LỢI THẾ HỢP TÁC</p>
                    <h2 class="franchise-page__section-title">Vì sao chọn Truyền Thuyết Champong?</h2>
                </div>

                <div class="franchise-page__grid franchise-page__grid--benefits">
                    <article class="franchise-page__item" data-uw-reveal="fade-up" data-uw-delay="80" data-uw-once="true">
                        <span class="franchise-page__item-index">01</span>
                        <h3 class="franchise-page__item-title">Thương hiệu có định vị rõ ràng</h3>
                        <p class="franchise-page__item-copy">
                            Tập trung vào trải nghiệm món Hàn hiện đại, dễ nhận diện và phù hợp nhiều nhóm khách hàng.
                        </p>
                    </article>

                    <article class="franchise-page__item" data-uw-reveal="fade-up" data-uw-delay="120" data-uw-once="true">
                        <span class="franchise-page__item-index">02</span>
                        <h3 class="franchise-page__item-title">Mô hình vận hành tinh gọn</h3>
                        <p class="franchise-page__item-copy">
                            Quy trình món, phục vụ và trải nghiệm được chuẩn hóa để thuận tiện khi mở rộng.
                        </p>
                    </article>

                    <article class="franchise-page__item" data-uw-reveal="fade-up" data-uw-delay="160" data-uw-once="true">
                        <span class="franchise-page__item-index">03</span>
                        <h3 class="franchise-page__item-title">Đồng hành trong hệ sinh thái KIG</h3>
                        <p class="franchise-page__item-copy">
                            Kết nối định hướng thương hiệu, vận hành và truyền thông trong cùng một hệ thống.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="franchise-page__section">
            <div class="container-page">
                <div class="franchise-page__columns">
                    <div class="franchise-page__column" data-uw-reveal="fade-up" data-uw-delay="80" data-uw-once="true">
                        <p class="franchise-page__eyebrow">ĐỐI TÁC PHÙ HỢP</p>
                        <h2 class="franchise-page__section-title">Phù hợp với đối tác nào?</h2>
                        <p class="franchise-page__section-copy">
                            Chúng tôi tìm kiếm đối tác có định hướng đầu tư nghiêm túc trong ngành F&amp;B, ưu tiên khu vực có mật độ khách hàng tốt, mặt bằng phù hợp và mong muốn đồng hành dài hạn cùng thương hiệu.
                        </p>

                        <div class="franchise-page__bullets" aria-label="Tiêu chí phù hợp">
                            <div class="franchise-page__bullet">
                                <span class="franchise-page__bullet-mark" aria-hidden="true"></span>
                                <span>Nguồn lực tài chính ổn định</span>
                            </div>
                            <div class="franchise-page__bullet">
                                <span class="franchise-page__bullet-mark" aria-hidden="true"></span>
                                <span>Mặt bằng có tiềm năng khai thác</span>
                            </div>
                            <div class="franchise-page__bullet">
                                <span class="franchise-page__bullet-mark" aria-hidden="true"></span>
                                <span>Tư duy vận hành dài hạn</span>
                            </div>
                        </div>
                    </div>

                    <div class="franchise-page__column franchise-page__column--process" data-uw-reveal="fade-up" data-uw-delay="120" data-uw-once="true">
                        <p class="franchise-page__eyebrow">QUY TRÌNH TRAO ĐỔI</p>
                        <h2 class="franchise-page__section-title">Nhịp trao đổi gọn, rõ, đúng trọng tâm</h2>

                        <div class="franchise-page__steps">
                            <article class="franchise-page__step">
                                <span class="franchise-page__step-index">01</span>
                                <div>
                                    <h3 class="franchise-page__step-title">Tiếp nhận thông tin</h3>
                                    <p class="franchise-page__step-copy">Ghi nhận nhu cầu, khu vực và định hướng đầu tư ban đầu.</p>
                                </div>
                            </article>

                            <article class="franchise-page__step">
                                <span class="franchise-page__step-index">02</span>
                                <div>
                                    <h3 class="franchise-page__step-title">Trao đổi mô hình hợp tác</h3>
                                    <p class="franchise-page__step-copy">Làm rõ phạm vi đồng hành, vận hành và kỳ vọng triển khai.</p>
                                </div>
                            </article>

                            <article class="franchise-page__step">
                                <span class="franchise-page__step-index">03</span>
                                <div>
                                    <h3 class="franchise-page__step-title">Khảo sát khu vực phù hợp</h3>
                                    <p class="franchise-page__step-copy">Đánh giá mặt bằng, lưu lượng khách và điều kiện vận hành.</p>
                                </div>
                            </article>

                            <article class="franchise-page__step">
                                <span class="franchise-page__step-index">04</span>
                                <div>
                                    <h3 class="franchise-page__step-title">Thống nhất kế hoạch triển khai</h3>
                                    <p class="franchise-page__step-copy">Chốt hướng đi và bước chuẩn bị tiếp theo trước khi mở rộng.</p>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="franchise-page__section franchise-page__section--cta">
            <div class="container-page">
                <div class="franchise-page__cta" data-uw-reveal="fade-up" data-uw-delay="160" data-uw-once="true">
                    <div class="franchise-page__cta-copy">
                        <p class="franchise-page__eyebrow">KẾT NỐI</p>
                        <h2 class="franchise-page__cta-title">Sẵn sàng trao đổi về cơ hội hợp tác?</h2>
                        <p class="franchise-page__cta-lead">
                            Để lại thông tin để đội ngũ Truyền Thuyết Champong kết nối và tư vấn bước tiếp theo.
                        </p>
                    </div>

                    <div class="franchise-page__cta-actions">
                        <a href="/lien-he" class="franchise-page__button franchise-page__button--primary">Gửi thông tin liên hệ</a>
                        <a href="tel:0909888777" class="franchise-page__button franchise-page__button--secondary">Gọi hotline</a>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>
