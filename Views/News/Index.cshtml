@model NewsIndexViewModel

@{
    ViewData["Title"] = Model.SeoTitle;
    ViewData["MetaDescription"] = Model.SeoDescription;

    var allCategoriesActive = string.IsNullOrWhiteSpace(Model.SelectedCategorySlug);
    var posts = Model.Posts.ToList();
    var leadPost = posts.FirstOrDefault();
    var latestPosts = posts.Skip(1).Take(4).ToList();
    var gridPosts = posts.Skip(5).ToList();

    string BuildNewsUrl(string? categorySlug, int? page = null)
    {
        var query = new System.Collections.Generic.List<string>();

        if (!string.IsNullOrWhiteSpace(categorySlug))
        {
            query.Add($"category={Uri.EscapeDataString(categorySlug)}");
        }

        if (page.HasValue && page.Value > 1)
        {
            query.Add($"page={page.Value}");
        }

        return query.Count == 0
            ? "/tin-tuc"
            : $"/tin-tuc?{string.Join("&", query)}";
    }

    var brands = new[]
    {
        (Name: "Truyền Thuyết Champong", Cuisine: "Mì cay · mì tương đen", Logo: "/images/general/kig-no-bg-logo.png", Url: "/thuc-don/nhom/truyen-thuyet-champong"),
        (Name: "Gogi Maru", Cuisine: "Thịt nướng Hàn Quốc", Logo: "/images/general/logo-gogi-maru.webp", Url: "/thuc-don/nhom/gogi-maru"),
        (Name: "KBB Cook", Cuisine: "Buffet nướng không giới hạn", Logo: "/images/general/logo-kbbcook.webp", Url: "/thuc-don/nhom/kbb-cook"),
        (Name: "Seoul Gukbap", Cuisine: "Cơm canh Hàn Quốc", Logo: "/images/general/logo-seoul-gukbap.webp", Url: "/thuc-don/nhom/seoul-gukbap")
    };

    // Unique, visible copy per category (helps each category URL rank for its own topic).
    var categoryAbout = (Model.SelectedCategorySlug ?? string.Empty) switch
    {
        "khuyen-mai-uu-dai" => (Heading: "Khuyến mãi nhà hàng Hàn Quốc đang áp dụng",
            Text: "Tổng hợp ưu đãi mới nhất tại Truyền Thuyết Champong, Gogi Maru, KBB Cook và Seoul Gukbap: combo nhóm, giờ vàng, voucher ứng dụng, ưu đãi ngân hàng và quà tặng theo hóa đơn. Mỗi bài ghi rõ thời gian áp dụng và chi nhánh tham gia."),
        "menu-mon-moi" => (Heading: "Món mới và thực đơn Hàn Quốc",
            Text: "Cập nhật món mới ra mắt: mì cay hải sản champong, mì tương đen jajangmyeon, gà chiên sốt cay, thịt nướng Hàn Quốc ủ lên men và các món theo mùa trong hệ thống KIG Holding."),
        "su-kien-hoat-dong" => (Heading: "Sự kiện tại các chi nhánh",
            Text: "Hoạt động, sự kiện và những buổi gặp gỡ thực khách tại các nhà hàng Truyền Thuyết Champong, Gogi Maru, KBB Cook và Seoul Gukbap trên khắp TP.HCM và các tỉnh."),
        "he-thong-chi-nhanh" => (Heading: "Chi nhánh mới và lịch khai trương",
            Text: "Thông tin khai trương, địa chỉ chi nhánh mới và thay đổi giờ mở cửa của hệ thống nhà hàng Hàn Quốc KIG Holding tại TP.HCM, Bình Dương, Đồng Nai, Đà Lạt và Nha Trang."),
        "nhuong-quyen-hop-tac" => (Heading: "Nhượng quyền và hợp tác",
            Text: "Tin tức về chương trình nhượng quyền nhà hàng Hàn Quốc, hợp tác mặt bằng và phát triển chi nhánh cùng KIG Holding VN."),
        "tin-tuc-thong-bao" => (Heading: "Thông báo từ KIG Holding",
            Text: "Thông báo chính thức, thay đổi giờ phục vụ, chính sách thành viên và tin tức mới từ hệ thống nhà hàng Hàn Quốc KIG Holding."),
        _ => (Heading: "Tin tức nhà hàng Hàn Quốc của KIG Holding",
            Text: "Đây là nơi KIG Holding cập nhật mọi tin tức từ hệ thống nhà hàng Hàn Quốc tại Việt Nam: chương trình khuyến mãi, combo và voucher, món mới, sự kiện tại chi nhánh và lịch khai trương. Mỗi bài viết đều ghi rõ thời gian áp dụng và chi nhánh tham gia.")
    };

    const string newsSiteUrl = "https://www.kigholding.vn";
    var currentNewsUrl = newsSiteUrl + BuildNewsUrl(Model.SelectedCategorySlug, Model.Page);
    var breadcrumbItems = new List<object>
    {
        new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Trang chủ", ["item"] = newsSiteUrl + "/" },
        new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Tin tức", ["item"] = newsSiteUrl + "/tin-tuc" }
    };
    if (!allCategoriesActive)
    {
        breadcrumbItems.Add(new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = Model.SelectedCategoryName, ["item"] = newsSiteUrl + BuildNewsUrl(Model.SelectedCategorySlug) });
    }

    var newsJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[]
        {
            new Dictionary<string, object?>
            {
                ["@type"] = "CollectionPage",
                ["@id"] = currentNewsUrl + "#page",
                ["url"] = currentNewsUrl,
                ["name"] = Model.SeoTitle,
                ["description"] = Model.SeoDescription,
                ["inLanguage"] = "vi-VN",
                ["isPartOf"] = new Dictionary<string, object?> { ["@id"] = newsSiteUrl + "/#website" },
                ["mainEntity"] = new Dictionary<string, object?>
                {
                    ["@type"] = "ItemList",
                    ["itemListElement"] = posts.Select((post, index) => new Dictionary<string, object?>
                    {
                        ["@type"] = "ListItem",
                        ["position"] = ((Model.Page - 1) * Math.Max(1, Model.PageSize)) + index + 1,
                        ["url"] = newsSiteUrl + post.Url,
                        ["name"] = post.Title
                    }).ToArray()
                }
            },
            new Dictionary<string, object?>
            {
                ["@type"] = "BreadcrumbList",
                ["itemListElement"] = breadcrumbItems.ToArray()
            }
        }
    });
}

@section Head {
    @if (Model.HasPreviousPage)
    {
        <link rel="prev" href="@(newsSiteUrl + BuildNewsUrl(Model.SelectedCategorySlug, Model.Page - 1))" />
    }
    @if (Model.HasNextPage)
    {
        <link rel="next" href="@(newsSiteUrl + BuildNewsUrl(Model.SelectedCategorySlug, Model.Page + 1))" />
    }
}

<script type="application/ld+json">@Html.Raw(newsJsonLd)</script>

<div class="news-hub" data-news-page="index">
    <section class="news-hub__hero">
        <div class="news-hub__container">
            <nav class="news-hub__crumbs" aria-label="Breadcrumb">
                <a href="/">Trang chủ</a>
                <span aria-hidden="true">/</span>
                @if (allCategoriesActive)
                {
                    <span aria-current="page">Tin tức</span>
                }
                else
                {
                    <a href="/tin-tuc">Tin tức</a>
                    <span aria-hidden="true">/</span>
                    <span aria-current="page">@Model.SelectedCategoryName</span>
                }
            </nav>

            <div class="news-hub__hero-grid">
                <div>
                    <p class="news-hub__kicker">KIG Holding Newsroom</p>
                    <h1 class="news-hub__title">
                        @if (allCategoriesActive)
                        {
                            @:Tin tức &amp; ưu đãi <em>nhà hàng Hàn Quốc</em>
                        }
                        else
                        {
                            @Model.SelectedCategoryName
                        }
                    </h1>
                    <p class="news-hub__lead">
                        Khuyến mãi, món mới và sự kiện từ
                        <a href="/thuc-don/nhom/truyen-thuyet-champong">Truyền Thuyết Champong</a>,
                        <a href="/thuc-don/nhom/gogi-maru">Gogi Maru</a>,
                        <a href="/thuc-don/nhom/kbb-cook">KBB Cook</a> và
                        <a href="/thuc-don/nhom/seoul-gukbap">Seoul Gukbap</a>
                        — cập nhật mỗi tuần, cùng tin khai trương chi nhánh mới.
                    </p>
                    <div class="news-hub__stats">
                        <div class="news-hub__stat"><strong>@Model.TotalItems</strong><span>Bài viết</span></div>
                        <div class="news-hub__stat"><strong>@Model.Categories.Count</strong><span>Chuyên mục</span></div>
                        <div class="news-hub__stat"><strong>@brands.Length</strong><span>Thương hiệu</span></div>
                    </div>
                </div>

                <div class="news-hub__brands">
                    @foreach (var brand in brands)
                    {
                        <a class="news-hub__brand" href="@brand.Url">
                            <img src="@brand.Logo" asp-append-version="true" alt="Logo @brand.Name" width="42" height="42" loading="lazy" decoding="async" />
                            <div>
                                <strong>@brand.Name</strong>
                                <span>@brand.Cuisine</span>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <div class="news-hub__tabs-bar">
        <div class="news-hub__container">
            <nav class="news-hub__tabs" aria-label="Chuyên mục tin tức">
                <a class="news-hub__tab" href="/tin-tuc" aria-current="@(allCategoriesActive ? "page" : null)">Tất cả</a>
                @foreach (var category in Model.Categories)
                {
                    <a class="news-hub__tab" href="@BuildNewsUrl(category.Slug)" aria-current="@(category.IsActive ? "page" : null)">@category.Name</a>
                }
            </nav>
        </div>
    </div>

    <div class="news-hub__container">
        @if (leadPost is not null)
        {
            <section class="news-hub__section" aria-labelledby="news-hub-featured">
                <div class="news-hub__section-head">
                    <div>
                        <p class="news-hub__eyebrow">Tiêu điểm</p>
                        <h2 id="news-hub-featured" class="news-hub__h2">Câu chuyện nổi bật</h2>
                    </div>
                </div>

                <div class="news-hub__featured">
                    <article>
                        <a class="news-hub__lead-card" href="@leadPost.Url">
                            <div style="position: relative;">
                                <div class="news-hub__media" data-news-media>
                                    <img src="@MediaUrlHelper.GetNewsFeatureImageUrl(leadPost.ImageUrl)" alt="" aria-hidden="true" class="news-hub__backdrop" decoding="async" />
                                    <img src="@MediaUrlHelper.GetNewsFeatureImageUrl(leadPost.ImageUrl)"
                                         alt="@leadPost.Title"
                                         class="news-hub__img"
                                         fetchpriority="high"
                                         decoding="async"
                                         onerror="var m=this.closest('[data-news-media]');m.classList.add('is-image-missing');m.querySelectorAll('img').forEach(function(i){i.remove();});" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(leadPost.Category))
                                {
                                    <span class="news-hub__chip news-hub__chip--solid">@leadPost.Category</span>
                                }
                            </div>
                            <div class="news-hub__lead-body">
                                @if (leadPost.PublishedAt.HasValue)
                                {
                                    <time class="news-hub__date" datetime="@leadPost.PublishedAt.Value.ToString("yyyy-MM-dd")">@leadPost.PublishedAt.Value.ToString("dd/MM/yyyy")</time>
                                }
                                <h3 class="news-hub__lead-title">@leadPost.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(leadPost.Excerpt))
                                {
                                    <p class="news-hub__excerpt">@leadPost.Excerpt</p>
                                }
                                <span class="news-hub__more">Đọc bài viết <span aria-hidden="true">&rarr;</span></span>
                            </div>
                        </a>
                    </article>

                    @if (latestPosts.Count > 0)
                    {
                        <aside class="news-hub__latest" aria-labelledby="news-hub-latest">
                            <h3 id="news-hub-latest" class="news-hub__latest-title">Mới cập nhật <small>Tin mới</small></h3>
                            <ol>
                                @foreach (var post in latestPosts)
                                {
                                    <li>
                                        <a class="news-hub__row" href="@post.Url">
                                            <div class="news-hub__media" data-news-media>
                                                <img src="@MediaUrlHelper.GetNewsCardImageUrl(post.ImageUrl)" alt="" aria-hidden="true" class="news-hub__backdrop" loading="lazy" decoding="async" />
                                                <img src="@MediaUrlHelper.GetNewsCardImageUrl(post.ImageUrl)"
                                                     alt="@post.Title"
                                                     class="news-hub__img"
                                                     loading="lazy"
                                                     decoding="async"
                                                     onerror="var m=this.closest('[data-news-media]');m.classList.add('is-image-missing');m.querySelectorAll('img').forEach(function(i){i.remove();});" />
                                            </div>
                                            <div>
                                                @if (!string.IsNullOrWhiteSpace(post.Category))
                                                {
                                                    <div class="news-hub__row-meta"><span class="news-hub__chip">@post.Category</span></div>
                                                }
                                                <h4 class="news-hub__row-title">@post.Title</h4>
                                                @if (post.PublishedAt.HasValue)
                                                {
                                                    <time class="news-hub__date" datetime="@post.PublishedAt.Value.ToString("yyyy-MM-dd")">@post.PublishedAt.Value.ToString("dd/MM/yyyy")</time>
                                                }
                                            </div>
                                        </a>
                                    </li>
                                }
                            </ol>
                        </aside>
                    }
                </div>
            </section>

            <aside class="news-hub__cta" aria-label="Đặt bàn">
                <div>
                    <h2 class="news-hub__cta-title">Thèm món Hàn? Giữ bàn trước, tới là có chỗ.</h2>
                    <p class="news-hub__cta-text">Đặt bàn online tại các chi nhánh Truyền Thuyết Champong, Gogi Maru, KBB Cook và Seoul Gukbap — nhà hàng xác nhận nhanh qua điện thoại.</p>
                </div>
                <div class="news-hub__cta-actions">
                    <a class="news-hub__btn news-hub__btn--primary" href="/dat-ban">Đặt bàn ngay</a>
                    <a class="news-hub__btn news-hub__btn--ghost" href="/chi-nhanh">Tìm chi nhánh</a>
                </div>
            </aside>

            @if (gridPosts.Count > 0)
            {
                <section class="news-hub__section" aria-labelledby="news-hub-all">
                    <div class="news-hub__section-head">
                        <div>
                            <p class="news-hub__eyebrow">Bài viết</p>
                            <h2 id="news-hub-all" class="news-hub__h2">@(allCategoriesActive ? "Tất cả tin tức" : "Thêm bài viết " + Model.SelectedCategoryName)</h2>
                        </div>
                        <p class="news-hub__count">Trang @Model.Page / @Math.Max(1, Model.TotalPages) · @Model.TotalItems bài viết</p>
                    </div>

                    <div class="news-hub__grid">
                        @foreach (var post in gridPosts)
                        {
                            <article>
                                <a class="news-hub__card" href="@post.Url">
                                    <div class="news-hub__media" data-news-media>
                                        <img src="@MediaUrlHelper.GetNewsCardImageUrl(post.ImageUrl)" alt="" aria-hidden="true" class="news-hub__backdrop" loading="lazy" decoding="async" />
                                        <img src="@MediaUrlHelper.GetNewsCardImageUrl(post.ImageUrl)"
                                             alt="@post.Title"
                                             class="news-hub__img"
                                             loading="lazy"
                                             decoding="async"
                                             onerror="var m=this.closest('[data-news-media]');m.classList.add('is-image-missing');m.querySelectorAll('img').forEach(function(i){i.remove();});" />
                                    </div>
                                    <div class="news-hub__card-body">
                                        <div class="news-hub__card-meta">
                                            @if (!string.IsNullOrWhiteSpace(post.Category))
                                            {
                                                <span class="news-hub__chip">@post.Category</span>
                                            }
                                            @if (post.PublishedAt.HasValue)
                                            {
                                                <time class="news-hub__date" datetime="@post.PublishedAt.Value.ToString("yyyy-MM-dd")">@post.PublishedAt.Value.ToString("dd/MM/yyyy")</time>
                                            }
                                        </div>
                                        <h3 class="news-hub__card-title">@post.Title</h3>
                                        @if (!string.IsNullOrWhiteSpace(post.Excerpt))
                                        {
                                            <p class="news-hub__excerpt">@post.Excerpt</p>
                                        }
                                        <span class="news-hub__more">Đọc tiếp <span aria-hidden="true">&rarr;</span></span>
                                    </div>
                                </a>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="news-hub__pager" aria-label="Phân trang tin tức">
                    <a class="news-hub__page"
                       href="@(Model.HasPreviousPage ? BuildNewsUrl(Model.SelectedCategorySlug, Model.Page - 1) : null)"
                       aria-disabled="@(Model.HasPreviousPage ? null : "true")">Trước</a>
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a class="news-hub__page"
                           href="@BuildNewsUrl(Model.SelectedCategorySlug, pageNumber)"
                           aria-current="@(pageNumber == Model.Page ? "page" : null)">@pageNumber</a>
                    }
                    <a class="news-hub__page"
                       href="@(Model.HasNextPage ? BuildNewsUrl(Model.SelectedCategorySlug, Model.Page + 1) : null)"
                       aria-disabled="@(Model.HasNextPage ? null : "true")">Sau</a>
                </nav>
            }
        }
        else
        {
            <div class="news-hub__empty">
                <p class="news-hub__eyebrow">Chưa có nội dung</p>
                <h2 class="news-hub__h2">Chưa có bài viết trong chuyên mục này.</h2>
                <p class="news-hub__lead" style="margin-inline: auto;">Xem tất cả tin tức để cập nhật ưu đãi và món mới từ hệ thống nhà hàng Hàn Quốc KIG Holding.</p>
                <div class="news-hub__cta-actions" style="justify-content: center; margin-top: 1.5rem;">
                    <a class="news-hub__btn news-hub__btn--primary" href="/tin-tuc">Xem tất cả tin tức</a>
                </div>
            </div>
        }

        <section class="news-hub__about" aria-labelledby="news-hub-about">
            <h2 id="news-hub-about">@categoryAbout.Heading</h2>
            <div>
                <p>@categoryAbout.Text</p>
                <p>
                    Bạn đang tìm <a href="/thuc-don/nhom/truyen-thuyet-champong">mì cay champong</a>,
                    <a href="/thuc-don/nhom/gogi-maru">thịt nướng Hàn Quốc</a> hay
                    <a href="/thuc-don/nhom/kbb-cook">buffet nướng không giới hạn</a>?
                    Xem thực đơn từng thương hiệu, <a href="/chi-nhanh">tìm chi nhánh gần bạn</a> hoặc
                    <a href="/dat-ban">đặt bàn online</a> để giữ chỗ trước.
                </p>
            </div>
        </section>
    </div>
</div>

@section Styles {
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,700&display=swap" rel="stylesheet"></noscript>
    <link rel="stylesheet" href="~/css/news-hub.css" asp-append-version="true" />
}
