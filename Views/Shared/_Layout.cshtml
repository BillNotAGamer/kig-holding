@using KIGHolding.Models.Entities
@using KIGHolding.Services
@inject IConfiguration Configuration
@inject ISiteSettingService SiteSettingService

@{
    SiteSetting? siteSetting = null;

    if (HasConfiguredDatabase(Configuration))
    {
        try
        {
            siteSetting = await SiteSettingService.GetSettingsAsync();
        }
        catch
        {
            siteSetting = null;
        }
    }

    var brandName = string.IsNullOrWhiteSpace(siteSetting?.BrandName) ? "Truyền Thuyết Champong" : siteSetting!.BrandName;
    var pageTitle = ViewData["Title"]?.ToString();
    // Search results show roughly 60-65 characters of a title: only append the brand when it still fits.
    const int maxTitleLength = 65;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? brandName
        : pageTitle.Contains(brandName, StringComparison.OrdinalIgnoreCase)
          || pageTitle.Trim().Length + brandName.Length + 3 > maxTitleLength
            ? pageTitle.Trim()
            : $"{pageTitle.Trim()} - {brandName}";

    var rawMetaDescription = ViewData["MetaDescription"]?.ToString();
    var metaDescription = !string.IsNullOrWhiteSpace(rawMetaDescription)
        ? rawMetaDescription
        : !string.IsNullOrWhiteSpace(siteSetting?.Slogan)
            ? siteSetting!.Slogan
            : "Truyền Thuyết Champong - nhà hàng Hàn Quốc: mì cay champong, mì tương đen, thịt nướng Gogi Maru, buffet nướng KBB Cook.";
    metaDescription = TrimForSnippet(metaDescription, 160);

    var baseUrl = GetConfiguredBaseUrl(Configuration, Context.Request);
    var currentPath = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var canonicalUrl = BuildAbsoluteUrl(ViewData["CanonicalUrl"]?.ToString() ?? currentPath, baseUrl);
    var ogTitle = ViewData["OgTitle"]?.ToString() ?? fullTitle;
    var ogDescription = ViewData["OgDescription"]?.ToString() ?? metaDescription;
    var ogImage = BuildAbsoluteUrl(
        ViewData["OgImage"]?.ToString()
            ?? (string.IsNullOrWhiteSpace(siteSetting?.LogoUrl) ? null : siteSetting!.LogoUrl)
            ?? "/images/og/kig-holding-og.jpg",
        baseUrl);
    var ogType = ViewData["OgType"]?.ToString() ?? "website";
    var robots = ViewData["Robots"]?.ToString();
    var articlePublishedTime = ViewData["ArticlePublishedTime"]?.ToString();
    var articleModifiedTime = ViewData["ArticleModifiedTime"]?.ToString();
    var autoOpenBookingModal = ViewData["AutoOpenBookingModal"] as bool? ?? false;
    var requestPath = Context.Request.Path.Value ?? string.Empty;
    var isFranchisePage =
        requestPath.Equals("/lien-he-nhuong-quyen", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWith("/lien-he-nhuong-quyen/", StringComparison.OrdinalIgnoreCase);
    var shouldRenderTikTokPixel = !isFranchisePage;
}

<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@metaDescription" />
    @if (!string.IsNullOrWhiteSpace(robots))
    {
        <meta name="robots" content="@robots" />
    }
    <meta name="theme-color" content="#FFFFFF" />
    <partial name="~/Views/Shared/Partials/_Favicons.cshtml" />
    <link rel="canonical" href="@canonicalUrl" />

    <meta property="og:site_name" content="@brandName" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:description" content="@ogDescription" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:type" content="@ogType" />
    @if (string.Equals(ogType, "article", StringComparison.OrdinalIgnoreCase))
    {
        if (!string.IsNullOrWhiteSpace(articlePublishedTime))
        {
            <meta property="article:published_time" content="@articlePublishedTime" />
        }

        if (!string.IsNullOrWhiteSpace(articleModifiedTime))
        {
            <meta property="article:modified_time" content="@articleModifiedTime" />
        }
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ogTitle" />
    <meta name="twitter:description" content="@ogDescription" />
    <meta name="twitter:image" content="@ogImage" />

    <title>@fullTitle</title>
    @await RenderSectionAsync("Head", required: false)
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/booking-modal-success.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile-tweaks.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <!-- Google tag (gtag.js): one loader, both tag IDs configured on it -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=GT-WBZWZFDQ"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'GT-WBZWZFDQ');
        gtag('config', 'AW-17917718766');
    </script>
    @if (shouldRenderTikTokPixel)
    {
        <partial name="~/Views/Shared/Partials/_TikTokPixel.cshtml" />
    }
</head>

<body class="min-h-screen bg-brand-light text-brand-dark antialiased"
      data-booking-modal-auto-open="@(autoOpenBookingModal ? "true" : null)"
      data-booking-modal-auto-open-delay="@(autoOpenBookingModal ? "1000" : null)"
      data-booking-modal-auto-close-delay="@(autoOpenBookingModal ? "5000" : null)">
    @await Component.InvokeAsync("SiteHeader")

    <main id="main-content" class="min-h-screen pt-20 lg:pt-[5.5rem]">
        @RenderBody()
    </main>

    @await Component.InvokeAsync("SiteFooter")
    @await Component.InvokeAsync("FloatingContactButtons")
    <partial name="Partials/_BookingModal" />

    <button type="button"
            class="fixed bottom-24 left-5 z-40 hidden size-11 place-items-center rounded-md border border-brand-border bg-brand-white text-brand-dark shadow-soft transition hover:border-brand-gold hover:text-brand-goldDeep md:grid"
            aria-label="Lên đầu trang" data-back-to-top>
        ↑
    </button>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/reservation-policy-client.js" asp-append-version="true"></script>
    <script src="~/js/booking-modal.js" asp-append-version="true"></script>
    <script src="~/js/uw-reveal.js" asp-append-version="true"></script>
    @if (shouldRenderTikTokPixel)
    {
        <script src="~/js/tiktok-tracking.js" asp-append-version="true" defer></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

@functions {
    private static bool HasConfiguredDatabase(IConfiguration configuration)
    {
        var connectionString = configuration.GetConnectionString("DefaultConnection");

        return !string.IsNullOrWhiteSpace(connectionString)
            && !connectionString.Contains("your-neon-host", StringComparison.OrdinalIgnoreCase)
            && !connectionString.Contains("your_username", StringComparison.OrdinalIgnoreCase)
            && !connectionString.Contains("your_password", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetConfiguredBaseUrl(IConfiguration configuration, HttpRequest request)
        => SeoUrlHelper.GetBaseUrl(configuration, request);

    private static string BuildAbsoluteUrl(string? url, string baseUrl)
        => SeoUrlHelper.BuildAbsoluteUrl(url, baseUrl);

    /// <summary>Collapses whitespace and cuts long descriptions at a word boundary for search snippets.</summary>
    private static string TrimForSnippet(string value, int maxLength)
    {
        var normalized = System.Text.RegularExpressions.Regex.Replace(value ?? string.Empty, @"\s+", " ").Trim();
        if (normalized.Length <= maxLength)
        {
            return normalized;
        }

        var cut = normalized.LastIndexOf(' ', maxLength - 1);
        if (cut < maxLength / 2)
        {
            cut = maxLength - 1;
        }

        return normalized[..cut].TrimEnd(',', ';', ':', '-', ' ') + "…";
    }
}
