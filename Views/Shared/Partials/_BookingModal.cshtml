@using KIGHolding.Services
@using System.Globalization
@inject IConfiguration Configuration
@inject IBranchService BranchService
@inject TimeProvider TimeProvider

@{
    var branchOptions = new List<(Guid Id, string Name, string OpeningHours, string? LunchBreakHours)>();
    var diningOccasionOptions = ReservationOptionCatalog.DiningOccasionOptions;
    var hasConfiguredDatabase = false;
    var connectionString = Configuration.GetConnectionString("DefaultConnection");

    hasConfiguredDatabase =
        !string.IsNullOrWhiteSpace(connectionString) &&
        !connectionString.Contains("your-neon-host", StringComparison.OrdinalIgnoreCase) &&
        !connectionString.Contains("your_username", StringComparison.OrdinalIgnoreCase) &&
        !connectionString.Contains("your_password", StringComparison.OrdinalIgnoreCase);

    if (hasConfiguredDatabase)
    {
        try
        {
            var branches = await BranchService.GetReservableBranchesAsync();
            branchOptions = branches
                .Select(branch => (
                    branch.Id,
                    branch.Name,
                    $"{branch.OpeningTime.ToString("HH:mm", CultureInfo.InvariantCulture)} - {branch.ClosingTime.ToString("HH:mm", CultureInfo.InvariantCulture)}",
                    branch.LunchBreakStart.HasValue && branch.LunchBreakEnd.HasValue
                        ? $"{branch.LunchBreakStart.Value.ToString("HH:mm", CultureInfo.InvariantCulture)} - {branch.LunchBreakEnd.Value.ToString("HH:mm", CultureInfo.InvariantCulture)}"
                        : null))
                .ToList();
        }
        catch
        {
            branchOptions = [];
        }
    }

    var defaultDate = VietnamClock.GetVietnamToday(TimeProvider).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var defaultTime = "18:00";
    var hasReservableBranches = branchOptions.Count > 0;
}

<partial name="~/Views/Shared/Partials/_ReservationCalendarPolicy.cshtml" />

<div class="booking-modal booking-modal--compact"
     data-booking-modal
     aria-hidden="true">
    <div class="booking-modal__backdrop" data-booking-modal-backdrop></div>

    <div class="booking-modal__panel booking-modal__panel--compact"
         data-booking-modal-panel
         role="dialog"
         aria-modal="true"
         aria-labelledby="booking-modal-title"
         aria-describedby="booking-modal-description"
         tabindex="-1">
        <div class="booking-modal__header">
            <div class="booking-modal__header-main">
                <p class="booking-modal__eyebrow">Quick Reservation</p>
                <h2 id="booking-modal-title" class="booking-modal__title">Giữ bàn nhanh trong vài bước</h2>
                <p id="booking-modal-description" class="booking-modal__description">
                    Mỗi chi nhánh có thể có khung nghỉ trưa riêng vào Thứ Hai đến Thứ Sáu. Thứ Bảy và Chủ Nhật không áp dụng hạn chế nghỉ trưa, nhưng mọi quy định khác về giờ mở cửa vẫn được giữ nguyên.
                </p>
            </div>

            <div class="booking-modal__header-actions">
                <button type="button"
                        class="booking-modal__close"
                        aria-label="Đóng đặt bàn nhanh"
                        data-booking-modal-close>
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        </div>

        <form method="post"
              action="/dat-ban"
              novalidate
              class="booking-modal__form"
              data-booking-modal-form
              data-booking-modal-action="/dat-ban/quick">
            @Html.AntiForgeryToken()

            <div class="booking-modal__summary" data-booking-modal-summary hidden aria-live="polite"></div>

            <div class="booking-modal__form-body" data-booking-modal-form-body>
                <div class="booking-modal__content-shell booking-modal__landscape-grid">
                    <section class="booking-modal__section booking-modal__section--core">
                        <div class="booking-modal__core-grid booking-modal__grid">
                            <label class="booking-modal__field booking-modal__field--span-2 booking-modal__field--half">
                        <span class="booking-modal__label">Họ tên</span>
                        <input id="booking-modal-customer-name"
                               name="CustomerName"
                               type="text"
                               autocomplete="name"
                               class="booking-modal__input"
                               placeholder="Nguyễn Văn A"
                               required />
                        <p class="booking-modal__field-error" data-booking-modal-error-for="CustomerName"></p>
                    </label>

                            <label class="booking-modal__field booking-modal__field--span-2 booking-modal__field--half">
                        <span class="booking-modal__label">Số điện thoại</span>
                        <input id="booking-modal-phone-number"
                               name="PhoneNumber"
                               type="tel"
                               autocomplete="tel"
                               class="booking-modal__input"
                               placeholder="0922 055 755"
                               required />
                        <p class="booking-modal__field-error" data-booking-modal-error-for="PhoneNumber"></p>
                    </label>

                            <label class="booking-modal__field booking-modal__field--third">
                        <span class="booking-modal__label">Số khách</span>
                        <input id="booking-modal-guest-count"
                               name="GuestCount"
                               type="number"
                               min="1"
                               max="100"
                               value="2"
                               class="booking-modal__input"
                               required />
                        <p class="booking-modal__field-error" data-booking-modal-error-for="GuestCount"></p>
                    </label>

                            <label class="booking-modal__field booking-modal__field--third">
                        <span class="booking-modal__label">Ngày đến</span>
                        <input id="booking-modal-reservation-date"
                               name="ReservationDate"
                               type="date"
                               value="@defaultDate"
                               min="@defaultDate"
                               class="booking-modal__input"
                               required />
                        <p class="booking-modal__field-error" data-booking-modal-error-for="ReservationDate"></p>
                    </label>

                            <label class="booking-modal__field booking-modal__field--third">
                        <span class="booking-modal__label">Giờ đến</span>
                        <input id="booking-modal-reservation-time"
                               name="ReservationTime"
                               type="time"
                               value="@defaultTime"
                               class="booking-modal__input"
                               required />
                        <p class="booking-modal__field-error" data-booking-modal-error-for="ReservationTime"></p>
                    </label>

                            <label class="booking-modal__field booking-modal__field--span-3 booking-modal__field--full">
                        <span class="booking-modal__label">Chi nhánh</span>
                        <select id="booking-modal-branch-id"
                                name="BranchId"
                                class="booking-modal__input booking-modal__select"
                                disabled="@(hasReservableBranches ? null : "disabled")"
                                aria-disabled="@(hasReservableBranches ? "false" : "true")"
                                required>
                            <option value="">@(hasReservableBranches ? "Chọn chi nhánh" : "Hiện chưa có chi nhánh nhận đặt bàn")</option>
                            @foreach (var branch in branchOptions)
                            {
                                var lunchBreakSuffix = string.IsNullOrWhiteSpace(branch.LunchBreakHours)
                                    ? string.Empty
                                    : $" • Nghỉ trưa {branch.LunchBreakHours.Replace(" - ", "-", StringComparison.Ordinal)}";
                                <option value="@branch.Id">@branch.Name - @branch.OpeningHours@lunchBreakSuffix</option>
                            }
                        </select>
                        <p class="booking-modal__field-error" data-booking-modal-error-for="BranchId"></p>
                        @if (!hasReservableBranches)
                        {
                            <p class="text-xs leading-6 text-white/65">
                                Hiện chưa có chi nhánh nhận đặt bàn. Vui lòng gọi hotline để được hỗ trợ nhanh.
                            </p>
                        }
                    </label>
                        </div>
                    </section>

                    <section class="booking-modal__section booking-modal__occasion-section">
                        <fieldset class="booking-modal__field booking-modal__field--span-3 booking-modal__field--full booking-modal__option-group">
                        <legend class="booking-modal__label booking-modal__label--static">Hình thức dùng bữa</legend>
                        <p class="booking-modal__option-hint">Chọn một hình thức dùng bữa gần nhất với buổi ăn của bạn.</p>
                        <div class="booking-modal__check-grid">
                            @foreach (var option in diningOccasionOptions)
                            {
                                <label class="booking-modal__check-item">
                                    <input type="radio"
                                           name="DiningOccasionCode"
                                           value="@option.Code"
                                           class="booking-modal__checkbox" />
                                    <span class="booking-modal__check-copy">
                                        <span class="booking-modal__check-title">@option.DisplayLabel</span>
                                    </span>
                                </label>
                            }
                        </div>
                        <p class="booking-modal__field-error" data-booking-modal-error-for="DiningOccasionCode"></p>
                    </fieldset>

                        <div class="booking-modal__field booking-modal__field--span-3 booking-modal__field--full" data-booking-modal-other-field="dining-occasion" hidden>
                        <label for="booking-modal-dining-occasion-other-note" class="booking-modal__label">Ghi chú hình thức khác</label>
                        <input id="booking-modal-dining-occasion-other-note"
                               name="DiningOccasionOtherNote"
                               type="text"
                               class="booking-modal__input"
                               placeholder="Nhập thông tin khi chọn Khác" />
                        <p class="booking-modal__field-error" data-booking-modal-error-for="DiningOccasionOtherNote"></p>
                        </div>
                    </section>

                    <section class="booking-modal__section booking-modal__notes-section">
                        <label class="booking-modal__field booking-modal__field--span-3 booking-modal__field--full">
                        <span class="booking-modal__label">Ghi chú</span>
                        <textarea id="booking-modal-note"
                                  name="Note"
                                  rows="4"
                                  class="booking-modal__textarea"
                                  placeholder="Ví dụ: cần ghế trẻ em, sinh nhật, bàn yên tĩnh..."></textarea>
                        <p class="booking-modal__field-error" data-booking-modal-error-for="Note"></p>
                    </label>

                        <div class="booking-modal__footer booking-modal__actions-row">
                    <p class="booking-modal__footnote">
                        Để lại thông tin và chúng tôi sẽ liên hệ xác nhận trong thời gian sớm nhất.
                    </p>
                    <button type="submit"
                            class="booking-modal__submit"
                            data-booking-modal-submit
                            data-booking-modal-unavailable="@(hasReservableBranches ? null : "true")"
                            disabled="@(hasReservableBranches ? null : "disabled")"
                            aria-disabled="@(hasReservableBranches ? "false" : "true")">Gửi yêu cầu đặt bàn</button>
                        </div>
                    </section>
                </div>
            </div>

            <div class="booking-modal__success" data-booking-modal-success hidden aria-live="polite">
                <div class="booking-modal__success-body" data-booking-modal-success-body></div>
                <button type="button"
                        class="booking-modal__success-close"
                        data-booking-modal-close>
                    Đóng
                </button>
            </div>
        </form>
    </div>
</div>
