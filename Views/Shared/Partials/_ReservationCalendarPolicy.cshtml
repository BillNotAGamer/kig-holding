@using System.Globalization
@using System.Text.Json
@using KIGHolding.Services
@inject IReservationBlockedDateService ReservationBlockedDateService
@inject TimeProvider TimeProvider

@{
    var vietnamToday = VietnamClock.GetVietnamToday(TimeProvider);
    var blockedDates = await ReservationBlockedDateService.GetActiveBlockedDatesAsync(vietnamToday);
    var policyPayload = new
    {
        minDate = FormatReservationCalendarDate(vietnamToday),
        blockedDates = blockedDates
            .Select(FormatReservationCalendarDate)
            .ToArray(),
        messages = new
        {
            pastDate = KIGHolding.Services.ReservationBlockedDateService.GetReservationDatePolicyMessage(ReservationDatePolicyStatus.PastDate),
            blockedDate = KIGHolding.Services.ReservationBlockedDateService.GetReservationDatePolicyMessage(ReservationDatePolicyStatus.BlockedDate),
            invalidDate = "Ngay den khong hop le."
        }
    };
}

<script type="application/json" id="reservation-calendar-policy">@Html.Raw(JsonSerializer.Serialize(policyPayload))</script>
<script>
    (function () {
        if (window.kigValidateReservationDate) {
            return;
        }

        var policyElement = document.getElementById('reservation-calendar-policy');
        var policy = {};

        try {
            policy = JSON.parse(policyElement ? policyElement.textContent || '{}' : '{}');
        }
        catch {
            policy = {};
        }

        var blockedDates = new Set(Array.isArray(policy.blockedDates) ? policy.blockedDates : []);
        var messages = policy.messages || {};

        function parseDateInputValue(value) {
            var match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value || '');
            if (!match) {
                return null;
            }

            var year = Number(match[1]);
            var month = Number(match[2]);
            var day = Number(match[3]);
            var date = new Date(Date.UTC(year, month - 1, day));

            if (
                date.getUTCFullYear() !== year ||
                date.getUTCMonth() !== month - 1 ||
                date.getUTCDate() !== day
            ) {
                return null;
            }

            return {
                value: value,
                year: year
            };
        }

        window.kigReservationCalendarPolicy = policy;
        window.kigValidateReservationDate = function (value) {
            if (!value) {
                return { valid: true };
            }

            var parsed = parseDateInputValue(value);
            if (!parsed) {
                return { valid: false, message: messages.invalidDate || 'Ngay den khong hop le.' };
            }

            if (policy.minDate && value < policy.minDate) {
                return { valid: false, message: messages.pastDate || 'Ngay den khong duoc som hon hom nay.' };
            }

            if (blockedDates.has(value)) {
                return { valid: false, message: messages.blockedDate || 'Nha hang khong nhan dat ban vao ngay nay.' };
            }

            return { valid: true };
        };
    })();
</script>

@functions {
    private static string FormatReservationCalendarDate(DateOnly date)
    {
        return date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
