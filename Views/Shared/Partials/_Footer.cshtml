@model KIGHolding.ViewModels.Shared.FooterViewModel

@{
    var footerLogoUrl = string.IsNullOrWhiteSpace(Model.FooterLogoUrl) ? Model.LogoUrl : Model.FooterLogoUrl;
    var addressText = string.IsNullOrWhiteSpace(Model.Address)
        || string.Equals(Model.Address, "Địa chỉ đang cập nhật", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Address, "Trung tâm TP. Hồ Chí Minh", StringComparison.OrdinalIgnoreCase)
            ? "366/3 Phạm Hữu Lầu, Nhà Bè, Hồ Chí Minh, Việt Nam"
            : Model.Address;
    var currentYear = DateTime.Now.Year;
    var hasMapLink = !string.IsNullOrWhiteSpace(Model.GoogleMapUrl);
    var hasFacebook = !string.IsNullOrWhiteSpace(Model.FacebookUrl) && !string.Equals(Model.FacebookUrl, "#", StringComparison.Ordinal);
    var hasZalo = !string.IsNullOrWhiteSpace(Model.ZaloUrl) && !string.Equals(Model.ZaloUrl, "#", StringComparison.Ordinal);
    var hasTiktok = !string.IsNullOrWhiteSpace(Model.TiktokUrl) && !string.Equals(Model.TiktokUrl, "#", StringComparison.Ordinal);
}

<footer class="relative overflow-hidden border-t border-white/10 bg-brand-black text-brand-cream">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(184,154,98,0.12),transparent_28rem),radial-gradient(circle_at_bottom_right,rgba(255,255,255,0.05),transparent_24rem)] opacity-80" aria-hidden="true"></div>

    <div class="container-page relative z-10 py-16 pb-28 sm:py-20 lg:py-16 lg:pb-16">
        <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.35fr_1fr_1.1fr] lg:gap-16">
            <section aria-labelledby="footer-brand-heading" data-uw-reveal="fade-left">
                <a href="/" class="inline-flex items-center gap-4" aria-label="Về trang chủ">
                    <span class="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] shadow-soft sm:h-20 sm:w-20">
                        @if (!string.IsNullOrWhiteSpace(footerLogoUrl))
                        {
                            <img src="@footerLogoUrl" alt="@Model.BrandName" class="h-full w-full object-contain" />
                        }
                        else
                        {
                            <span class="brand-mark">TT</span>
                        }
                    </span>
                    <span class="min-w-0">
                        <span class="block text-[11px] font-black uppercase tracking-[0.24em] text-brand-goldSoft">Premium restaurant</span>
                        <span id="footer-brand-heading" class="mt-2 block text-xl font-black uppercase tracking-[0.18em] text-brand-cream sm:text-3xl">@Model.BrandName</span>
                    </span>
                </a>

                <div class="mt-6 max-w-md space-y-4 text-sm leading-7 text-white/60">
                    <div>
                        <p class="text-[11px] font-black uppercase tracking-[0.24em] text-white/45">Địa chỉ</p>
                        @if (hasMapLink)
                        {
                            <a href="@Model.GoogleMapUrl" target="_blank" rel="noopener" class="mt-1 block text-brand-cream transition hover:text-brand-goldSoft" data-tiktok-event="FindLocation" data-tiktok-label="Footer Map" data-tiktok-content-type="footer_map">@addressText</a>
                        }
                        else
                        {
                            <p class="mt-1 text-brand-cream">@addressText</p>
                        }
                    </div>

                    <div>
                        <p class="text-[11px] font-black uppercase tracking-[0.24em] text-white/45">Email</p>
                        <a href="mailto:@Model.Email" class="mt-1 block text-brand-cream transition hover:text-brand-goldSoft" data-tiktok-event="Contact" data-tiktok-label="Footer Email" data-tiktok-content-type="footer_contact">@Model.Email</a>
                    </div>
                </div>
            </section>

            <section aria-labelledby="footer-links-heading" data-uw-reveal="fade-up" data-uw-delay="100">
                <h2 id="footer-links-heading" class="text-xs font-black uppercase tracking-[0.24em] text-brand-cream">Truy cập nhanh</h2>
                <nav aria-label="Truy cập nhanh">
                    <ul class="mt-6 grid grid-cols-2 gap-x-8 gap-y-4 sm:gap-x-10">
                        @foreach (var link in Model.QuickLinks)
                        {
                            <li>
                                <a href="@link.Url" class="block text-sm leading-6 text-white/60 transition hover:text-brand-goldSoft">@link.Label</a>
                            </li>
                        }
                    </ul>
                </nav>
            </section>

            <section aria-labelledby="footer-connect-heading" data-uw-reveal="fade-right" data-uw-delay="200">
                <h2 id="footer-connect-heading" class="text-xs font-black uppercase tracking-[0.24em] text-brand-cream">Kết nối</h2>

                <div class="mt-6 space-y-6">
                    <div class="flex items-start gap-5">
                        <div class="shrink-0">
                            <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.35em] text-white/45">
                                QUÉT MÃ QR
                            </p>

                            <div class="flex size-32 items-center justify-center overflow-hidden rounded-xl border border-white/10 bg-white p-2 shadow-soft md:size-32 lg:size-32">
                                <img src="~/images/general/kig-holding-qr-app.webp"
                                     alt="Quét mã QR để tải ứng dụng KIG Holding"
                                     class="h-full w-full object-contain"
                                     loading="lazy"
                                     decoding="async" />
                            </div>
                        </div>

                        <div class="min-w-0 flex-1">
                            <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.35em] text-white/45">
                                TẢI ỨNG DỤNG
                            </p>

                            <div class="space-y-3">
                                <a href="https://apps.apple.com/vn/app/truy%E1%BB%81n-thuy%E1%BA%BFt-champong-%EC%A0%88%EC%84%A4%EC%9D%98%EC%A7%AC%EB%BD%BB/id6753157313?l=vi" target="_blank" rel="noopener noreferrer" aria-label="Tải ứng dụng trên App Store" class="block transition hover:opacity-80">
                                    <img src="~/images/general/icons/app-store-download.svg" alt="Tải ứng dụng trên App Store" class="h-10 w-auto object-contain" asp-append-version="true" />
                                </a>

                                <a href="https://play.google.com/store/apps/details?id=com.eggstech.champong.app&pcampaignid=web_share" target="_blank" rel="noopener noreferrer" aria-label="Tải ứng dụng trên Google Play" class="block transition hover:opacity-80">
                                    <img src="~/images/general/icons/google-play-download.svg" alt="Tải ứng dụng trên Google Play" class="h-10 w-auto object-contain" asp-append-version="true" />
                                </a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <p class="text-[11px] font-black uppercase tracking-[0.24em] text-white/45">Social</p>
                        <div class="mt-4 flex flex-wrap gap-3">
                            @if (hasFacebook)
                            {
                                <a href="@Model.FacebookUrl" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-brand-cream transition hover:-translate-y-0.5 hover:border-brand-red hover\:text-brand-goldSoft" target="_blank" rel="noopener noreferrer" aria-label="Facebook Truyền Thuyết Champong" data-tiktok-event="Contact" data-tiktok-label="Footer Facebook" data-tiktok-content-type="footer_social">
                                    <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M9 8H7v3h2v9h4v-9h3.6l.4-3h-4V6.5C13 5.3 13.5 5 15 5h3V1H15C11.5 1 9 2.5 9 5.8V8Z"/>
                                    </svg>
                                </a>
                            }
                            else
                            {
                                <span class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-brand-cream opacity-50" role="img" aria-label="Facebook placeholder">
                                    <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M9 8H7v3h2v9h4v-9h3.6l.4-3h-4V6.5C13 5.3 13.5 5 15 5h3V1H15C11.5 1 9 2.5 9 5.8V8Z"/>
                                    </svg>
                                </span>
                            }

                            @if (hasZalo)
                            {
                                <a href="@Model.ZaloUrl"
                                       class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-brand-cream transition hover:-translate-y-0.5 hover:border-brand-red hover\:text-brand-goldSoft"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       data-tiktok-event="Contact"
                                       data-tiktok-label="Footer Zalo"
                                       data-tiktok-content-type="footer_social"
                                       aria-label="Zalo Truyền Thuyết Champong">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path fill="currentColor"
                                              d="M7.15 6.25h9.7c.42 0 .75.33.75.75v.58c0 .18-.06.35-.17.49l-7.02 8.68h6.44c.42 0 .75.33.75.75v.5c0 .42-.33.75-.75.75h-9.7a.75.75 0 0 1-.75-.75v-.58c0-.18.06-.35.17-.49l7.02-8.68H7.15A.75.75 0 0 1 6.4 7.5V7c0-.42.33-.75.75-.75Z" />
                                    </svg>
                                </a>
                            }
                            else
                            {
                                <span class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-brand-cream opacity-50"
                                      role="img"
                                      aria-label="Zalo placeholder">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path fill="currentColor"
                                              d="M7.15 6.25h9.7c.42 0 .75.33.75.75v.58c0 .18-.06.35-.17.49l-7.02 8.68h6.44c.42 0 .75.33.75.75v.5c0 .42-.33.75-.75.75h-9.7a.75.75 0 0 1-.75-.75v-.58c0-.18.06-.35.17-.49l7.02-8.68H7.15A.75.75 0 0 1 6.4 7.5V7c0-.42.33-.75.75-.75Z" />
                                    </svg>
                                </span>
                            }

                            @if (hasTiktok)
                            {
                                <a href="@Model.TiktokUrl" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-brand-cream transition hover:-translate-y-0.5 hover:border-brand-red hover\:text-brand-goldSoft" target="_blank" rel="noopener noreferrer" aria-label="TikTok Truyền Thuyết Champong" data-tiktok-event="Contact" data-tiktok-label="Footer TikTok" data-tiktok-content-type="footer_social">
                                    <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M12.53.02C13.84 0 15.14.01 16.44.02c.08 1.53.63 3.09 1.75 4.17 1.12.98 2.59 1.49 4.03 1.58v3.52c-1.34-.17-2.62-.82-3.62-1.77-.28-.29-.53-.6-.74-.93v6.07c0 1.95-.59 3.91-1.85 5.37-1.5 1.75-3.88 2.65-6.16 2.4-2.88-.13-5.63-2.22-6.22-5.04-.76-3.15.93-6.72 3.97-7.69 1.13-.39 2.37-.41 3.52-.16v3.66c-.95-.27-2.02-.17-2.85.34-1.04.59-1.57 1.88-1.37 3.08.19 1.34 1.32 2.47 2.68 2.56.96.09 1.98-.36 2.46-1.19.46-.73.49-1.63.49-2.45V.02h-.24Z"/>
                                    </svg>
                                </a>
                            }
                            else
                            {
                                <span class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-brand-cream opacity-50" role="img" aria-label="TikTok placeholder">
                                    <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M12.53.02C13.84 0 15.14.01 16.44.02c.08 1.53.63 3.09 1.75 4.17 1.12.98 2.59 1.49 4.03 1.58v3.52c-1.34-.17-2.62-.82-3.62-1.77-.28-.29-.53-.6-.74-.93v6.07c0 1.95-.59 3.91-1.85 5.37-1.5 1.75-3.88 2.65-6.16 2.4-2.88-.13-5.63-2.22-6.22-5.04-.76-3.15.93-6.72 3.97-7.69 1.13-.39 2.37-.41 3.52-.16v3.66c-.95-.27-2.02-.17-2.85.34-1.04.59-1.57 1.88-1.37 3.08.19 1.34 1.32 2.47 2.68 2.56.96.09 1.98-.36 2.46-1.19.46-.73.49-1.63.49-2.45V.02h-.24Z"/>
                                    </svg>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="relative mt-14 border-t border-white/10 pt-6 lg:mt-16">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-uw-reveal="fade-up" data-uw-delay="100">
                <div class="space-y-2 text-sm leading-6 text-white/60">
                    <p class="text-brand-cream">@Model.CompanyLegalName</p>
                    <p>@Model.BusinessRegistrationNumber</p>
                    <p>&copy; @currentYear @Model.BrandName. Tất cả quyền được bảo lưu.</p>
                </div>

                <div class="flex flex-col gap-3 sm:flex-row sm:items-center lg:justify-end">
                    <div class="text-xs font-black uppercase tracking-[0.24em] text-brand-cream">Ngôn ngữ</div>
                    <div class="relative inline-flex w-full sm:w-auto">
                        <select aria-label="Ngôn ngữ" class="appearance-none rounded-full border border-white/10 bg-white/[0.04] py-2 pl-4 pr-10 text-sm text-brand-cream shadow-soft transition focus:border-brand-gold focus:outline-none focus:ring-0">
                            <option selected>Tiếng Việt</option>
                        </select>
                        <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-white/50" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 10.94l3.71-3.71a.75.75 0 1 1 1.06 1.06l-4.24 4.24a.75.75 0 0 1-1.06 0L5.21 8.29a.75.75 0 0 1 .02-1.08Z" clip-rule="evenodd" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
