@model KIGHolding.ViewModels.Shared.FloatingContactButtonsViewModel

@{
    var hasMessenger = !string.IsNullOrWhiteSpace(Model.FacebookUrl);
    var hasZalo = !string.IsNullOrWhiteSpace(Model.ZaloUrl);
    var hasReservation = !string.IsNullOrWhiteSpace(Model.ReservationUrl);
    var hasAnyAction = hasMessenger || hasZalo || hasReservation;
}

@if (hasAnyAction)
{
    <div class="floating-contact-fab" data-floating-contact aria-label="Liên hệ nhanh">
        <div class="floating-contact-fab__actions" data-floating-contact-actions>
            @if (hasMessenger)
            {
                <a href="@Model.FacebookUrl"
                   class="floating-contact-fab__action floating-contact-fab__action--messenger"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Chat với chúng tôi qua Messenger"
                   aria-hidden="true"
                   tabindex="-1"
                   data-floating-contact-action>
                    <span class="floating-contact-fab__label">Chat với chúng tôi</span>
                    <span class="floating-contact-fab__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 17.4 3.8 20l.9-4.1A8.2 8.2 0 1 1 20.2 12c0 4.5-3.7 8.2-8.2 8.2-1.8 0-3.6-.6-5-1.8Z"></path>
                            <path d="m9.3 13 2.1-2.4 3.3 2.4 2.4-3"></path>
                        </svg>
                    </span>
                </a>
            }

            @if (hasZalo)
            {
                <a href="@Model.ZaloUrl"
                   class="floating-contact-fab__action floating-contact-fab__action--zalo"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Liên hệ qua Zalo"
                   aria-hidden="true"
                   tabindex="-1"
                   data-floating-contact-action>
                    <span class="floating-contact-fab__label">Zalo</span>
                    <span class="floating-contact-fab__icon" aria-hidden="true">
                        <span class="floating-contact-fab__icon-text">Z</span>
                    </span>
                </a>
            }

            @if (hasReservation)
            {
                <a href="@Model.ReservationUrl"
                   class="floating-contact-fab__action floating-contact-fab__action--reservation"
                   aria-label="Đặt bàn ngay"
                   data-booking-modal-trigger
                   aria-hidden="true"
                   tabindex="-1"
                   data-floating-contact-action>
                    <span class="floating-contact-fab__label">Đặt bàn ngay</span>
                    <span class="floating-contact-fab__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 3v3"></path>
                            <path d="M17 3v3"></path>
                            <rect x="4" y="5" width="16" height="15" rx="3"></rect>
                            <path d="M4 10h16"></path>
                            <path d="M9 14h6"></path>
                        </svg>
                    </span>
                </a>
            }
        </div>

        <button type="button"
                class="floating-contact-fab__toggle"
                aria-label="Mở liên hệ nhanh KIG Holding"
                aria-expanded="false"
                data-floating-contact-toggle>
            <span class="floating-contact-fab__brand" aria-hidden="true">
                <img src="@Model.BrandLogoUrl"
                     alt="KIG Holding"
                     class="object-contain"
                     decoding="async" />
            </span>
            <span class="floating-contact-fab__close" aria-hidden="true">&times;</span>
        </button>
    </div>

    <script>
        (() => {
            const roots = document.querySelectorAll('[data-floating-contact]:not([data-floating-contact-bound="true"])');

            roots.forEach((root) => {
                root.dataset.floatingContactBound = 'true';

                const toggle = root.querySelector('[data-floating-contact-toggle]');
                const actions = Array.from(root.querySelectorAll('[data-floating-contact-action]'));

                if (!toggle || !actions.length) {
                    return;
                }

                const setOpen = (open) => {
                    root.classList.toggle('is-open', open);
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                    toggle.setAttribute('aria-label', open ? 'Đóng liên hệ nhanh KIG Holding' : 'Mở liên hệ nhanh KIG Holding');

                    actions.forEach((action) => {
                        action.tabIndex = open ? 0 : -1;
                        action.setAttribute('aria-hidden', open ? 'false' : 'true');
                    });
                };

                setOpen(false);

                toggle.addEventListener('click', (event) => {
                    event.stopPropagation();
                    setOpen(!root.classList.contains('is-open'));
                });

                actions.forEach((action) => {
                    action.addEventListener('click', () => {
                        setOpen(false);
                    });
                });

                document.addEventListener('click', (event) => {
                    if (!root.contains(event.target)) {
                        setOpen(false);
                    }
                });

                document.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape') {
                        setOpen(false);
                    }
                });
            });
        })();
    </script>
}
