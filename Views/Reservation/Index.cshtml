@using KIGHolding.Services
@model ReservationCreateViewModel

@{
    ViewData["Title"] = "Đặt bàn";
    ViewData["MetaDescription"] = "Đặt bàn trước tại Truyền Thuyết Champong. Chọn chi nhánh, thời gian và số khách để giữ bàn nhanh chóng.";
    var selectedDiningOccasionCode = ReservationOptionCatalog.NormalizeSingleCode(Model.DiningOccasionCode);
    var showDiningOccasionOther = string.Equals(selectedDiningOccasionCode, ReservationOptionCatalog.OtherCode, StringComparison.Ordinal);
}

<main data-reservation-page="index" class="reservation-page--dark">
    <section class="reservation-page__hero section-shell">
        <div class="container-page">
            <div class="reservation-page__hero-grid">
                <div class="reservation-page__hero-card" data-uw-reveal="fade-up" data-uw-once="true">
                    <span class="reservation-page__eyebrow">Reservation</span>
                    <h1 class="reservation-page__hero-title">Đặt bàn trước</h1>
                    <p class="reservation-page__hero-copy">
                        Mỗi chi nhánh có thể thiết lập khung giờ nghỉ trưa riêng. Hạn chế này chỉ áp dụng từ Thứ Hai đến Thứ Sáu, còn Thứ Bảy và Chủ Nhật vẫn tuân theo giờ mở cửa thông thường của chi nhánh.
                    </p>
                </div>

                <div class="reservation-page__support reservation-page__support--hotline" data-uw-reveal="fade-up" data-uw-delay="100" data-uw-once="true">
                    <p class="reservation-page__support-label">Hotline hỗ trợ</p>
                    <a href="tel:@Model.Hotline.Replace(" ", string.Empty)" class="reservation-page__hotline-link">@Model.Hotline</a>
                    <p class="reservation-page__support-copy">
                        Cần đặt gấp hoặc đi nhóm đông? Gọi để được hỗ trợ nhanh.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="reservation-page__shell">
        <div class="container-page reservation-page__grid">
            <div class="reservation-page__form-card" data-uw-reveal="fade-up" data-uw-delay="140" data-uw-once="true">
                <div class="reservation-page__section-intro">
                    <p class="reservation-page__section-label">Thông tin giữ bàn</p>
                    <h2 class="reservation-page__section-title">Hoàn tất đặt bàn</h2>
                    <p class="reservation-page__section-copy">
                        Điền thông tin để nhà hàng giữ chỗ và xác nhận nhanh khi cần.
                    </p>
                </div>

                <form asp-action="Index" asp-controller="Reservation" method="post" class="space-y-5" novalidate>
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="reservation-page__summary"></div>
                    }

                    <div class="grid gap-4 sm:grid-cols-2">
                        <label class="reservation-page__field-group">
                            <span class="reservation-page__field-label">Họ tên</span>
                            <input asp-for="CustomerName" autocomplete="name" class="reservation-page__field" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="CustomerName" class="reservation-page__validation"></span>
                        </label>

                        <label class="reservation-page__field-group">
                            <span class="reservation-page__field-label">Số điện thoại</span>
                            <input asp-for="PhoneNumber" autocomplete="tel" class="reservation-page__field" placeholder="0922 055 755" />
                            <span asp-validation-for="PhoneNumber" class="reservation-page__validation"></span>
                        </label>
                    </div>

                    <label class="reservation-page__field-group">
                        <span class="reservation-page__field-label">Chi nhánh</span>
                        <select asp-for="BranchId" class="reservation-page__field reservation-page__select">
                            <option value="">Chọn chi nhánh</option>
                            @foreach (var branch in Model.Branches)
                            {
                                var lunchBreakSuffix = string.IsNullOrWhiteSpace(branch.LunchBreakHours)
                                    ? string.Empty
                                    : $" • Nghỉ trưa {branch.LunchBreakHours.Replace(" - ", "-", StringComparison.Ordinal)}";
                                <option value="@branch.Id">@branch.Name - @branch.OpeningHours@lunchBreakSuffix</option>
                            }
                        </select>
                        <span asp-validation-for="BranchId" class="reservation-page__validation"></span>
                    </label>

                    <div class="grid gap-4 sm:grid-cols-3">
                        <label class="reservation-page__field-group">
                            <span class="reservation-page__field-label">Số lượng khách</span>
                            <input asp-for="GuestCount" type="number" min="1" max="100" class="reservation-page__field" />
                            <span asp-validation-for="GuestCount" class="reservation-page__validation"></span>
                        </label>

                        <label class="reservation-page__field-group">
                            <span class="reservation-page__field-label">Ngày đến</span>
                            <input asp-for="ReservationDate" type="date" asp-format="{0:yyyy-MM-dd}" class="reservation-page__field" />
                            <span asp-validation-for="ReservationDate" class="reservation-page__validation"></span>
                        </label>

                        <label class="reservation-page__field-group">
                            <span class="reservation-page__field-label">Giờ đến</span>
                            <input asp-for="ReservationTime" type="time" asp-format="{0:HH:mm}" class="reservation-page__field" />
                            <span asp-validation-for="ReservationTime" class="reservation-page__validation"></span>
                        </label>
                    </div>

                    <div class="reservation-page__option-group">
                        <div class="reservation-page__option-head">
                            <span class="reservation-page__field-label">Hình thức dùng bữa</span>
                            <p class="reservation-page__option-hint">Chọn một hình thức dùng bữa gần nhất với buổi ăn của bạn.</p>
                        </div>
                        <div class="reservation-page__check-grid">
                            @foreach (var option in ReservationOptionCatalog.DiningOccasionOptions)
                            {
                                <label class="reservation-page__check-item">
                                    <input type="radio"
                                           name="DiningOccasionCode"
                                           value="@option.Code"
                                           class="reservation-page__checkbox"
                                           checked="@string.Equals(selectedDiningOccasionCode, option.Code, StringComparison.Ordinal)" />
                                    <span class="reservation-page__check-copy">
                                        <span class="reservation-page__check-title">@option.DisplayLabel</span>
                                    </span>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="DiningOccasionCode" class="reservation-page__validation"></span>
                    </div>

                    <label class="reservation-page__field-group reservation-page__conditional-field @(showDiningOccasionOther ? string.Empty : "hidden")"
                           data-reservation-other-field="dining-occasion">
                        <span class="reservation-page__field-label">Ghi chú hình thức khác</span>
                        <input asp-for="DiningOccasionOtherNote"
                               class="reservation-page__field"
                               placeholder="Nhập thông tin khi chọn Khác" />
                        <span asp-validation-for="DiningOccasionOtherNote" class="reservation-page__validation"></span>
                    </label>

                    @if (Model.ShouldShowLargeGroupNotice)
                    {
                        <div class="reservation-page__advisory">
                            Nhóm trên 12 người nên gọi hotline
                            <a href="tel:@Model.Hotline.Replace(" ", string.Empty)" class="font-black text-brand-gold">@Model.Hotline</a>
                            để xác nhận khu vực bàn phù hợp và thời gian phục vụ.
                        </div>
                    }

                    <label class="reservation-page__field-group">
                        <span class="reservation-page__field-label">Ghi chú</span>
                        <textarea asp-for="Note" rows="4" class="reservation-page__textarea" placeholder="Ví dụ: cần ghế trẻ em, sinh nhật, bàn yên tĩnh..."></textarea>
                        <span asp-validation-for="Note" class="reservation-page__validation"></span>
                    </label>

                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                        <p class="reservation-page__form-note">Mọi thông tin được tiếp nhận với trạng thái chờ xác nhận từ nhà hàng.</p>
                        <button type="submit" class="btn-primary reservation-page__submit">Hoàn tất đặt bàn</button>
                    </div>
                </form>
            </div>

            <aside class="reservation-page__aside" data-uw-reveal="fade-up" data-uw-delay="200" data-uw-once="true">
                <div class="reservation-page__support">
                    <p class="reservation-page__support-label">Gợi ý theo nhóm</p>
                    <div class="reservation-page__hint-list">
                        <div class="reservation-page__hint-item">
                            <h3>1-2 người</h3>
                            <p>Bàn nhỏ, phục vụ nhanh cho bữa ăn gọn và thoải mái.</p>
                        </div>
                        <div class="reservation-page__hint-item">
                            <h3>3-6 người</h3>
                            <p>Phù hợp cho combo, món nướng và nhiều phần dùng chung.</p>
                        </div>
                        <div class="reservation-page__hint-item">
                            <h3>7+ người</h3>
                            <p>Nên đặt trước để đội ngũ sắp xếp khu vực bàn phù hợp hơn.</p>
                        </div>
                    </div>
                </div>

                <div class="reservation-page__support">
                    <p class="reservation-page__support-label">Chi nhánh đang phục vụ</p>
                    @if (Model.Branches.Count > 0)
                    {
                        <div class="reservation-page__branch-list">
                            @foreach (var branch in Model.Branches.Take(3))
                            {
                                <div class="reservation-page__branch-item">
                                    <h3>@branch.Name</h3>
                                    <p>@branch.Address</p>
                                    <span>@branch.OpeningHours</span>
                                    @if (!string.IsNullOrWhiteSpace(branch.LunchBreakHours))
                                    {
                                        <span>Nghỉ trưa: @branch.LunchBreakHours</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="reservation-page__support-copy">Danh sách chi nhánh sẽ hiển thị sau khi kết nối cơ sở dữ liệu.</p>
                    }
                </div>
            </aside>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const configs = [
                { fieldName: 'DiningOccasionCode', fieldKey: 'dining-occasion' }
            ];

            const syncOtherField = ({ fieldName, fieldKey }) => {
                const field = document.querySelector(`[data-reservation-other-field="${fieldKey}"]`);
                if (!field) {
                    return;
                }

                const selectedInput = document.querySelector(`input[name="${fieldName}"]:checked`);
                const shouldShow = selectedInput instanceof HTMLInputElement && selectedInput.value === 'other';

                field.classList.toggle('hidden', !shouldShow);

                if (!shouldShow) {
                    const textField = field.querySelector('input, textarea');
                    if (textField instanceof HTMLInputElement || textField instanceof HTMLTextAreaElement) {
                        textField.value = '';
                    }
                }
            };

            document.addEventListener('change', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLInputElement)) {
                    return;
                }

                configs.forEach((config) => {
                    if (target.name === config.fieldName) {
                        syncOtherField(config);
                    }
                });
            });

            configs.forEach(syncOtherField);

            // Weekend & Holiday Frontend validation
            const holidays = new Set([
                "2026-01-01", "2026-02-16", "2026-02-17", "2026-02-18", "2026-02-19", "2026-02-20",
                "2026-04-27", "2026-04-30", "2026-05-01", "2026-09-02", "2026-09-03",
                "2027-01-01", "2027-02-05", "2027-02-08", "2027-02-09", "2027-02-10", "2027-02-11",
                "2027-04-16", "2027-04-30", "2027-05-03", "2027-09-02", "2027-09-03",
                "2028-01-03", "2028-01-25", "2028-01-26", "2028-01-27", "2028-01-28", "2028-01-31",
                "2028-04-04", "2028-05-01", "2028-05-02", "2028-09-04"
            ]);

            $(document).on('change', '#ReservationDate', function () {
                const val = $(this).val();
                if (!val) return;

                const dateObj = new Date(val);
                const dayOfWeek = dateObj.getUTCDay(); // 0 is Sunday, 6 is Saturday

                if (dayOfWeek === 0 || dayOfWeek === 6 || holidays.has(val)) {
                    alert("Hệ thống không nhận đặt bàn vào Thứ Bảy, Chủ Nhật và các ngày Lễ Tết.");
                    $(this).val('');
                }
            });
        })();
    </script>
}
