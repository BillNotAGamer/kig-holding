@model MenuGroupDetailViewModel

@{
    var menuImages = Model.Images ?? Array.Empty<MenuPageImageViewModel>();
    var orderedMenuImages = menuImages
        .OrderBy(img => img.PageNumber)
        .ThenBy(img => img.DisplayOrder)
        .ToArray();

    var brandSeo = (Model.Slug ?? string.Empty).ToLowerInvariant() switch
    {
        "truyen-thuyet-champong" => (
            Title: "Thực đơn Truyền Thuyết Champong - Mì cay hải sản, mì tương đen",
            Description: "Thực đơn Truyền Thuyết Champong: mì cay hải sản champong, mì tương đen chuẩn vị Hàn, lẩu và bánh gạo Hàn Quốc. Xem giá món và đặt bàn online."),
        "gogi-maru" => (
            Title: "Thực đơn Gogi Maru - Thịt nướng Hàn Quốc dry-aged",
            Description: "Thực đơn Gogi Maru: thịt nướng Hàn Quốc ủ dry-aged, thịt heo lên men và bò nướng thượng hạng trên bếp than hồng. Xem giá món và đặt bàn online."),
        "kbb-cook" => (
            Title: "Thực đơn KBB Cook - Buffet nướng Hàn Quốc không giới hạn",
            Description: "Thực đơn KBB Cook buffet nướng Hàn Quốc không giới hạn: gói tiêu chuẩn 278K, gói thượng hạng 458K, quầy line đa dạng. Xem chi tiết và đặt bàn online."),
        "seoul-gukbap" => (
            Title: "Thực đơn Seoul Gukbap - Cơm canh truyền thống Hàn Quốc",
            Description: "Thực đơn Seoul Gukbap: cơm canh thịt truyền thống Hàn Quốc nóng hổi, đậm đà, dễ ăn, phù hợp bữa trưa và bữa tối. Xem món và đặt bàn online."),
        _ => (Title: (string?)null, Description: (string?)null)
    };

    const string breadcrumbSiteUrl = "https://www.kigholding.vn";
    var breadcrumbJson = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Trang chủ", ["item"] = $"{breadcrumbSiteUrl}/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Thực đơn", ["item"] = $"{breadcrumbSiteUrl}/thuc-don" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = Model.Name, ["item"] = $"{breadcrumbSiteUrl}/thuc-don/nhom/{Model.Slug}" }
        }
    });

    ViewData["Title"] = brandSeo.Title ?? $"{Model.Name} - Thực đơn món Hàn Quốc";
    ViewData["MetaDescription"] = brandSeo.Description
        ?? (string.IsNullOrWhiteSpace(Model.ShortDescription)
            ? $"Xem thực đơn {Model.Name} - món Hàn Quốc trong hệ thống nhà hàng KIG Holding. Đặt bàn online nhanh chóng."
            : Model.ShortDescription);
    ViewData["CanonicalUrl"] = string.IsNullOrWhiteSpace(Model.GroupUrl) ? null : Model.GroupUrl;
    if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl ?? Model.FirstImageUrl))
    {
        ViewData["OgImage"] = Model.CoverImageUrl ?? Model.FirstImageUrl;
    }

    var pageCountLabel = Model.TotalPages == 1
        ? "1 trang menu"
        : $"{Model.TotalPages} trang menu";
    var initialTotalPages = Model.TotalPages > 0
        ? Model.TotalPages
        : orderedMenuImages.Length;
    var flipbookPagesJson = Model.HasImages
        ? System.Text.Json.JsonSerializer.Serialize(
            orderedMenuImages.Select((img, index) => new
            {
                imageUrl = img.ImageUrl,
                altText = img.AltText,
                pageNumber = img.PageNumber,
                pageIndex = index
            }))
        : "[]";

    // Readable text for search engines: the menu itself is images, so Google cannot read dish names from it.
    var brandContent = (Model.Slug ?? string.Empty).ToLowerInvariant() switch
    {
        "truyen-thuyet-champong" => new
        {
            Heading = "Truyền Thuyết Champong – nhà hàng mì cay Hàn Quốc",
            Paragraphs = new[]
            {
                "Truyền Thuyết Champong (전설의짬뽕) là thương hiệu mì Hàn Quốc của KIG Holding. Món signature là champong – mì tươi dai ngon trong nước súp hải sản cay nồng, đậm vị. Bên cạnh đó là mì tương đen (jajangmyeon) chuẩn vị Hàn, các món lẩu và bánh gạo truyền thống.",
                "Thực đơn phù hợp cho bữa trưa văn phòng, buổi tối cùng gia đình hay tụ tập nhóm bạn. Hệ thống có nhiều chi nhánh tại TP.HCM và các tỉnh, đặt bàn online để giữ chỗ trước."
            },
            Highlights = new[] { "Mì cay hải sản champong", "Mì tương đen jajangmyeon", "Lẩu Hàn Quốc", "Bánh gạo tteokbokki" },
            Faqs = new[]
            {
                (Q: "Champong là món gì?", A: "Champong là mì cay hải sản kiểu Hàn: sợi mì tươi trong nước súp hải sản cay nồng. Đây là món signature của Truyền Thuyết Champong."),
                (Q: "Truyền Thuyết Champong có mì tương đen không?", A: "Có. Mì tương đen (jajangmyeon) với sốt jajang đậm đà là một trong những món được gọi nhiều nhất tại Truyền Thuyết Champong."),
                (Q: "Làm sao đặt bàn Truyền Thuyết Champong?", A: "Bạn đặt bàn online trên trang Đặt bàn: chọn chi nhánh, ngày giờ và số khách, nhà hàng sẽ xác nhận qua điện thoại.")
            }
        },
        "gogi-maru" => new
        {
            Heading = "Gogi Maru – thịt nướng Hàn Quốc ủ dry-aged",
            Paragraphs = new[]
            {
                "Gogi Maru (고기마루) là nhà hàng thịt nướng Hàn Quốc của KIG Holding, chuyên thịt ủ dry-aged. Thực đơn kết hợp kỹ thuật lên men thịt heo và các phần bò nướng thượng hạng trên bếp than hồng, cho hương vị đậm đà trong từng lát cắt.",
                "Không gian phù hợp cho nhóm bạn, gia đình và tiệc công ty. Xem chi nhánh Gogi Maru và đặt bàn online để giữ chỗ trước."
            },
            Highlights = new[] { "Thịt nướng Hàn Quốc dry-aged", "Thịt heo lên men", "Bò nướng thượng hạng", "Nướng trên bếp than hồng" },
            Faqs = new[]
            {
                (Q: "Thịt dry-aged ở Gogi Maru là gì?", A: "Dry-aged là kỹ thuật ủ khô thịt trong điều kiện kiểm soát, giúp thịt mềm và đậm vị hơn khi nướng."),
                (Q: "Gogi Maru có phù hợp đi nhóm đông không?", A: "Có. Gogi Maru phù hợp cho nhóm bạn, gia đình và tiệc công ty; nên đặt bàn trước với nhóm đông."),
                (Q: "Gogi Maru ở đâu?", A: "Xem địa chỉ, giờ mở cửa và hotline của từng chi nhánh Gogi Maru tại trang Chi nhánh.")
            }
        },
        "kbb-cook" => new
        {
            Heading = "KBB Cook – buffet nướng Hàn Quốc không giới hạn",
            Paragraphs = new[]
            {
                "KBB Cook (한국식 바비큐 뷔페) là buffet nướng Hàn Quốc không giới hạn của KIG Holding. Gói tiêu chuẩn 278K bao gồm tất cả món tại quầy line; gói thượng hạng 458K có thêm các món cao cấp, với dòng thịt premium ủ lên men 360 giờ.",
                "Quầy line đa dạng cùng menu mì truyền thống, phù hợp cho nhóm bạn, sinh viên và tiệc sinh nhật. Đặt bàn online để giữ chỗ trước, nhất là cuối tuần."
            },
            Highlights = new[] { "Buffet nướng 278K", "Buffet premium 458K", "Thịt ủ lên men 360 giờ", "Quầy line đa dạng" },
            Faqs = new[]
            {
                (Q: "Buffet KBB Cook giá bao nhiêu?", A: "KBB Cook có gói tiêu chuẩn 278K và gói thượng hạng 458K. Giá có thể thay đổi theo thời điểm, xem thông báo mới nhất trong mục Tin tức."),
                (Q: "Gói 458K khác gì gói 278K?", A: "Gói thượng hạng 458K gồm toàn bộ món tại quầy line cùng các món cao cấp như thịt premium ủ lên men."),
                (Q: "Có cần đặt bàn KBB Cook trước không?", A: "Nên đặt bàn online trước, đặc biệt vào buổi tối và cuối tuần.")
            }
        },
        "seoul-gukbap" => new
        {
            Heading = "Seoul Gukbap – cơm canh truyền thống Hàn Quốc",
            Paragraphs = new[]
            {
                "Seoul Gukbap (서울 국밥) phục vụ cơm canh thịt truyền thống Hàn Quốc: nước dùng nóng hổi, đậm đà, ăn kèm cơm và kim chi. Món dễ ăn, phù hợp bữa trưa văn phòng lẫn bữa tối.",
                "Seoul Gukbap nằm trong hệ thống nhà hàng Hàn Quốc của KIG Holding. Xem chi nhánh gần bạn và đặt bàn online."
            },
            Highlights = new[] { "Cơm canh thịt Hàn Quốc", "Nước dùng nóng, đậm đà", "Ăn kèm kim chi", "Bữa trưa văn phòng" },
            Faqs = new[]
            {
                (Q: "Gukbap là món gì?", A: "Gukbap là cơm canh Hàn Quốc: cơm ăn cùng nước canh thịt hầm nóng, thường kèm kim chi và rau."),
                (Q: "Seoul Gukbap có chi nhánh ở đâu?", A: "Xem địa chỉ và giờ mở cửa các chi nhánh Seoul Gukbap tại trang Chi nhánh.")
            }
        },
        _ => null
    };

    var brandFaqJson = brandContent is null ? null : System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = brandContent.Faqs.Select(f => new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = f.Q,
            ["acceptedAnswer"] = new Dictionary<string, object?> { ["@type"] = "Answer", ["text"] = f.A }
        }).ToArray()
    });
}

<script type="application/ld+json">@Html.Raw(breadcrumbJson)</script>
@if (brandFaqJson is not null)
{
    <script type="application/ld+json">@Html.Raw(brandFaqJson)</script>
}

<section class="menu-group-viewer menu-group-viewer--dark relative overflow-hidden py-12 text-white sm:py-16 lg:py-20"
         data-menu-group-viewer>
    <div hidden
         aria-hidden="true"
         data-tiktok-track-onload
         data-tiktok-event="ViewContent"
         data-tiktok-content-type="menu_group"
         data-tiktok-content-name="@Model.Name"></div>
    <div class="container-page relative z-10">
        <div class="flex items-center justify-between border-b border-white/10 pb-4" data-uw-reveal="fade-up">
            <a href="@Model.BackUrl"
               class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm font-semibold text-white/70 transition duration-300 hover:border-brand-red/50 hover:text-white">
                ← Quay lại thực đơn
            </a>

            <a href="/dat-ban"
               class="inline-flex items-center justify-center rounded-full bg-brand-red px-5 py-2.5 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-[0_12px_28px_rgba(229,9,20,0.2)] transition duration-300 hover:bg-brand-redDark">
                Đặt bàn ngay
            </a>
        </div>

        <header class="mt-6 flex flex-col justify-between gap-4 border-b border-white/5 pb-6 md:flex-row md:items-end"
                data-uw-reveal="fade-up"
                data-uw-delay="80">
            <div>
                <span class="inline-flex rounded-full border border-brand-red/30 bg-brand-red/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-red-300">
                    Thực đơn
                </span>
                <h1 class="public-page-title mt-3 text-white">
                    Thực đơn @Model.Name
                </h1>
                @if (!string.IsNullOrWhiteSpace(Model.ShortDescription) && !string.Equals(Model.ShortDescription.Trim(), Model.Name.Trim(), StringComparison.OrdinalIgnoreCase))
                {
                    <p class="mt-3 max-w-3xl text-sm leading-6 text-white/70 sm:text-base">
                        @Model.ShortDescription
                    </p>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Description) && !string.Equals(Model.Description.Trim(), Model.Name.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                <div class="max-w-xl text-xs leading-5 text-white/50 md:text-sm md:leading-6">
                    @Model.Description
                </div>
            }
        </header>

        <section id="menu-viewer" class="menu-pageflip-section mt-8" data-uw-reveal="fade-up" data-uw-delay="120">
            <div class="menu-pageflip-shell relative overflow-hidden rounded-[2rem] border border-white/5 bg-gradient-to-b from-black/45 to-black/20 py-3 sm:py-4 shadow-2xl">
                <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(229,9,20,0.03),transparent_70%)]"></div>

                @if (Model.HasImages)
                {
                    <div class="menu-pageflip-toolbar">
                        <div class="menu-pageflip-meta">
                            <span class="menu-pageflip-count">@pageCountLabel</span>
                            <p id="menu_viewer_hint" class="menu-pageflip-hint">
                                Vuốt ngang hoặc dùng nút điều hướng để xem từng trang.
                            </p>
                        </div>

                        <div class="menu-pageflip-actions">
                            <button id="menu_viewer_zoom_toggle"
                                    type="button"
                                    class="menu-pageflip-button menu-pageflip-button--text"
                                    aria-label="Phóng to trang thực đơn hiện tại"
                                    hidden>
                                Phóng to
                            </button>

                            <div class="menu-pageflip-controls" role="group" aria-label="Điều hướng trang thực đơn">
                                <button id="menu_flipbook_prev"
                                        type="button"
                                        class="menu-pageflip-button"
                                        aria-label="Trang thực đơn trước">
                                    ‹
                                </button>
                                <div class="menu-pageflip-indicator" aria-live="polite">
                                    <span id="menu_flipbook_current">1</span>
                                    <span>/</span>
                                    <span id="menu_flipbook_total">@initialTotalPages</span>
                                </div>
                                <button id="menu_flipbook_next"
                                        type="button"
                                        class="menu-pageflip-button"
                                        aria-label="Trang thực đơn sau">
                                    ›
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="menu-pageflip-frame menu-viewer" data-menu-viewer-frame>
                        <div id="menu_mobile_viewer"
                             class="menu-viewer__surface menu-viewer__surface--mobile"
                             hidden
                             aria-label="Trình xem thực đơn trên điện thoại và máy tính bảng">
                        </div>

                        <div id="menu_desktop_viewer"
                             class="menu-viewer__surface menu-viewer__surface--desktop"
                             hidden
                             aria-label="Trình xem thực đơn dạng lật trang trên máy tính">
                        </div>
                    </div>

                    <div id="menu_viewer_zoom_overlay"
                         class="menu-viewer-overlay"
                         hidden
                         aria-hidden="true">
                        <div class="menu-viewer-overlay__backdrop" data-menu-viewer-overlay-close></div>
                        <div class="menu-viewer-overlay__panel" role="dialog" aria-modal="true" aria-labelledby="menu_viewer_overlay_title">
                            <div class="menu-viewer-overlay__toolbar">
                                <p id="menu_viewer_overlay_title" class="menu-viewer-overlay__title">
                                    Phóng to trang thực đơn
                                </p>
                                <button id="menu_viewer_overlay_close"
                                        type="button"
                                        class="menu-viewer-overlay__close"
                                        aria-label="Đóng ảnh thực đơn phóng to">
                                    ×
                                </button>
                            </div>

                            <div class="menu-viewer-overlay__viewport">
                                <img id="menu_viewer_overlay_image"
                                     class="menu-viewer-overlay__image"
                                     alt=""
                                     width="1270"
                                     height="2048"
                                     decoding="async" />
                            </div>
                        </div>
                    </div>

                    <script id="menuFlipbookPages" type="application/json">
                        @Html.Raw(flipbookPagesJson)
                    </script>
                }
                else
                {
                    <div class="rounded-[2rem] border border-white/10 bg-white/[0.045] p-8 text-center shadow-[0_28px_80px_rgba(0,0,0,0.28)] backdrop-blur">
                        <span class="inline-flex rounded-full border border-brand-red/30 bg-brand-red/10 px-4 py-2 text-[11px] font-bold uppercase tracking-[0.22em] text-red-300">
                            Đang cập nhật
                        </span>
                        <h3 class="mt-5 text-2xl font-black text-white sm:text-3xl">
                            Menu đang được cập nhật
                        </h3>
                        <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-white/[0.65] sm:text-base">
                            Nhà hàng đang chuẩn bị hình ảnh thực đơn cho nhóm này. Vui lòng quay lại sau hoặc liên hệ để được tư vấn.
                        </p>
                        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:justify-center">
                            <a href="@Model.BackUrl"
                               class="inline-flex items-center justify-center rounded-full bg-brand-red px-6 py-3 text-sm font-bold uppercase tracking-[0.16em] text-white transition duration-300 hover:bg-brand-redDark">
                                Quay lại thực đơn
                            </a>
                            <a href="/dat-ban"
                               class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/[0.04] px-6 py-3 text-sm font-bold uppercase tracking-[0.16em] text-white/80 transition duration-300 hover:border-brand-red/50 hover:text-white">
                                Đặt bàn
                            </a>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="mt-12 lg:mt-16" data-uw-reveal="fade-up" data-uw-delay="160">
            <div class="rounded-[2rem] border border-white/10 bg-white/[0.05] p-7 shadow-[0_28px_80px_rgba(0,0,0,0.28)] backdrop-blur sm:p-8 lg:p-10">
                <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-[0.24em] text-red-300">Đặt bàn</span>
                        <h2 class="mt-3 text-2xl font-black text-white sm:text-3xl">
                            Bạn đã chọn được món?
                        </h2>
                        <p class="mt-3 max-w-2xl text-sm leading-7 text-white/[0.65] sm:text-base">
                            Đặt bàn trước để được hỗ trợ nhanh hơn và chuẩn bị trải nghiệm phù hợp cho nhóm của bạn.
                        </p>
                    </div>

                    <div class="flex flex-col gap-3 sm:flex-row">
                        <a href="/dat-ban"
                           class="inline-flex items-center justify-center rounded-full bg-brand-red px-6 py-3 text-sm font-bold uppercase tracking-[0.16em] text-white shadow-[0_18px_44px_rgba(229,9,20,0.24)] transition duration-300 hover:bg-brand-redDark">
                            Đặt bàn ngay
                        </a>
                        <a href="/chi-nhanh"
                           class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/[0.04] px-6 py-3 text-sm font-bold uppercase tracking-[0.16em] text-white/80 transition duration-300 hover:border-brand-red/50 hover:text-white">
                            Xem chi nhánh
                        </a>
                    </div>
                </div>
            </div>
        </section>

        @if (brandContent is not null)
        {
            <section class="menu-seo" aria-labelledby="menu-seo-heading">
                <div class="menu-seo__intro">
                    <h2 id="menu-seo-heading" class="menu-seo__title">@brandContent.Heading</h2>
                    @foreach (var paragraph in brandContent.Paragraphs)
                    {
                        <p class="menu-seo__text">@paragraph</p>
                    }
                    <ul class="menu-seo__tags" aria-label="Món nổi bật">
                        @foreach (var highlight in brandContent.Highlights)
                        {
                            <li>@highlight</li>
                        }
                    </ul>
                    <p class="menu-seo__links">
                        <a href="/chi-nhanh">Xem chi nhánh gần bạn</a>
                        <span aria-hidden="true">·</span>
                        <a href="/dat-ban">Đặt bàn online</a>
                        <span aria-hidden="true">·</span>
                        <a href="/tin-tuc?category=khuyen-mai-uu-dai">Khuyến mãi đang áp dụng</a>
                        <span aria-hidden="true">·</span>
                        <a href="/thuc-don">Thực đơn các thương hiệu khác</a>
                    </p>
                </div>

                <div class="menu-seo__faq">
                    <h2 class="menu-seo__title menu-seo__title--small">Câu hỏi thường gặp</h2>
                    @foreach (var faq in brandContent.Faqs)
                    {
                        <details class="menu-seo__item">
                            <summary>@faq.Q</summary>
                            <p>@faq.A</p>
                        </details>
                    }
                </div>
            </section>
        }

        @if (Model.HasImages)
        {
            <noscript>
                <section class="menu-flipbook-noscript py-8 text-center">
                    <h2 class="mb-4 text-xl font-bold text-white">Trang thực đơn</h2>
                    <ul class="menu-pageflip-fallback">
                        @for (var i = 0; i < orderedMenuImages.Length; i++)
                        {
                            var img = orderedMenuImages[i];

                            <li class="menu-pageflip-fallback__item">
                                <img src="@img.ImageUrl"
                                     alt="@img.AltText"
                                     class="menu-pageflip-fallback__image"
                                     width="1270"
                                     height="2048"
                                     decoding="async"
                                     loading="@(i == 0 ? "eager" : "lazy")" />
                                <p class="menu-pageflip-fallback__caption">Trang @img.PageNumber.ToString("00"): @img.AltText</p>
                            </li>
                        }
                    </ul>
                </section>
            </noscript>
        }
    </div>
</section>

@section Scripts {
    @if (Model.HasImages)
    {
        <script src="~/lib/page-flip/page-flip.browser.js" asp-append-version="true"></script>
        <script src="~/js/menu-flipbook.js" asp-append-version="true"></script>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/menu-seo.css" asp-append-version="true" />
}
