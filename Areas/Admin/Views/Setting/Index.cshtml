@model KIGHolding.Areas.Admin.ViewModels.SettingViewModel

@{
    ViewData["Title"] = "Cấu hình Website";
}

<section class="admin-page">
    <div class="admin-card">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="admin-page-kicker">Site Settings</p>
                <h2 class="admin-card-title mt-2">Cấu hình Website</h2>
                <p class="admin-help mt-2">Cập nhật thông tin thương hiệu, liên hệ và vị trí hiển thị công khai.</p>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
            @successMessage
        </div>
    }

    <form asp-action="Update" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

        <div class="admin-form-section">
            <p class="admin-page-kicker">Thông tin thương hiệu</p>
            <div class="admin-form-grid mt-5">
                <div>
                    <label asp-for="BrandName" class="admin-label mb-2"></label>
                    <input asp-for="BrandName" class="admin-field" />
                    <span asp-validation-for="BrandName" class="admin-validation"></span>
                </div>
                <div>
                    <label asp-for="Hotline" class="admin-label mb-2"></label>
                    <input asp-for="Hotline" class="admin-field" />
                    <span asp-validation-for="Hotline" class="admin-validation"></span>
                </div>
            </div>

            <div class="mt-5">
                <label asp-for="Slogan" class="admin-label mb-2"></label>
                <textarea asp-for="Slogan" rows="3" class="admin-textarea"></textarea>
                <span asp-validation-for="Slogan" class="admin-validation"></span>
            </div>
        </div>

        <div class="admin-form-section">
            <p class="admin-page-kicker">Liên hệ</p>
            <div class="admin-form-grid mt-5">
                <div>
                    <label asp-for="Email" class="admin-label mb-2"></label>
                    <input asp-for="Email" class="admin-field" />
                    <span asp-validation-for="Email" class="admin-validation"></span>
                </div>
                <div>
                    <label asp-for="Address" class="admin-label mb-2"></label>
                    <input asp-for="Address" class="admin-field" />
                    <span asp-validation-for="Address" class="admin-validation"></span>
                </div>
            </div>
        </div>

        <div class="admin-form-section">
            <p class="admin-page-kicker">Bản đồ / vị trí</p>
            <div class="mt-5">
                <label asp-for="GoogleMapUrl" class="admin-label mb-2"></label>
                <input asp-for="GoogleMapUrl" class="admin-field" />
                <span asp-validation-for="GoogleMapUrl" class="admin-validation"></span>
            </div>
        </div>

        <div class="admin-form-section">
            <p class="admin-page-kicker">Mạng xã hội</p>
            <div class="mt-5 grid gap-5 lg:grid-cols-3">
                <div>
                    <label asp-for="FacebookUrl" class="admin-label mb-2"></label>
                    <input asp-for="FacebookUrl" class="admin-field" />
                    <span asp-validation-for="FacebookUrl" class="admin-validation"></span>
                </div>
                <div>
                    <label asp-for="ZaloUrl" class="admin-label mb-2"></label>
                    <input asp-for="ZaloUrl" class="admin-field" />
                    <span asp-validation-for="ZaloUrl" class="admin-validation"></span>
                </div>
                <div>
                    <label asp-for="TiktokUrl" class="admin-label mb-2"></label>
                    <input asp-for="TiktokUrl" class="admin-field" />
                    <span asp-validation-for="TiktokUrl" class="admin-validation"></span>
                </div>
            </div>
        </div>

        <div class="admin-actions justify-end">
            <button type="submit" class="btn-primary">Lưu cấu hình</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
