@model KIGHolding.Areas.Admin.ViewModels.PostIndexViewModel

@{
    ViewData["Title"] = "Quản lý bài viết";

    var paginationStart = Math.Max(1, Model.Page - 2);
    var paginationEnd = Math.Min(Model.TotalPages, Model.Page + 2);

    if (Model.TotalPages > 0 && paginationEnd - paginationStart < 4)
    {
        if (paginationStart == 1)
        {
            paginationEnd = Math.Min(Model.TotalPages, paginationStart + 4);
        }
        else if (paginationEnd == Model.TotalPages)
        {
            paginationStart = Math.Max(1, paginationEnd - 4);
        }
    }
}

<section class="admin-page">
    <div class="admin-page-header flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
            <p class="admin-page-kicker">Posts</p>
            <h1 class="admin-page-title">Quản lý bài viết</h1>
            <p class="admin-help">Tìm kiếm, lọc và quản lý các bài viết đang hiển thị trên trang tin tức mà không làm thay đổi lịch đăng hoặc liên kết công khai.</p>
        </div>

        <a asp-action="Create" class="btn-primary">Tạo bài viết mới</a>
    </div>

    <form method="get" asp-action="Index" class="admin-card">
        <div class="grid gap-4 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,0.95fr)_minmax(0,0.85fr)_auto_auto] xl:items-end">
            <div>
                <label for="q" class="admin-label mb-2">Tìm kiếm</label>
                <input id="q"
                       name="q"
                       type="search"
                       value="@Model.SearchQuery"
                       class="admin-field"
                       placeholder="Tiêu đề, slug, excerpt, SEO title..." />
            </div>

            <div>
                <label for="category" class="admin-label mb-2">Danh mục</label>
                <select id="category" name="category" class="admin-select">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Value" selected="@(Model.SelectedCategory == category.Value ? "selected" : null)">
                            @category.Label
                        </option>
                    }
                </select>
            </div>

            <div>
                <label for="status" class="admin-label mb-2">Trạng thái</label>
                <select id="status" name="status" class="admin-select">
                    @foreach (var status in Model.StatusOptions)
                    {
                        var isSelected = (string.IsNullOrWhiteSpace(Model.SelectedStatus) && status.Value == "all")
                            || Model.SelectedStatus == status.Value;

                        <option value="@(status.Value == "all" ? string.Empty : status.Value)" selected="@(isSelected ? "selected" : null)">
                            @status.Label
                        </option>
                    }
                </select>
            </div>

            <button type="submit" class="btn-primary h-12">Lọc</button>
            <a asp-action="Index" class="btn-secondary h-12">Xóa lọc</a>
        </div>
    </form>

    <div class="admin-table-wrap">
        @if (Model.Posts.Count > 0)
        {
            <div class="border-b border-brand-border bg-brand-light/60 px-4 py-4 sm:px-6">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm font-semibold text-brand-dark">Hiển thị @Model.FirstItemIndex-@Model.LastItemIndex trong @Model.TotalItems bài viết.</p>
                    <p class="text-sm text-brand-gray">Trang @Model.Page / @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th>Bài viết</th>
                            <th>Danh mục</th>
                            <th>Trạng thái</th>
                            <th>Ngày đăng</th>
                            <th>Cập nhật</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model.Posts)
                        {
                            var excerptPreview = string.IsNullOrWhiteSpace(post.Excerpt)
                                ? string.Empty
                                : post.Excerpt.Length > 120 ? $"{post.Excerpt[..120]}..." : post.Excerpt;

                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(post.ThumbnailUrl))
                                    {
                                        <img src="@post.ThumbnailUrl" alt="@post.Title" class="h-14 w-24 rounded-2xl border border-brand-border object-cover" />
                                    }
                                    else
                                    {
                                        <div class="grid h-14 w-24 place-items-center rounded-2xl border border-dashed border-brand-border bg-brand-light text-center text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-gray">
                                            No image
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="max-w-md">
                                        <p class="font-semibold text-brand-dark">@post.Title</p>
                                        <p class="mt-1 text-xs text-brand-gray">@post.Slug</p>
                                        @if (!string.IsNullOrWhiteSpace(excerptPreview))
                                        {
                                            <p class="mt-3 text-sm leading-6 text-brand-gray">@excerptPreview</p>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="admin-badge admin-badge--muted">@post.CategoryDisplayName</span>
                                </td>
                                <td>
                                    @if (post.IsPublished)
                                    {
                                        <span class="admin-badge admin-badge--success">Đã đăng</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge--warning">Bản nháp</span>
                                    }
                                </td>
                                <td>@(post.PublishedAt.HasValue ? post.PublishedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Chưa có")</td>
                                <td>@post.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="admin-actions gap-2">
                                        @if (post.IsPublished && !string.IsNullOrWhiteSpace(post.PublicUrl))
                                        {
                                            <a href="@post.PublicUrl"
                                               target="_blank"
                                               rel="noopener"
                                               class="admin-table-action admin-table-action--primary">
                                                Xem công khai
                                            </a>
                                        }

                                        <a asp-action="Edit"
                                           asp-route-id="@post.Id"
                                           class="admin-table-action admin-table-action--muted">
                                            Sửa
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@post.Id"
                                              asp-route-q="@Model.SearchQuery"
                                              asp-route-category="@Model.SelectedCategory"
                                              asp-route-status="@Model.SelectedStatus"
                                              asp-route-page="@Model.Page"
                                              method="post"
                                              class="inline"
                                              onsubmit="return confirm('Ẩn bài viết này khỏi website công khai?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="admin-table-action admin-table-action--danger">Ẩn bài</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-6 sm:p-8">
                <div class="admin-empty">
                    <div>
                        <p class="admin-empty__title">Không có bài viết phù hợp</p>
                        <p class="admin-empty__text">Hãy điều chỉnh bộ lọc, xóa từ khóa tìm kiếm hoặc tạo bài viết mới để bổ sung nội dung cho trang tin tức.</p>
                        <div class="mt-6 flex flex-wrap justify-center gap-3">
                            <a asp-action="Index" class="btn-secondary">Xóa lọc</a>
                            <a asp-action="Create" class="btn-primary">Tạo bài viết mới</a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="border-t border-brand-border px-4 py-4 sm:px-6">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <a asp-action="Index"
                       asp-route-q="@Model.SearchQuery"
                       asp-route-category="@Model.SelectedCategory"
                       asp-route-status="@Model.SelectedStatus"
                       asp-route-page="@(Model.Page - 1)"
                       class="inline-flex items-center justify-center rounded-full border px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] transition @(Model.HasPreviousPage ? "border-brand-border bg-white text-brand-dark hover:border-brand-red hover:text-brand-red" : "pointer-events-none border-brand-border/70 bg-brand-light text-brand-gray/60")">
                        Trang trước
                    </a>

                    <div class="flex flex-wrap items-center justify-center gap-2">
                        @for (var currentPage = paginationStart; currentPage <= paginationEnd; currentPage++)
                        {
                            var isActive = currentPage == Model.Page;

                            <a asp-action="Index"
                               asp-route-q="@Model.SearchQuery"
                               asp-route-category="@Model.SelectedCategory"
                               asp-route-status="@Model.SelectedStatus"
                               asp-route-page="@currentPage"
                               class="inline-flex h-10 min-w-10 items-center justify-center rounded-full border px-3 text-sm font-semibold transition @(isActive ? "border-brand-red bg-brand-red text-white shadow-soft" : "border-brand-border bg-white text-brand-dark hover:border-brand-red hover:text-brand-red")">
                                @currentPage
                            </a>
                        }
                    </div>

                    <a asp-action="Index"
                       asp-route-q="@Model.SearchQuery"
                       asp-route-category="@Model.SelectedCategory"
                       asp-route-status="@Model.SelectedStatus"
                       asp-route-page="@(Model.Page + 1)"
                       class="inline-flex items-center justify-center rounded-full border px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] transition @(Model.HasNextPage ? "border-brand-border bg-white text-brand-dark hover:border-brand-red hover:text-brand-red" : "pointer-events-none border-brand-border/70 bg-brand-light text-brand-gray/60")">
                        Trang sau
                    </a>
                </div>
            </div>
        }
    </div>
</section>
