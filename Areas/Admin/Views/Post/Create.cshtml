@model KIGHolding.Areas.Admin.ViewModels.PostCreateViewModel

@{
    ViewData["Title"] = "Tạo bài viết";
}

<section class="admin-page">
    <div class="admin-page-header">
        <p class="admin-page-kicker">Posts</p>
        <h1 class="admin-page-title">Tạo bài viết mới</h1>
    </div>

    <div class="admin-card">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="admin-post-summary"></div>

            <div class="grid gap-5 lg:grid-cols-2">
                <div>
                    <label asp-for="Title" class="admin-post-label"></label>
                    <input asp-for="Title" class="admin-post-field" />
                    <span asp-validation-for="Title" class="admin-post-validation"></span>
                </div>
                <div>
                    <label asp-for="Slug" class="admin-post-label"></label>
                    <input asp-for="Slug" class="admin-post-field" placeholder="Để trống để tự tạo từ tiêu đề" />
                    <p class="mt-2 text-sm leading-6 text-brand-gray">Có thể nhập thủ công hoặc để trống để hệ thống tự tạo slug duy nhất từ tiêu đề.</p>
                    <span asp-validation-for="Slug" class="admin-post-validation"></span>
                </div>
            </div>

            <div class="grid gap-5 lg:grid-cols-2">
                <div>
                    <label asp-for="Category" class="admin-post-label"></label>
                    <select asp-for="Category" asp-items="Model.CategoryOptions" class="admin-post-field"></select>
                    <span asp-validation-for="Category" class="admin-post-validation"></span>
                </div>
                <div>
                    <label asp-for="PublishedAt" class="admin-post-label"></label>
                    <input asp-for="PublishedAt" type="datetime-local" class="admin-post-field" />
                    <span asp-validation-for="PublishedAt" class="admin-post-validation"></span>
                </div>
            </div>

            <div>
                <label asp-for="Excerpt" class="admin-post-label"></label>
                <textarea asp-for="Excerpt" rows="3" class="admin-post-area min-h-32"></textarea>
                <span asp-validation-for="Excerpt" class="admin-post-validation"></span>
            </div>

            <div>
                <label asp-for="Content" class="admin-post-label"></label>
                <textarea asp-for="Content" rows="10" class="admin-post-area min-h-48 max-h-[60svh] sm:min-h-56" placeholder="Nhập nội dung HTML hoặc markdown đã được chuẩn bị sẵn..."></textarea>
                <span asp-validation-for="Content" class="admin-post-validation"></span>
            </div>

            <div class="grid gap-5 lg:grid-cols-3">
                <div>
                    <label asp-for="SeoTitle" class="admin-post-label"></label>
                    <input asp-for="SeoTitle" class="admin-post-field" />
                </div>
                <div class="lg:col-span-2">
                    <label asp-for="SeoDescription" class="admin-post-label"></label>
                    <input asp-for="SeoDescription" class="admin-post-field" />
                </div>
            </div>

            <div class="admin-upload admin-upload--compact">
                <label asp-for="ThumbnailFile" class="admin-upload__label"></label>
                <div class="admin-upload__dropzone">
                    <p class="admin-upload__dropzone-title">Chọn ảnh thumbnail bài viết</p>
                    <p class="admin-upload__dropzone-text">Ảnh chọn sẽ được xem trước trước khi lưu. Backend vẫn giữ nguyên kiểm tra định dạng và dung lượng khi submit.</p>
                    <input asp-for="ThumbnailFile"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           class="admin-upload__input"
                           data-admin-image-preview
                           data-admin-image-preview-target="#post-thumbnail-preview"
                           data-admin-image-preview-meta="#post-thumbnail-preview-meta" />
                </div>
                <p class="admin-upload__hint">Hỗ trợ: jpg, jpeg, png, webp. Kích thước tối đa 2MB.</p>
                <div class="admin-upload__preview" hidden>
                    <img id="post-thumbnail-preview" alt="Xem trước thumbnail bài viết đã chọn" class="admin-upload__preview-image" hidden />
                    <div class="admin-upload__preview-meta">
                        <p class="text-sm font-semibold text-brand-dark">Thumbnail sẽ được tải lên</p>
                        <p id="post-thumbnail-preview-meta"></p>
                    </div>
                </div>
                <span asp-validation-for="ThumbnailFile" class="admin-post-validation"></span>
            </div>

            <label class="admin-post-checkbox-shell">
                <input asp-for="IsPublished" type="checkbox" class="admin-post-checkbox" />
                <span>Đăng công khai</span>
            </label>

            <div class="flex flex-col gap-3 border-t border-brand-border pt-6 sm:flex-row sm:justify-end">
                <button type="submit" class="btn-primary w-full sm:w-auto">Lưu bài viết</button>
                <a asp-action="Index" class="btn-secondary w-full sm:w-auto">Hủy</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
