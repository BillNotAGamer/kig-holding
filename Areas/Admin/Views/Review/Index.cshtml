@model KIGHolding.Areas.Admin.ViewModels.ReviewIndexViewModel

@{
    ViewData["Title"] = "Đánh giá";
}

<section class="admin-page">
    <div class="admin-page-header flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
            <p class="admin-page-kicker">Reviews</p>
            <h1 class="admin-page-title">Đánh giá khách hàng</h1>
            <p class="admin-help">Theo dõi phản hồi khách hàng, thứ tự hiển thị và trạng thái công khai của từng đánh giá.</p>
        </div>

        <a asp-action="Create" class="btn-primary">Tạo đánh giá mới</a>
    </div>

    <div class="admin-table-wrap">
        @if (Model.Reviews.Any())
        {
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Đánh giá</th>
                            <th>Hiển thị</th>
                            <th>Thứ tự</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in Model.Reviews)
                        {
                            <tr>
                                <td class="font-semibold text-brand-dark">@review.CustomerName</td>
                                <td>
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-black tracking-[0.14em] text-amber-500">@(string.Concat(Enumerable.Repeat("\u2605", review.Rating)))</span>
                                        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-gray">@review.Rating/5</span>
                                    </div>
                                </td>
                                <td>
                                    @if (review.IsVisible)
                                    {
                                        <span class="admin-badge admin-badge--success">Hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge--muted">Ẩn</span>
                                    }
                                </td>
                                <td class="font-semibold text-brand-dark">#@review.DisplayOrder</td>
                                <td>
                                    <div class="admin-actions gap-2">
                                        <a asp-action="Edit" asp-route-id="@review.Id" class="admin-table-action admin-table-action--muted">Sửa</a>

                                        <form asp-action="Delete" asp-route-id="@review.Id" method="post" class="inline" onsubmit="return confirm('Ẩn đánh giá này khỏi website công khai?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="admin-table-action admin-table-action--danger">Ẩn</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-6 sm:p-8">
                <div class="admin-empty">
                    <div>
                        <p class="admin-empty__title">Chưa có đánh giá nào</p>
                        <p class="admin-empty__text">Tạo đánh giá đầu tiên để bổ sung phản hồi khách hàng và làm giàu nội dung hiển thị trên trang chủ.</p>
                        <a asp-action="Create" class="btn-primary mt-6">Tạo đánh giá mới</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
