@model KIGHolding.Areas.Admin.ViewModels.ReviewEditViewModel

@{
    ViewData["Title"] = "Sửa đánh giá";
}

<section class="admin-page">
    <div class="admin-card">
        <p class="admin-page-kicker">Reviews</p>
        <h2 class="admin-card-title mt-2">Chỉnh sửa đánh giá</h2>

        <form asp-action="Edit" method="post" class="mt-6 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

            <div class="admin-form-grid">
                <div>
                    <label asp-for="CustomerName" class="admin-label mb-2"></label>
                    <input asp-for="CustomerName" class="admin-field" />
                    <span asp-validation-for="CustomerName" class="admin-validation"></span>
                </div>
                <div>
                    <label asp-for="Rating" class="admin-label mb-2"></label>
                    <input asp-for="Rating" type="number" min="1" max="5" class="admin-field" />
                    <span asp-validation-for="Rating" class="admin-validation"></span>
                </div>
            </div>

            <div>
                <label asp-for="Content" class="admin-label mb-2"></label>
                <textarea asp-for="Content" rows="5" class="admin-textarea"></textarea>
                <span asp-validation-for="Content" class="admin-validation"></span>
            </div>

            <div class="grid gap-5 lg:grid-cols-3">
                <div>
                    <label asp-for="BranchId" class="admin-label mb-2"></label>
                    <select asp-for="BranchId" asp-items="Model.BranchOptions" class="admin-select"></select>
                </div>
                <div>
                    <label asp-for="DisplayOrder" class="admin-label mb-2"></label>
                    <input asp-for="DisplayOrder" type="number" class="admin-field" />
                    <span asp-validation-for="DisplayOrder" class="admin-validation"></span>
                </div>
                <div class="flex items-end">
                    <label class="admin-post-checkbox-shell w-full">
                        <input asp-for="IsVisible" type="checkbox" class="admin-checkbox" />
                        <span>Hiển thị công khai</span>
                    </label>
                </div>
            </div>

            <div class="flex flex-col gap-3 border-t border-brand-border pt-6 sm:flex-row sm:justify-end">
                <button type="submit" class="btn-primary w-full sm:w-auto">Lưu thay đổi</button>
                <a asp-action="Index" class="btn-secondary w-full sm:w-auto">Hủy</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
