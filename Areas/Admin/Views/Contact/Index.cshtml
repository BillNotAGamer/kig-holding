@model KIGHolding.Areas.Admin.ViewModels.ContactIndexViewModel

@{
    ViewData["Title"] = "Quản lý Liên hệ";

    var paginationStart = Math.Max(1, Model.Page - 2);
    var paginationEnd = Math.Min(Model.TotalPages, Model.Page + 2);

    if (Model.TotalPages > 1 && paginationEnd - paginationStart < 4)
    {
        if (paginationStart == 1)
        {
            paginationEnd = Math.Min(Model.TotalPages, paginationStart + 4);
        }
        else if (paginationEnd == Model.TotalPages)
        {
            paginationStart = Math.Max(1, paginationEnd - 4);
        }
    }

    var mobilePaginationStart = Math.Max(1, Model.Page - 1);
    var mobilePaginationEnd = Math.Min(Model.TotalPages, Model.Page + 1);
}

<section class="admin-page">
    <div class="admin-page-header flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
            <p class="admin-page-kicker">Contact Inbox</p>
            <h1 class="admin-page-title">Hộp thư liên hệ</h1>
            <p class="admin-help">Theo dõi tin nhắn khách hàng, ưu tiên các liên hệ mới và mở nhanh chi tiết để cập nhật trạng thái xử lý.</p>
        </div>
    </div>

    <form method="get"
          asp-area="Admin"
          asp-controller="Contact"
          asp-action="Index"
          class="admin-card">
        <div class="grid gap-4 sm:grid-cols-[minmax(0,16rem)_auto_auto] sm:items-end">
            <div>
                <label asp-for="StatusFilter" class="admin-label mb-2"></label>
                <select asp-for="StatusFilter" asp-items="Model.StatusOptions" class="admin-select"></select>
            </div>

            <button type="submit" class="btn-primary h-12 w-full">Lọc dữ liệu</button>
            <a asp-area="Admin" asp-controller="Contact" asp-action="Index" class="btn-secondary h-12 w-full">Xóa lọc</a>
        </div>
    </form>

    <div class="admin-table-wrap">
        @if (Model.Messages.Any())
        {
            <div class="border-b border-brand-border bg-brand-light/60 px-4 py-4 sm:px-6">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm font-semibold text-brand-dark">Hiển thị @Model.FirstItemIndex-@Model.LastItemIndex trong @Model.TotalItems tin nhắn.</p>
                    <p class="text-sm text-brand-gray">Trang @Model.Page / @Model.TotalPages</p>
                </div>
            </div>

            <div class="hidden overflow-x-auto md:block">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Điện thoại</th>
                            <th>Nội dung</th>
                            <th>Trạng thái</th>
                            <th>Thời gian</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var message in Model.Messages)
                        {
                            var statusClass = message.Status switch
                            {
                                ContactMessageStatus.New => "admin-badge--warning",
                                ContactMessageStatus.Handled => "admin-badge--success",
                                ContactMessageStatus.Read => "admin-badge--muted",
                                ContactMessageStatus.Archived => "admin-badge--muted",
                                _ => "admin-badge--muted"
                            };
                            var statusDotClass = message.Status switch
                            {
                                ContactMessageStatus.New => "admin-status-dot--warning",
                                ContactMessageStatus.Handled => "admin-status-dot--success",
                                ContactMessageStatus.Read => "admin-status-dot--muted",
                                ContactMessageStatus.Archived => "admin-status-dot--muted",
                                _ => "admin-status-dot--muted"
                            };
                            var statusLabel = message.Status switch
                            {
                                ContactMessageStatus.New => "Mới",
                                ContactMessageStatus.Read => "Đã đọc",
                                ContactMessageStatus.Handled => "Đã xử lý",
                                ContactMessageStatus.Archived => "Đã lưu trữ",
                                _ => message.Status.ToString()
                            };
                            var rowClass = message.Status == ContactMessageStatus.New
                                ? "admin-row-highlight admin-row-highlight--warning"
                                : string.Empty;

                            <tr class="@rowClass">
                                <td>
                                    <p class="font-semibold text-brand-dark">@message.FullName</p>
                                    @if (message.Status == ContactMessageStatus.New)
                                    {
                                        <p class="mt-1 text-xs font-semibold uppercase tracking-[0.14em] text-amber-700">Tin nhắn mới</p>
                                    }
                                </td>
                                <td class="font-semibold text-brand-dark">@message.PhoneNumber</td>
                                <td>
                                    <div class="max-w-sm">
                                        <p class="font-medium text-brand-dark">@(string.IsNullOrWhiteSpace(message.Subject) ? "Không có tiêu đề" : message.Subject)</p>
                                    </div>
                                </td>
                                <td>
                                    <span class="admin-badge @statusClass">
                                        <span class="admin-status-dot @statusDotClass"></span>
                                        @statusLabel
                                    </span>
                                </td>
                                <td>@message.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@message.Id" class="admin-table-action admin-table-action--primary">Xem chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="grid gap-3 p-3 md:hidden">
                @foreach (var message in Model.Messages)
                {
                    var statusClass = message.Status switch
                    {
                        ContactMessageStatus.New => "admin-badge--warning",
                        ContactMessageStatus.Handled => "admin-badge--success",
                        ContactMessageStatus.Read => "admin-badge--muted",
                        ContactMessageStatus.Archived => "admin-badge--muted",
                        _ => "admin-badge--muted"
                    };
                    var statusDotClass = message.Status switch
                    {
                        ContactMessageStatus.New => "admin-status-dot--warning",
                        ContactMessageStatus.Handled => "admin-status-dot--success",
                        ContactMessageStatus.Read => "admin-status-dot--muted",
                        ContactMessageStatus.Archived => "admin-status-dot--muted",
                        _ => "admin-status-dot--muted"
                    };
                    var statusLabel = message.Status switch
                    {
                        ContactMessageStatus.New => "Mới",
                        ContactMessageStatus.Read => "Đã đọc",
                        ContactMessageStatus.Handled => "Đã xử lý",
                        ContactMessageStatus.Archived => "Đã lưu trữ",
                        _ => message.Status.ToString()
                    };
                    var cardClass = message.Status == ContactMessageStatus.New
                        ? "border-amber-200 bg-amber-50/60"
                        : "border-brand-border bg-brand-white";

                    <article class="rounded-2xl border @cardClass p-4 shadow-soft">
                        <div class="flex flex-col gap-3">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="break-words text-base font-black text-brand-dark">@message.FullName</p>
                                    <p class="mt-1 text-sm font-semibold text-brand-gray">@message.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                                <span class="admin-badge @statusClass">
                                    <span class="admin-status-dot @statusDotClass"></span>
                                    @statusLabel
                                </span>
                            </div>

                            <div class="rounded-xl bg-brand-light p-3">
                                <p class="text-[11px] font-black uppercase tracking-[0.14em] text-brand-gray">Nội dung</p>
                                <p class="mt-1 break-words font-semibold text-brand-dark">@(string.IsNullOrWhiteSpace(message.Subject) ? "Không có tiêu đề" : message.Subject)</p>
                            </div>

                            <div class="rounded-xl bg-brand-light p-3">
                                <p class="text-[11px] font-black uppercase tracking-[0.14em] text-brand-gray">Điện thoại</p>
                                <p class="mt-1 break-words font-semibold text-brand-dark">@message.PhoneNumber</p>
                            </div>

                            <a asp-action="Details" asp-route-id="@message.Id" class="admin-table-action admin-table-action--primary min-h-11 w-full">Xem chi tiết</a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="p-6 sm:p-8">
                <div class="admin-empty">
                    <div>
                        <p class="admin-empty__title">Chưa có tin nhắn phù hợp</p>
                        <p class="admin-empty__text">Không có liên hệ nào khớp với bộ lọc hiện tại. Hãy xóa bộ lọc để xem toàn bộ hộp thư.</p>
                        <a asp-area="Admin" asp-controller="Contact" asp-action="Index" class="btn-secondary mt-6">Xóa lọc</a>
                    </div>
                </div>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="border-t border-brand-border px-4 py-4 sm:px-6">
                <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-area="Admin"
                           asp-controller="Contact"
                           asp-action="Index"
                           asp-route-StatusFilter="@Model.StatusFilter"
                           asp-route-page="@(Model.Page - 1)"
                           class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-border bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-brand-dark transition hover:border-brand-red hover:text-brand-red">
                            <span class="sm:hidden">←</span>
                            <span class="hidden sm:inline">Trang trước</span>
                        </a>
                    }
                    else
                    {
                        <span class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-border/70 bg-brand-light px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-brand-gray/60" aria-disabled="true">
                            <span class="sm:hidden">←</span>
                            <span class="hidden sm:inline">Trang trước</span>
                        </span>
                    }

                    <div class="flex flex-wrap items-center justify-center gap-2">
                        @for (var currentPage = paginationStart; currentPage <= paginationEnd; currentPage++)
                        {
                            var isActive = currentPage == Model.Page;
                            var mobileVisibilityClass = currentPage >= mobilePaginationStart && currentPage <= mobilePaginationEnd
                                ? "inline-flex"
                                : "hidden sm:inline-flex";

                            if (isActive)
                            {
                                <span aria-current="page"
                                      class="@mobileVisibilityClass h-11 min-w-11 items-center justify-center rounded-full border border-brand-red bg-brand-red px-3 text-sm font-semibold text-white shadow-soft">
                                    @currentPage
                                </span>
                            }
                            else
                            {
                                <a asp-area="Admin"
                                   asp-controller="Contact"
                                   asp-action="Index"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-page="@currentPage"
                                   class="@mobileVisibilityClass h-11 min-w-11 items-center justify-center rounded-full border border-brand-border bg-white px-3 text-sm font-semibold text-brand-dark transition hover:border-brand-red hover:text-brand-red">
                                    @currentPage
                                </a>
                            }
                        }
                    </div>

                    @if (Model.HasNextPage)
                    {
                        <a asp-area="Admin"
                           asp-controller="Contact"
                           asp-action="Index"
                           asp-route-StatusFilter="@Model.StatusFilter"
                           asp-route-page="@(Model.Page + 1)"
                           class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-border bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-brand-dark transition hover:border-brand-red hover:text-brand-red">
                            <span class="sm:hidden">→</span>
                            <span class="hidden sm:inline">Trang sau</span>
                        </a>
                    }
                    else
                    {
                        <span class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-border/70 bg-brand-light px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-brand-gray/60" aria-disabled="true">
                            <span class="sm:hidden">→</span>
                            <span class="hidden sm:inline">Trang sau</span>
                        </span>
                    }
                </div>
            </div>
        }
    </div>
</section>
