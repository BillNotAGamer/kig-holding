@model KIGHolding.Areas.Admin.ViewModels.ContactDetailViewModel

@{
    ViewData["Title"] = "Chi tiết liên hệ";
}

<section class="admin-page">
    <div class="admin-card">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div class="max-w-3xl">
                <p class="admin-page-kicker">Contact Detail</p>
                <h2 class="admin-card-title mt-2">@Model.FullName</h2>
                <p class="admin-help mt-2">Đọc nội dung đầy đủ của tin nhắn và cập nhật trạng thái xử lý của bộ phận chăm sóc khách hàng.</p>
            </div>

            <div class="rounded-md border border-brand-border bg-brand-light px-4 py-3 text-sm text-brand-gray">
                <p class="font-semibold text-brand-dark">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                <p class="mt-1">@Model.Subject</p>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
            @successMessage
        </div>
    }

    <div class="grid gap-6 lg:grid-cols-[1.35fr_0.9fr]">
        <div class="admin-card admin-card-muted">
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <p class="admin-label">Full Name</p>
                    <p class="mt-2 font-semibold text-brand-dark">@Model.FullName</p>
                </div>
                <div>
                    <p class="admin-label">Phone</p>
                    <p class="mt-2 font-black text-brand-dark">@Model.PhoneNumber</p>
                </div>
                <div>
                    <p class="admin-label">Email</p>
                    <p class="mt-2 font-semibold text-brand-dark">@(string.IsNullOrWhiteSpace(Model.Email) ? "Không có" : Model.Email)</p>
                </div>
                <div>
                    <p class="admin-label">Status</p>
                    <p class="mt-2 font-semibold text-brand-dark">@(Model.Status switch
                    {
                        ContactMessageStatus.New => "Mới",
                        ContactMessageStatus.Read => "Đã đọc",
                        ContactMessageStatus.Handled => "Đã xử lý",
                        ContactMessageStatus.Archived => "Đã lưu trữ",
                        _ => Model.Status.ToString()
                    })</p>
                </div>
                <div class="sm:col-span-2">
                    <p class="admin-label">Subject</p>
                    <p class="mt-2 font-semibold text-brand-dark">@(string.IsNullOrWhiteSpace(Model.Subject) ? "Không có" : Model.Subject)</p>
                </div>
            </div>

            <div class="mt-6">
                <p class="admin-label">Message</p>
                <div class="mt-2 whitespace-pre-line rounded-md border border-brand-border bg-brand-white p-4 text-sm leading-7 text-brand-dark">
                    @Model.Message
                </div>
            </div>
        </div>

        <div class="admin-card">
            <h3 class="admin-card-title">Cập nhật trạng thái</h3>

            <form asp-action="UpdateStatus" method="post" class="mt-4 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div>
                    <label asp-for="Status" class="admin-label mb-2"></label>
                    <select asp-for="Status" asp-items="Model.StatusOptions" class="admin-select"></select>
                </div>

                <button type="submit" class="btn-primary w-full">Lưu thay đổi</button>
                <a href="/Admin/Contact" class="btn-secondary w-full justify-center">Quay lại danh sách</a>
            </form>
        </div>
    </div>
</section>
