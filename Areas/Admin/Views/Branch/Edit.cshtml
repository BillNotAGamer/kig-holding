@model KIGHolding.Areas.Admin.ViewModels.BranchEditViewModel

@{
    ViewData["Title"] = "Sửa Chi nhánh";
}

<section class="admin-page">
    <div class="admin-page-header flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="admin-page-kicker">Update branch</p>
            <h1 class="admin-page-title">Chỉnh sửa chi nhánh</h1>
        </div>
        <a href="/Admin/Branch" class="btn-secondary w-full sm:w-auto">Quay lại danh sách</a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="admin-card space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingThumbnailUrl" />

        <div asp-validation-summary="ModelOnly" class="admin-validation rounded-md border border-brand-red/30 bg-brand-red/5 p-4"></div>

        <div class="grid gap-6 lg:grid-cols-2">
            <div class="space-y-5">
                <div>
                    <label asp-for="Name" class="admin-label mb-2"></label>
                    <input asp-for="Name" class="admin-field" />
                    <span asp-validation-for="Name" class="admin-validation"></span>
                </div>

                <div>
                    <label asp-for="Slug" class="admin-label mb-2"></label>
                    <input asp-for="Slug" class="admin-field" placeholder="Để trống để tự tạo từ tên chi nhánh" />
                    <p class="mt-2 text-xs text-brand-gray">Có thể nhập thủ công hoặc để trống để hệ thống tự tạo slug duy nhất từ tên chi nhánh.</p>
                    <span asp-validation-for="Slug" class="admin-validation"></span>
                </div>

                <div>
                    <label asp-for="Address" class="admin-label mb-2"></label>
                    <input asp-for="Address" class="admin-field" />
                    <span asp-validation-for="Address" class="admin-validation"></span>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="District" class="admin-label mb-2"></label>
                        <input asp-for="District" class="admin-field" />
                        <span asp-validation-for="District" class="admin-validation"></span>
                    </div>
                    <div>
                        <label asp-for="City" class="admin-label mb-2"></label>
                        <input asp-for="City" class="admin-field" />
                        <span asp-validation-for="City" class="admin-validation"></span>
                    </div>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="Hotline" class="admin-label mb-2"></label>
                        <input asp-for="Hotline" class="admin-field" />
                        <span asp-validation-for="Hotline" class="admin-validation"></span>
                    </div>
                    <div>
                        <label asp-for="Email" class="admin-label mb-2"></label>
                        <input asp-for="Email" class="admin-field" />
                        <span asp-validation-for="Email" class="admin-validation"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="GoogleMapUrl" class="admin-label mb-2"></label>
                    <input asp-for="GoogleMapUrl" class="admin-field" />
                    <span asp-validation-for="GoogleMapUrl" class="admin-validation"></span>
                </div>
            </div>

            <div class="space-y-5">
                <div class="space-y-4 rounded-2xl border border-brand-border bg-brand-light/40 p-4 sm:p-5">
                    <div>
                        <p class="text-xs font-black uppercase tracking-[0.16em] text-brand-gray">THỜI GIAN HOẠT ĐỘNG</p>
                        <p class="mt-2 text-xs text-brand-gray">Nhập theo định dạng 24 giờ HH:mm. Để trống cả hai ô nếu chi nhánh không nghỉ trưa.</p>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label asp-for="OpeningTimeText" class="admin-label mb-2"></label>
                            <input asp-for="OpeningTimeText"
                                   type="text"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   maxlength="5"
                                   placeholder="HH:mm"
                                   pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]"
                                   title="Nhập giờ theo định dạng 24 giờ, ví dụ 14:30"
                                   class="admin-field" />
                            <span asp-validation-for="OpeningTimeText" class="admin-validation"></span>
                        </div>
                        <div>
                            <label asp-for="ClosingTimeText" class="admin-label mb-2"></label>
                            <input asp-for="ClosingTimeText"
                                   type="text"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   maxlength="5"
                                   placeholder="HH:mm"
                                   pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]"
                                   title="Nhập giờ theo định dạng 24 giờ, ví dụ 22:00"
                                   class="admin-field" />
                            <span asp-validation-for="ClosingTimeText" class="admin-validation"></span>
                        </div>
                    </div>

                    <div>
                        <p class="text-xs font-black uppercase tracking-[0.16em] text-brand-gray">Nghỉ trưa</p>
                        <div class="mt-3 grid gap-4 sm:grid-cols-2">
                            <div>
                                <label asp-for="LunchBreakStartText" class="admin-label mb-2"></label>
                                <input asp-for="LunchBreakStartText"
                                       type="text"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       maxlength="5"
                                       placeholder="HH:mm"
                                       pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]"
                                       title="Nhập giờ theo định dạng 24 giờ, ví dụ 14:00"
                                       class="admin-field" />
                                <span asp-validation-for="LunchBreakStartText" class="admin-validation"></span>
                            </div>
                            <div>
                                <label asp-for="LunchBreakEndText" class="admin-label mb-2"></label>
                                <input asp-for="LunchBreakEndText"
                                       type="text"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       maxlength="5"
                                       placeholder="HH:mm"
                                       pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]"
                                       title="Nhập giờ theo định dạng 24 giờ, ví dụ 16:00"
                                       class="admin-field" />
                                <span asp-validation-for="LunchBreakEndText" class="admin-validation"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid gap-4 sm:grid-cols-3">
                    <div>
                        <label asp-for="Capacity" class="admin-label mb-2"></label>
                        <input asp-for="Capacity" type="number" class="admin-field" />
                        <span asp-validation-for="Capacity" class="admin-validation"></span>
                    </div>
                    <div>
                        <label asp-for="AreaSquareMeters" class="admin-label mb-2"></label>
                        <input asp-for="AreaSquareMeters" type="number" step="0.01" class="admin-field" />
                        <span asp-validation-for="AreaSquareMeters" class="admin-validation"></span>
                    </div>
                    <div>
                        <label asp-for="NumberOfFloors" class="admin-label mb-2"></label>
                        <input asp-for="NumberOfFloors" type="number" class="admin-field" />
                        <span asp-validation-for="NumberOfFloors" class="admin-validation"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="DisplayOrder" class="admin-label mb-2"></label>
                    <input asp-for="DisplayOrder" type="number" class="admin-field" />
                    <span asp-validation-for="DisplayOrder" class="admin-validation"></span>
                </div>

                <div class="admin-upload">
                    <label asp-for="ThumbnailFile" class="admin-upload__label"></label>
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingThumbnailUrl))
                    {
                        <div class="admin-upload__current">
                            <img src="@Model.ExistingThumbnailUrl" alt="Ảnh chi nhánh hiện tại" class="admin-upload__current-image" />
                            <div class="admin-upload__preview-meta">
                                <p class="text-sm font-semibold text-brand-dark">Ảnh hiện tại</p>
                                <p class="text-sm leading-6 text-brand-gray">Tải ảnh mới nếu bạn muốn thay thế ảnh đại diện đang hiển thị.</p>
                            </div>
                        </div>
                    }
                    <div class="admin-upload__dropzone">
                        <p class="admin-upload__dropzone-title">Chọn ảnh mới để thay thế</p>
                        <p class="admin-upload__dropzone-text">Để trống nếu bạn muốn giữ nguyên ảnh hiện tại. Khi chọn ảnh mới, hệ thống sẽ hiển thị xem trước trước khi lưu.</p>
                        <input asp-for="ThumbnailFile"
                               type="file"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               class="admin-upload__input"
                               data-admin-image-preview
                               data-admin-image-preview-target="#branch-thumbnail-preview"
                               data-admin-image-preview-meta="#branch-thumbnail-preview-meta" />
                    </div>
                    <p class="admin-upload__hint">Hỗ trợ: jpg, jpeg, png, webp. Kích thước tối đa 2MB.</p>
                    <div class="admin-upload__preview" hidden>
                        <img id="branch-thumbnail-preview" alt="Xem trước ảnh chi nhánh mới" class="admin-upload__preview-image" hidden />
                        <div class="admin-upload__preview-meta">
                            <p class="text-sm font-semibold text-brand-dark">Ảnh mới đã chọn</p>
                            <p id="branch-thumbnail-preview-meta"></p>
                        </div>
                    </div>
                    <span asp-validation-for="ThumbnailFile" class="admin-validation"></span>
                </div>

                <div>
                    <label asp-for="Description" class="admin-label mb-2"></label>
                    <textarea asp-for="Description" rows="5" class="admin-textarea"></textarea>
                    <span asp-validation-for="Description" class="admin-validation"></span>
                </div>

                <label class="admin-post-checkbox-shell">
                    <input asp-for="IsActive" type="checkbox" class="admin-checkbox" />
                    <span>@Html.DisplayNameFor(x => x.IsActive)</span>
                </label>
            </div>
        </div>

        <div class="flex flex-col gap-3 border-t border-brand-border pt-6 sm:flex-row sm:justify-end">
            <button type="submit" class="btn-primary w-full sm:w-auto">Lưu thay đổi</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
