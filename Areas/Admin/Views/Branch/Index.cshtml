@model IEnumerable<KIGHolding.Models.Entities.Branch>

@{
    ViewData["Title"] = "Quản lý Chi nhánh";
    var branches = Model.ToList();
}

<section class="admin-page">
    <div class="admin-page-header flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
            <p class="admin-page-kicker">Branch Ops</p>
            <h1 class="admin-page-title">Danh sách chi nhánh</h1>
            <p class="admin-help">Quản lý địa chỉ, hình ảnh, hotline và trạng thái hiển thị công khai của từng chi nhánh trên website.</p>
        </div>

        <a href="@Url.Action("Create")" class="btn-primary">Tạo chi nhánh mới</a>
    </div>

    <div class="admin-table-wrap">
        @if (branches.Any())
        {
            <div class="border-b border-brand-border bg-brand-light/60 px-4 py-4 sm:px-6">
                <p class="text-sm font-semibold text-brand-dark">Tổng cộng @branches.Count chi nhánh đang được quản lý.</p>
            </div>

            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th>Chi nhánh</th>
                            <th>Thành phố</th>
                            <th>Hotline</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var branch in branches)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(branch.ThumbnailUrl))
                                    {
                                        <img src="@branch.ThumbnailUrl" alt="@branch.Name" class="h-14 w-24 rounded-2xl border border-brand-border object-cover" />
                                    }
                                    else
                                    {
                                        <div class="grid h-14 w-24 place-items-center rounded-2xl border border-dashed border-brand-border bg-brand-light text-center text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-gray">
                                            No image
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="max-w-xs">
                                        <p class="font-semibold text-brand-dark">@branch.Name</p>
                                        <p class="mt-1 text-xs text-brand-gray">/@branch.Slug</p>
                                        <p class="mt-2 text-sm leading-6 text-brand-gray">@branch.Address, @branch.District</p>
                                    </div>
                                </td>
                                <td class="font-medium text-brand-dark">@branch.City</td>
                                <td class="font-semibold text-brand-dark">@branch.Hotline</td>
                                <td>
                                    @if (branch.IsActive)
                                    {
                                        <span class="admin-badge admin-badge--success">Đang hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge--muted">Đã ẩn</span>
                                    }
                                </td>
                                <td>
                                    <div class="admin-actions gap-2">
                                        <a href="@Url.Action("Edit", new { id = branch.Id })" class="admin-table-action admin-table-action--muted">Sửa</a>

                                        <form asp-action="Delete" asp-route-id="@branch.Id" method="post" class="inline" onsubmit="return confirm('Ẩn chi nhánh này khỏi website công khai?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="admin-table-action admin-table-action--danger">Xóa mềm</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-6 sm:p-8">
                <div class="admin-empty">
                    <div>
                        <p class="admin-empty__title">Chưa có chi nhánh nào</p>
                        <p class="admin-empty__text">Tạo chi nhánh đầu tiên để quản lý thông tin địa chỉ, hotline và trạng thái hiển thị công khai.</p>
                        <a href="@Url.Action("Create")" class="btn-primary mt-6">Tạo chi nhánh mới</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
