@model KIGHolding.Areas.Admin.ViewModels.BranchIndexViewModel

@{
    ViewData["Title"] = "Quản lý Chi nhánh";

    var branches = Model.Branches;
    var paginationStart = Math.Max(1, Model.Page - 2);
    var paginationEnd = Math.Min(Model.TotalPages, Model.Page + 2);

    if (Model.TotalPages > 1 && paginationEnd - paginationStart < 4)
    {
        if (paginationStart == 1)
        {
            paginationEnd = Math.Min(Model.TotalPages, paginationStart + 4);
        }
        else if (paginationEnd == Model.TotalPages)
        {
            paginationStart = Math.Max(1, paginationEnd - 4);
        }
    }

    var mobilePaginationStart = Math.Max(1, Model.Page - 1);
    var mobilePaginationEnd = Math.Min(Model.TotalPages, Model.Page + 1);
}

<section class="admin-page">
    <div class="admin-page-header flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
            <p class="admin-page-kicker">Branch Ops</p>
            <h1 class="admin-page-title">Danh sách chi nhánh</h1>
            <p class="admin-help">Quản lý địa chỉ, hình ảnh, hotline và trạng thái hiển thị công khai của từng chi nhánh trên website.</p>
        </div>

        <a href="@Url.Action("Create")" class="btn-primary w-full sm:w-auto">Tạo chi nhánh mới</a>
    </div>

    <div class="admin-table-wrap">
        @if (branches.Any())
        {
            <div class="border-b border-brand-border bg-brand-light/60 px-4 py-4 sm:px-6">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm font-semibold text-brand-dark">Hiển thị @Model.FirstItemIndex-@Model.LastItemIndex trong @Model.TotalItems chi nhánh.</p>
                    <p class="text-sm text-brand-gray">Trang @Model.Page / @Model.TotalPages</p>
                </div>
            </div>

            <div class="hidden overflow-x-auto md:block">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th>Chi nhánh</th>
                            <th>Thành phố</th>
                            <th>Hotline</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var branch in branches)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(branch.ThumbnailUrl))
                                    {
                                        <img src="@branch.ThumbnailUrl" alt="@branch.Name" class="h-14 w-24 rounded-2xl border border-brand-border object-cover" />
                                    }
                                    else
                                    {
                                        <div class="grid h-14 w-24 place-items-center rounded-2xl border border-dashed border-brand-border bg-brand-light text-center text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-gray">
                                            No image
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="max-w-xs">
                                        <p class="font-semibold text-brand-dark">@branch.Name</p>
                                        <p class="mt-1 text-xs text-brand-gray">/@branch.Slug</p>
                                        <p class="mt-2 text-sm leading-6 text-brand-gray">@branch.Address, @branch.District</p>
                                    </div>
                                </td>
                                <td class="font-medium text-brand-dark">@branch.City</td>
                                <td class="font-semibold text-brand-dark">@branch.Hotline</td>
                                <td>
                                    @if (branch.IsActive)
                                    {
                                        <span class="admin-badge admin-badge--success">Đang hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge--muted">Đã ẩn</span>
                                    }
                                </td>
                                <td>
                                    <div class="admin-actions gap-2">
                                        <a href="@Url.Action("Edit", new { id = branch.Id })" class="admin-table-action admin-table-action--muted">Sửa</a>

                                        <form asp-action="Delete" asp-route-id="@branch.Id" asp-route-page="@Model.Page" method="post" class="inline" onsubmit="return confirm('Xóa mềm chi nhánh này? Chi nhánh sẽ được ẩn khỏi website công khai nhưng vẫn giữ dữ liệu đặt bàn và đánh giá trong hệ thống.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="admin-table-action admin-table-action--muted">Xóa mềm</button>
                                        </form>

                                        <form asp-action="PermanentDelete"
                                              asp-route-id="@branch.Id"
                                              asp-route-page="@Model.Page"
                                              method="post"
                                              class="inline"
                                              onsubmit="return confirm('XÓA VĨNH VIỄN chi nhánh này? Chỉ có thể xóa khi chi nhánh không có dữ liệu đặt bàn. Dữ liệu chi nhánh và ảnh đại diện sẽ bị gỡ khỏi hệ thống. Không thể hoàn tác.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="admin-table-action admin-table-action--danger">Xóa vĩnh viễn</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="grid gap-4 p-3 md:hidden">
                @foreach (var branch in branches)
                {
                    <article class="rounded-2xl border border-brand-border bg-brand-white p-4 shadow-soft">
                        <div class="flex gap-3">
                            @if (!string.IsNullOrWhiteSpace(branch.ThumbnailUrl))
                            {
                                <img src="@branch.ThumbnailUrl" alt="@branch.Name" class="h-20 w-24 flex-none rounded-2xl border border-brand-border object-cover" />
                            }
                            else
                            {
                                <div class="grid h-20 w-24 flex-none place-items-center rounded-2xl border border-dashed border-brand-border bg-brand-light text-center text-[10px] font-semibold uppercase tracking-[0.12em] text-brand-gray">
                                    No image
                                </div>
                            }

                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-start justify-between gap-2">
                                    <p class="break-words text-base font-black text-brand-dark">@branch.Name</p>
                                    @if (branch.IsActive)
                                    {
                                        <span class="admin-badge admin-badge--success">Đang hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge--muted">Đã ẩn</span>
                                    }
                                </div>
                                <p class="mt-1 break-all text-xs text-brand-gray">/@branch.Slug</p>
                                <p class="mt-2 text-sm font-semibold text-brand-dark">@branch.City</p>
                            </div>
                        </div>

                        <dl class="mt-4 grid gap-2 text-sm">
                            <div class="rounded-xl bg-brand-light p-3">
                                <dt class="text-[10px] font-black uppercase tracking-[0.14em] text-brand-gray">Địa chỉ</dt>
                                <dd class="mt-1 break-words font-semibold text-brand-dark">@branch.Address, @branch.District</dd>
                            </div>
                            <div class="rounded-xl bg-brand-light p-3">
                                <dt class="text-[10px] font-black uppercase tracking-[0.14em] text-brand-gray">Hotline</dt>
                                <dd class="mt-1 break-words font-semibold text-brand-dark">@branch.Hotline</dd>
                            </div>
                        </dl>

                        <div class="mt-4 grid gap-2 sm:grid-cols-2">
                            <a href="@Url.Action("Edit", new { id = branch.Id })" class="admin-table-action admin-table-action--muted min-h-11 w-full">Sửa</a>

                            <form asp-action="Delete"
                                  asp-route-id="@branch.Id"
                                  asp-route-page="@Model.Page"
                                  method="post"
                                  class="w-full"
                                  onsubmit="return confirm('Xóa mềm chi nhánh này? Chi nhánh sẽ được ẩn khỏi website công khai nhưng vẫn giữ dữ liệu đặt bàn và đánh giá trong hệ thống.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-table-action admin-table-action--muted min-h-11 w-full">Xóa mềm</button>
                            </form>

                            <form asp-action="PermanentDelete"
                                  asp-route-id="@branch.Id"
                                  asp-route-page="@Model.Page"
                                  method="post"
                                  class="w-full"
                                  onsubmit="return confirm('XÓA VĨNH VIỄN chi nhánh này? Chỉ có thể xóa khi chi nhánh không có dữ liệu đặt bàn. Dữ liệu chi nhánh và ảnh đại diện sẽ bị gỡ khỏi hệ thống. Không thể hoàn tác.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-table-action admin-table-action--danger min-h-11 w-full">Xóa vĩnh viễn</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="p-6 sm:p-8">
                <div class="admin-empty">
                    <div>
                        <p class="admin-empty__title">Chưa có chi nhánh nào</p>
                        <p class="admin-empty__text">Tạo chi nhánh đầu tiên để quản lý thông tin địa chỉ, hotline và trạng thái hiển thị công khai.</p>
                        <a href="@Url.Action("Create")" class="btn-primary mt-6">Tạo chi nhánh mới</a>
                    </div>
                </div>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="border-t border-brand-border px-4 py-4 sm:px-6">
                <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-area="Admin"
                           asp-controller="Branch"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-border bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-brand-dark transition hover:border-brand-red hover:text-brand-red">
                            <span class="sm:hidden">←</span>
                            <span class="hidden sm:inline">Trang trước</span>
                        </a>
                    }
                    else
                    {
                        <span class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-border/70 bg-brand-light px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-brand-gray/60" aria-disabled="true">
                            <span class="sm:hidden">←</span>
                            <span class="hidden sm:inline">Trang trước</span>
                        </span>
                    }

                    <div class="flex flex-wrap items-center justify-center gap-2">
                        @for (var currentPage = paginationStart; currentPage <= paginationEnd; currentPage++)
                        {
                            var isActive = currentPage == Model.Page;
                            var mobileVisibilityClass = currentPage >= mobilePaginationStart && currentPage <= mobilePaginationEnd
                                ? "inline-flex"
                                : "hidden sm:inline-flex";

                            if (isActive)
                            {
                                <span aria-current="page"
                                      class="@mobileVisibilityClass h-11 min-w-11 items-center justify-center rounded-full border border-brand-red bg-brand-red px-3 text-sm font-semibold text-white shadow-soft">
                                    @currentPage
                                </span>
                            }
                            else
                            {
                                <a asp-area="Admin"
                                   asp-controller="Branch"
                                   asp-action="Index"
                                   asp-route-page="@currentPage"
                                   class="@mobileVisibilityClass h-11 min-w-11 items-center justify-center rounded-full border border-brand-border bg-white px-3 text-sm font-semibold text-brand-dark transition hover:border-brand-red hover:text-brand-red">
                                    @currentPage
                                </a>
                            }
                        }
                    </div>

                    @if (Model.HasNextPage)
                    {
                        <a asp-area="Admin"
                           asp-controller="Branch"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-border bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-brand-dark transition hover:border-brand-red hover:text-brand-red">
                            <span class="sm:hidden">→</span>
                            <span class="hidden sm:inline">Trang sau</span>
                        </a>
                    }
                    else
                    {
                        <span class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-border/70 bg-brand-light px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-brand-gray/60" aria-disabled="true">
                            <span class="sm:hidden">→</span>
                            <span class="hidden sm:inline">Trang sau</span>
                        </span>
                    }
                </div>
            </div>
        }
    </div>
</section>
