@{
    var pageTitle = ViewData["Title"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var successMessage = TempData["SuccessMessage"]?.ToString();
    var errorMessage = TempData["ErrorMessage"]?.ToString();
    var hasAdminSuffix = !string.IsNullOrWhiteSpace(pageTitle) && pageTitle.Contains("quản trị", StringComparison.OrdinalIgnoreCase);
    var resolvedPageTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "Tổng quan quản trị - Truyền Thuyết Champong"
        : hasAdminSuffix
            ? pageTitle
            : $"{pageTitle} - Quản trị";
    var headerTitle = string.IsNullOrWhiteSpace(pageTitle) ? "Tổng quan quản trị" : pageTitle;
}

<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#111827" />
    <title>@resolvedPageTitle</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-brand-light text-brand-dark antialiased">
    <header class="fixed inset-x-0 top-0 z-40 flex h-16 items-center justify-between border-b border-white/10 bg-brand-black px-4 text-white shadow-panel lg:hidden">
        <button type="button"
                class="inline-flex size-11 items-center justify-center rounded-xl border border-white/15 bg-white/[0.06] text-white transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
                aria-label="Open admin menu"
                aria-controls="admin-sidebar"
                aria-expanded="false"
                data-admin-menu-open>
            <span class="sr-only">Open admin menu</span>
            <span class="flex flex-col gap-1.5" aria-hidden="true">
                <span class="block h-0.5 w-5 rounded-full bg-current"></span>
                <span class="block h-0.5 w-5 rounded-full bg-current"></span>
                <span class="block h-0.5 w-5 rounded-full bg-current"></span>
            </span>
        </button>

        <a href="/Admin/Dashboard" class="flex items-center gap-3">
            <span class="brand-mark">AD</span>
            <span class="text-sm font-black uppercase tracking-[0.16em]">Admin</span>
        </a>

        <span class="w-11 text-right text-[10px] font-black uppercase tracking-[0.18em] text-white/45">KIG</span>
    </header>

    <div class="fixed inset-0 z-40 hidden bg-black/55 backdrop-blur-sm lg:hidden"
         aria-hidden="true"
         data-admin-menu-overlay></div>

    <div class="min-h-screen pt-16 lg:grid lg:grid-cols-[18rem_1fr] lg:pt-0">
        <aside id="admin-sidebar"
               class="fixed inset-y-0 left-0 z-50 w-72 -translate-x-full overflow-y-auto border-r border-white/10 bg-brand-black text-white shadow-panel transition-transform duration-300 ease-out lg:sticky lg:top-0 lg:h-dvh lg:w-auto lg:translate-x-0 lg:overflow-y-visible lg:shadow-none"
               data-admin-drawer>
            <div class="flex h-full min-h-0 flex-col">
                <div class="flex items-center justify-between gap-3 border-b border-white/10 px-6 py-6">
                    <a href="/admin" class="flex items-center gap-3">
                        <span class="brand-mark">AD</span>
                        <div>
                            <p class="text-sm font-black uppercase tracking-[0.18em] text-white">Quản trị nội bộ</p>
                            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-white/45">KIG Holding</p>
                        </div>
                    </a>
                    <button type="button"
                            class="inline-flex size-10 items-center justify-center rounded-xl border border-white/15 bg-white/[0.06] text-xl leading-none text-white transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60 lg:hidden"
                            aria-label="Close admin menu"
                            data-admin-menu-close>
                        &times;
                    </button>
                </div>

                <nav class="flex-1 px-4 py-6 lg:overflow-y-auto">
                    <p class="px-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-white/40">Điều hướng</p>
                    <div class="mt-4 space-y-5">
                        <div class="space-y-1">                          
                            <div class="space-y-1">
                                <a href="/Admin/Dashboard"
                                   aria-current="@(IsActive(currentController, "Dashboard") ? "page" : null)"
                                   class="@NavLinkClass(currentController, "Dashboard")">
                                    Tổng quan
                                </a>
                                <a href="/Admin/Reservation"
                                   aria-current="@(IsActive(currentController, "Reservation") ? "page" : null)"
                                   class="@NavLinkClass(currentController, "Reservation")">
                                    Quản lý Đặt bàn
                                </a>
                                <a href="/Admin/Contact"
                                   aria-current="@(IsActive(currentController, "Contact") ? "page" : null)"
                                   class="@NavLinkClass(currentController, "Contact")">
                                    Quản lý Liên hệ
                                </a>
                                <a href="/Admin/MenuGroup"
                                       aria-current="@(IsActive(currentController, "MenuGroup") ? "page" : null)"
                                       class="@NavLinkClass(currentController, "MenuGroup")">
                                    Nhóm thực đơn
                                </a>
                                <a href="/Admin/Post"
                                       aria-current="@(IsActive(currentController, "Post") ? "page" : null)"
                                       class="@NavLinkClass(currentController, "Post")">
                                    Bài viết
                                </a>
                                <a href="/Admin/Review"
                                       aria-current="@(IsActive(currentController, "Review") ? "page" : null)"
                                       class="@NavLinkClass(currentController, "Review")">
                                    Đánh giá
                                </a>
                                <a href="/Admin/Branch"
                                       aria-current="@(IsActive(currentController, "Branch") ? "page" : null)"
                                       class="@NavLinkClass(currentController, "Branch")">
                                    Quản lý Chi nhánh
                                </a>
                                <a href="/Admin/Setting"
                                       aria-current="@(IsActive(currentController, "Setting") ? "page" : null)"
                                       class="@NavLinkClass(currentController, "Setting")">
                                    Cấu hình Website
                                </a>
                                <a href="/Admin/Account/Security"
                                       aria-current="@(IsActive(currentController, "Account") ? "page" : null)"
                                       class="@NavLinkClass(currentController, "Account")">
                                    Đổi mật khẩu
                                </a>
                            </div>
                        </div>
                        
                    </div>
                </nav>

                <div class="border-t border-white/10 px-4 py-5">
                    <a href="/" target="_blank" rel="noopener" class="btn-ghost w-full border-white/10 bg-white/[0.04] !text-white/75">
                        Xem website
                    </a>
                </div>
            </div>
        </aside>

        <div class="min-w-0 overflow-hidden">
            <header class="sticky top-16 z-30 border-b border-brand-border bg-white/90 backdrop-blur lg:top-0">
                <div class="flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
                    <div>
                        <h1 class="text-lg font-black text-brand-dark">@headerTitle</h1>
                        <p class="text-xs uppercase tracking-[0.16em] text-brand-gray">Khu vực quản trị</p>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="hidden text-right sm:block">
                            <p class="text-sm font-semibold text-brand-dark">@User.Identity?.Name</p>
                            <p class="text-xs text-brand-gray">SuperAdmin</p>
                        </div>
                        <form asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-secondary h-10">Đăng xuất</button>
                        </form>
                    </div>
                </div>
            </header>

            <main class="min-h-[calc(100svh-8rem)] px-3 py-5 sm:px-6 lg:min-h-[calc(100svh-4rem)] lg:px-8 lg:py-8">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="pointer-events-none fixed bottom-4 left-1/2 z-[60] w-[min(24rem,calc(100vw-2rem))] -translate-x-1/2 space-y-3 sm:bottom-auto sm:left-auto sm:right-4 sm:top-4 sm:translate-x-0">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="admin-toast pointer-events-auto rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 shadow-soft transition-all duration-300" data-toast>
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 grid size-5 place-items-center rounded-full bg-emerald-100 text-xs font-black text-emerald-700">✓</span>
                    <div>
                        <p class="font-semibold text-emerald-900">Thành công</p>
                        <p class="mt-1 leading-6">@successMessage</p>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="admin-toast pointer-events-auto rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 shadow-soft transition-all duration-300" data-toast>
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 grid size-5 place-items-center rounded-full bg-red-100 text-xs font-black text-red-700">!</span>
                    <div>
                        <p class="font-semibold text-red-900">Có lỗi</p>
                        <p class="mt-1 leading-6">@errorMessage</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script>
        (function () {
            var toasts = document.querySelectorAll('[data-toast]');
            if (!toasts.length) {
                return;
            }

            toasts.forEach(function (toast) {
                window.setTimeout(function () {
                    toast.classList.add('opacity-0', 'translate-y-2');
                    window.setTimeout(function () {
                        toast.remove();
                    }, 300);
                }, 4000);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private static bool IsActive(string? currentController, string controllerName)
    {
        return string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase);
    }

    private static string NavLinkClass(string? currentController, string controllerName)
    {
        var baseClass = "block rounded-xl border-l-2 px-3 py-3 text-sm font-semibold transition duration-200";
        return IsActive(currentController, controllerName)
            ? $"{baseClass} border-brand-red bg-brand-red/10 text-white shadow-soft"
            : $"{baseClass} border-transparent text-white/80 hover:bg-white/10 hover:text-white";
    }
}
