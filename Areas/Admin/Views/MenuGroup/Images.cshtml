  @model KIGHolding.Areas.Admin.ViewModels.MenuGroupImagesViewModel

@{
    ViewData["Title"] = "Quản lý ảnh thực đơn";
}

@{
    var showHeavyImageLoadNotice = Model.Images.Count >= 12;
}

<section class="admin-page">
    <div class="admin-page-header flex flex-col gap-5 p-6 sm:p-7 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
            <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-gray transition hover:text-brand-red">
                <span aria-hidden="true">←</span>
                <span>Quay lại nhóm thực đơn</span>
            </a>
            <p class="mt-4 admin-page-kicker">Menu Pages</p>
            <h1 class="admin-page-title">Quản lý ảnh thực đơn</h1>
            <p class="mt-2 text-sm font-semibold text-brand-dark">@Model.MenuGroupName</p>
            <p class="mt-1 text-xs uppercase tracking-[0.16em] text-brand-gray">@Model.MenuGroupSlug</p>
            <p class="mt-3 admin-help">Tải lên và sắp xếp các ảnh thực đơn sẽ hiển thị trong trang menu của nhóm này.</p>
        </div>
    </div>

    <div class="admin-card">
        <h2 class="admin-card-title">Tải ảnh thực đơn</h2>
        <p class="mt-2 admin-help">Giữ nguyên luồng upload hiện tại, chỉ cải thiện cách hiển thị hướng dẫn và trạng thái file đã chọn trước khi submit.</p>

        <form method="post"
              action="@Url.RouteUrl("AdminMenuGroupImagesUpload", new { menuGroupId = Model.MenuGroupId })"
              enctype="multipart/form-data"
              id="menu-page-upload-form"
              class="mt-6 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MenuGroupId" value="@Model.MenuGroupId" />

            <div class="admin-upload admin-upload--multi">
                <label for="Upload_ImageFiles" class="admin-upload__label">Ảnh thực đơn</label>
                <div class="admin-upload__dropzone">
                    <p class="admin-upload__dropzone-title">Chọn nhiều ảnh cho menu</p>
                    <p class="admin-upload__dropzone-text">Có thể chọn nhiều file cùng lúc. Ảnh mới sẽ được thêm nối tiếp theo thứ tự hiển thị hiện có sau khi upload thành công.</p>
                    <input id="Upload_ImageFiles"
                           name="ImageFiles"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           multiple
                           class="admin-upload__input"
                           data-admin-file-count="#menu-page-upload-file-count"
                           data-admin-file-list="#menu-page-upload-file-list" />
                </div>
                <p class="admin-upload__hint">Hỗ trợ: jpg, jpeg, png, webp. Tối đa 10 ảnh mỗi lần tải lên. Mỗi file tối đa 50MB.</p>
                <p id="menu-page-upload-file-count" class="text-sm font-semibold text-brand-dark" aria-live="polite">Chưa chọn file nào.</p>
                <ul id="menu-page-upload-file-list" class="grid gap-2" hidden></ul>
            </div>

            <div class="grid gap-5 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
                <div>
                    <label for="Upload_AltText" class="admin-post-label">Alt text chung</label>
                    <input id="Upload_AltText"
                           name="AltText"
                           type="text"
                           value="@Model.Upload.AltText"
                           class="admin-post-field"
                           placeholder="Để trống để tự tạo theo tên nhóm và số trang" />
                </div>

                <label class="admin-post-checkbox-shell">
                    <input name="IsPublished" type="checkbox" value="true" checked="@Model.Upload.IsPublished" class="admin-post-checkbox" />
                    <input name="IsPublished" type="hidden" value="false" />
                    <span>Đăng công khai ngay sau khi tải lên</span>
                </label>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <button type="submit" class="btn-primary w-full sm:w-auto">Tải ảnh lên</button>
            </div>
        </form>
    </div>

    <div class="admin-table-wrap">
        <div class="border-b border-brand-border bg-brand-light/60 px-6 py-4 sm:px-7">
            @if (Model.Images.Count > 0)
            {
                <form id="bulk-delete-form"
                      method="post"
                      action="@Url.RouteUrl("AdminMenuGroupImagesBulkDelete", new { menuGroupId = Model.MenuGroupId })"
                      onsubmit="return confirm('Bạn có chắc muốn xóa các ảnh đã chọn?');">
                    @Html.AntiForgeryToken()
                </form>

                <div class="admin-mobile-bulk-bar mb-4 flex flex-col gap-3 rounded-2xl border border-brand-border bg-brand-white p-3 shadow-soft transition sm:flex-row sm:items-center sm:justify-between lg:bg-transparent lg:p-0 lg:shadow-none"
                     data-menu-image-bulk-bar>
                    <div class="flex flex-wrap items-center gap-3">
                        <label class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-brand-gray">
                            <input type="checkbox" class="admin-checkbox" data-menu-image-select-all />
                            <span>Chọn tất cả</span>
                        </label>
                        <span class="text-sm font-semibold text-brand-gray" data-menu-image-selected-count>
                            Đã chọn 0 ảnh
                        </span>
                    </div>

                    <button type="submit"
                            form="bulk-delete-form"
                            class="admin-table-action admin-table-action--danger min-h-11 w-full sm:w-auto"
                            data-bulk-delete-submit
                            disabled>
                        Xóa ảnh đã chọn
                    </button>
                </div>

                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm font-semibold text-brand-dark">Tổng cộng @Model.Images.Count ảnh thực đơn</p>
                    <p class="text-sm text-brand-gray">@Model.Images.Count(x => x.IsPublished) đang hiển thị, @Model.Images.Count(x => !x.IsPublished) đã ẩn</p>
                </div>
                @if (showHeavyImageLoadNotice)
                {
                    <div class="admin-menu-images-notice">
                        <p class="admin-menu-images-notice__title">Trang có nhiều ảnh dung lượng lớn. Trình duyệt có thể mất vài giây để tải đầy đủ ảnh xem trước.</p>
                        <p class="admin-menu-images-notice__text">Nếu trình duyệt hiển thị trắng sau khi upload nhiều ảnh, hãy thử Ctrl + F5 hoặc xóa cache localhost.</p>
                    </div>
                }
            }
            else
            {
                <p class="text-sm font-semibold text-brand-dark">Chưa có ảnh thực đơn nào.</p>
            }
        </div>

        @if (Model.Images.Count > 0)
        {
            <div class="grid grid-cols-2 gap-3 p-3 md:gap-4 md:p-5 xl:grid-cols-3">
                @foreach (var image in Model.Images)
                {
                    <article class="admin-card p-3 sm:p-4">
                        <label class="inline-flex min-h-10 items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-brand-gray sm:text-xs">
                            <input type="checkbox"
                                   name="selectedImageIds"
                                   value="@image.Id"
                                   form="bulk-delete-form"
                                   class="admin-checkbox"
                                   data-menu-image-select />
                            <span>Chọn</span>
                        </label>

                        <div class="admin-menu-image-preview mt-3">
                            <img src="@image.ImageUrl"
                                 alt="@image.AltText"
                                 loading="lazy"
                                 decoding="async"
                                 class="admin-menu-image-preview__image" />
                        </div>

                        <div class="mt-3 flex flex-wrap items-center gap-2">
                            @if (image.IsPublished)
                            {
                                <span class="admin-badge admin-badge--success">Đang hiển thị</span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge--muted">Đã ẩn</span>
                            }
                        </div>

                        <p class="mt-3 hidden break-all text-xs leading-6 text-brand-gray sm:block">@image.ImageUrl</p>

                        <form method="post"
                              action="@Url.RouteUrl("AdminMenuGroupImagesUpdate", new { menuGroupId = Model.MenuGroupId })"
                              id="menu-page-update-@image.Id"
                              class="mt-4 space-y-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@image.Id" />
                            <input type="hidden" name="MenuGroupId" value="@Model.MenuGroupId" />

                            <div>
                                <label class="admin-post-label" for="alt-@image.Id">Alt text</label>
                                <input id="alt-@image.Id"
                                       name="AltText"
                                       type="text"
                                       value="@image.AltText"
                                       class="admin-post-field" />
                            </div>

                            <div>
                                <label class="admin-post-label" for="order-@image.Id">Thứ tự hiển thị</label>
                                <input id="order-@image.Id"
                                       name="DisplayOrder"
                                       type="number"
                                       min="0"
                                       value="@image.DisplayOrder"
                                       class="admin-post-field max-w-28" />
                            </div>

                            <label class="admin-post-checkbox-shell min-h-12 px-3 py-2 text-xs sm:text-sm">
                                <input name="IsPublished" type="checkbox" value="true" checked="@image.IsPublished" class="admin-post-checkbox" />
                                <input name="IsPublished" type="hidden" value="false" />
                                <span>Hiển thị công khai</span>
                            </label>

                            <dl class="hidden gap-3 text-sm sm:grid sm:grid-cols-2">
                                <div>
                                    <dt class="text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-gray">Tạo lúc</dt>
                                    <dd class="mt-1 text-brand-dark">@image.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                                </div>
                                <div>
                                    <dt class="text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-gray">Cập nhật</dt>
                                    <dd class="mt-1 text-brand-dark">@image.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                                </div>
                            </dl>

                        </form>

                        <div class="mt-3 grid grid-cols-2 gap-2 border-t border-brand-border pt-3">
                            <button type="submit" form="menu-page-update-@image.Id" class="btn-primary min-h-11 w-full px-3 text-[10px] sm:text-xs">Lưu</button>

                            <form method="post"
                                  action="@Url.RouteUrl("AdminMenuGroupImagesDelete", new { menuGroupId = Model.MenuGroupId, imageId = image.Id })"
                                  id="menu-page-delete-@image.Id"
                                  class="contents"
                                  onsubmit="return confirm('Xóa ảnh thực đơn này? Hành động này sẽ xóa bản ghi và thử xóa file vật lý nếu thuộc thư mục uploads/menu-pages.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-table-action admin-table-action--danger min-h-11 w-full px-2 text-[10px] sm:text-xs">Xóa ảnh</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="p-8 sm:p-10">
                <div class="admin-empty">
                    <div>
                        <p class="admin-empty__title">Chưa có ảnh thực đơn nào</p>
                        <p class="admin-empty__text">Tải ảnh đầu tiên để bắt đầu xây dựng menu cho nhóm này.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@if (Model.Images.Count > 0)
{
    <script>
        (() => {
            const selectAllInput = document.querySelector('[data-menu-image-select-all]');
            const imageSelectInputs = Array.from(document.querySelectorAll('[data-menu-image-select]'));
            const selectedCountText = document.querySelector('[data-menu-image-selected-count]');
            const bulkDeleteSubmit = document.querySelector('[data-bulk-delete-submit]');
            const bulkActionBar = document.querySelector('[data-menu-image-bulk-bar]');

            if (!selectAllInput || imageSelectInputs.length === 0 || !selectedCountText || !bulkDeleteSubmit) {
                return;
            }

            const syncSelectionState = () => {
                const checkedCount = imageSelectInputs.filter((input) => input.checked).length;
                selectedCountText.textContent = `Đã chọn ${checkedCount} ảnh`;
                bulkDeleteSubmit.disabled = checkedCount === 0;
                selectAllInput.checked = checkedCount > 0 && checkedCount === imageSelectInputs.length;
                selectAllInput.indeterminate = checkedCount > 0 && checkedCount < imageSelectInputs.length;
                bulkActionBar?.classList.toggle('admin-mobile-bulk-bar--active', checkedCount > 0);
                document.body.classList.toggle('admin-mobile-bulk-open', checkedCount > 0);
            };

            selectAllInput.addEventListener('change', () => {
                for (const input of imageSelectInputs) {
                    input.checked = selectAllInput.checked;
                }

                syncSelectionState();
            });

            for (const input of imageSelectInputs) {
                input.addEventListener('change', syncSelectionState);
            }

            syncSelectionState();
        })();
    </script>
}
