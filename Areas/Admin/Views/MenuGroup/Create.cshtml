@model KIGHolding.Areas.Admin.ViewModels.MenuGroupFormViewModel

@{
    ViewData["Title"] = "Tạo nhóm thực đơn";
}

<section class="admin-page">
    <div class="admin-page-header">
        <p class="admin-page-kicker">Menu Groups</p>
        <h1 class="admin-page-title">Tạo nhóm thực đơn</h1>
    </div>

    <div class="admin-card">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="admin-post-summary"></div>

            <div class="grid gap-5 lg:grid-cols-2">
                <div>
                    <label asp-for="Name" class="admin-post-label"></label>
                    <input asp-for="Name" class="admin-post-field" />
                    <span asp-validation-for="Name" class="admin-post-validation"></span>
                </div>
                <div>
                    <label asp-for="Slug" class="admin-post-label"></label>
                    <input asp-for="Slug" class="admin-post-field" placeholder="Để trống để tự tạo từ tên nhóm" />
                    <span asp-validation-for="Slug" class="admin-post-validation"></span>
                </div>
            </div>

            <div>
                <label asp-for="ShortDescription" class="admin-post-label"></label>
                <textarea asp-for="ShortDescription" rows="3" class="admin-post-area min-h-32"></textarea>
                <span asp-validation-for="ShortDescription" class="admin-post-validation"></span>
            </div>

            <div>
                <label asp-for="Description" class="admin-post-label"></label>
                <textarea asp-for="Description" rows="6" class="admin-post-area min-h-40" placeholder="Mô tả dài cho trang chi tiết nhóm thực đơn trong các phase sau."></textarea>
                <span asp-validation-for="Description" class="admin-post-validation"></span>
            </div>

            <div class="grid gap-5 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,0.6fr)]">
                <div>
                    <label asp-for="CoverImageUrl" class="admin-post-label"></label>
                    <input asp-for="CoverImageUrl" class="admin-post-field" placeholder="/uploads/menu-groups/example.webp hoặc URL CDN" />
                    <p class="mt-2 text-sm leading-6 text-brand-gray">Bạn có thể nhập URL ảnh bìa thủ công hoặc tải file ở khu vực bên dưới. Nếu có cả hai, ảnh tải lên sẽ được ưu tiên.</p>
                    <span asp-validation-for="CoverImageUrl" class="admin-post-validation"></span>
                </div>
                <div>
                    <label asp-for="DisplayOrder" class="admin-post-label"></label>
                    <input asp-for="DisplayOrder" type="number" min="0" class="admin-post-field" />
                    <span asp-validation-for="DisplayOrder" class="admin-post-validation"></span>
                </div>
            </div>

            <div class="admin-upload admin-upload--compact">
                <label asp-for="CoverImageFile" class="admin-upload__label"></label>
                <div class="admin-upload__dropzone">
                    <p class="admin-upload__dropzone-title">Chọn ảnh bìa nhóm thực đơn</p>
                    <p class="admin-upload__dropzone-text">Ảnh tải lên hợp lệ sẽ ghi đè giá trị URL thủ công khi lưu. Xem trước sẽ hiển thị ngay sau khi bạn chọn file.</p>
                    <input asp-for="CoverImageFile"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           class="admin-upload__input"
                           data-admin-image-preview
                           data-admin-image-preview-target="#menu-group-cover-preview"
                           data-admin-image-preview-meta="#menu-group-cover-preview-meta" />
                </div>
                <p class="admin-upload__hint">Hỗ trợ: jpg, jpeg, png, webp. Kích thước tối đa 10MB. Ảnh tải lên sẽ được ưu tiên hơn `CoverImageUrl`.</p>
                <div class="admin-upload__preview" hidden>
                    <img id="menu-group-cover-preview" alt="Xem trước ảnh bìa nhóm thực đơn đã chọn" class="admin-upload__preview-image" hidden />
                    <div class="admin-upload__preview-meta">
                        <p class="text-sm font-semibold text-brand-dark">Ảnh bìa sẽ được tải lên</p>
                        <p id="menu-group-cover-preview-meta"></p>
                    </div>
                </div>
                <span asp-validation-for="CoverImageFile" class="admin-post-validation"></span>
            </div>

            <label class="admin-post-checkbox-shell">
                <input asp-for="IsPublished" type="checkbox" class="admin-post-checkbox" />
                <span>Hiển thị công khai</span>
            </label>

            <div class="flex flex-col gap-3 border-t border-brand-border pt-6 sm:flex-row sm:justify-end">
                <button type="submit" class="btn-primary w-full sm:w-auto">Lưu nhóm thực đơn</button>
                <a asp-action="Index" class="btn-secondary w-full sm:w-auto">Hủy</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
