@model KIGHolding.Areas.Admin.ViewModels.MenuGroupIndexViewModel

@{
    ViewData["Title"] = "Quản lý nhóm thực đơn";

    var visibleCount = Model.Groups.Count(x => x.IsPublished);
    var hiddenCount = Model.Groups.Count - visibleCount;
    var coreMenuGroupSlugs = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "truyen-thuyet-champong",
        "gogimaru",
        "kbb-cook"
    };
}

<section class="admin-page">
    <div class="admin-page-header flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
            <p class="admin-page-kicker">Menu Groups</p>
            <h1 class="admin-page-title">Quản lý nhóm thực đơn</h1>
            <p class="admin-help">Theo dõi các nhóm menu thương hiệu, trạng thái hiển thị công khai và truy cập nhanh tới khu vực quản lý ảnh thực đơn.</p>
        </div>

        <a asp-action="Create" class="btn-primary w-full sm:w-auto">Tạo nhóm thực đơn</a>
    </div>

    <form method="get" asp-action="Index" class="admin-card">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,0.95fr)_auto_auto] xl:items-end">
            <div>
                <label for="q" class="admin-label mb-2">Tìm kiếm</label>
                <input id="q"
                       name="q"
                       type="search"
                       value="@Model.SearchQuery"
                       class="admin-field"
                       placeholder="Tên nhóm, slug, mô tả ngắn..." />
            </div>

            <div>
                <label for="status" class="admin-label mb-2">Trạng thái</label>
                <select id="status" name="status" class="admin-select">
                    @foreach (var option in Model.StatusOptions)
                    {
                        <option value="@option.Value" selected="@(Model.SelectedStatus == option.Value || (string.IsNullOrWhiteSpace(Model.SelectedStatus) && string.IsNullOrWhiteSpace(option.Value)) ? "selected" : null)">
                            @option.Text
                        </option>
                    }
                </select>
            </div>

            <button type="submit" class="btn-primary h-12 w-full">Lọc</button>
            <a asp-action="Index" class="btn-secondary h-12 w-full">Xóa lọc</a>
        </div>
    </form>

    <div class="admin-table-wrap">
        @if (Model.Groups.Count > 0)
        {
            <div class="border-b border-brand-border bg-brand-light/60 px-4 py-4 sm:px-6">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm font-semibold text-brand-dark">Tổng cộng @Model.TotalCount nhóm thực đơn.</p>
                    <p class="text-sm text-brand-gray">@visibleCount đang hiển thị, @hiddenCount đã ẩn.</p>
                </div>
            </div>

            <div class="hidden overflow-x-auto lg:block">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Ảnh bìa</th>
                            <th>Nhóm thực đơn</th>
                            <th>Mô tả ngắn</th>
                            <th>Thứ tự</th>
                            <th>Ảnh menu</th>
                            <th>Trạng thái</th>
                            <th>Cập nhật</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Model.Groups)
                        {
                            var descriptionPreview = string.IsNullOrWhiteSpace(group.ShortDescription)
                                ? "Chưa có mô tả ngắn."
                                : group.ShortDescription.Length > 140 ? $"{group.ShortDescription[..140]}..." : group.ShortDescription;
                            var permanentDeleteConfirm = coreMenuGroupSlugs.Contains(group.Slug)
                                ? $"XÓA VĨNH VIỄN nhóm thực đơn lõi này? Toàn bộ {group.PageImageCount} trang menu, ảnh menu và ảnh bìa liên quan sẽ bị xóa. URL công khai /thuc-don/nhom/{group.Slug} sẽ ngừng hoạt động. Không thể hoàn tác."
                                : $"XÓA VĨNH VIỄN nhóm thực đơn này? Toàn bộ {group.PageImageCount} trang menu, ảnh menu và ảnh bìa liên quan sẽ bị xóa. Không thể hoàn tác.";

                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(group.CoverImageUrl))
                                    {
                                        <img src="@group.CoverImageUrl" alt="@group.Name" class="h-14 w-24 rounded-2xl border border-brand-border object-cover" />
                                    }
                                    else
                                    {
                                        <div class="grid h-14 w-24 place-items-center rounded-2xl border border-dashed border-brand-border bg-brand-light text-center text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-gray">
                                            No cover
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="max-w-xs">
                                        <p class="font-semibold text-brand-dark">@group.Name</p>
                                        <p class="mt-1 text-xs text-brand-gray">@group.Slug</p>
                                    </div>
                                </td>
                                <td>
                                    <p class="max-w-sm text-sm leading-6 text-brand-gray">@descriptionPreview</p>
                                </td>
                                <td class="font-semibold text-brand-dark">#@group.DisplayOrder</td>
                                <td>
                                    <p class="font-semibold text-brand-dark">@group.PageImageCount</p>
                                    <p class="mt-1 text-xs text-brand-gray">trang đã tải lên</p>
                                </td>
                                <td>
                                    @if (group.IsPublished)
                                    {
                                        <span class="admin-badge admin-badge--success">Đang hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge--muted">Đã ẩn</span>
                                    }
                                </td>
                                <td>@group.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="admin-actions gap-2">
                                        <a asp-action="Images"
                                           asp-route-id="@group.Id"
                                           class="admin-table-action admin-table-action--primary">
                                            Quản lý ảnh
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@group.Id"
                                           class="admin-table-action admin-table-action--muted">
                                            Sửa
                                        </a>

                                        <form asp-action="TogglePublished"
                                              asp-route-id="@group.Id"
                                              asp-route-q="@Model.SearchQuery"
                                              asp-route-status="@Model.SelectedStatus"
                                              method="post"
                                              class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="admin-table-action admin-table-action--muted">
                                                @(group.IsPublished ? "Ẩn" : "Hiện lại")
                                            </button>
                                        </form>

                                        @if (group.IsPublished)
                                        {
                                            <form asp-action="Delete"
                                                  asp-route-id="@group.Id"
                                                  asp-route-q="@Model.SearchQuery"
                                                  asp-route-status="@Model.SelectedStatus"
                                                  method="post"
                                                  class="inline"
                                                  onsubmit="return confirm('Ẩn nhóm thực đơn này khỏi trạng thái công khai?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="admin-table-action admin-table-action--muted">Ẩn nhóm</button>
                                            </form>

                                            <span class="admin-table-action admin-table-action--muted opacity-70">Ẩn trước khi xóa</span>
                                        }
                                        else
                                        {
                                            <form asp-action="PermanentDelete"
                                                  asp-route-id="@group.Id"
                                                  asp-route-q="@Model.SearchQuery"
                                                  asp-route-status="@Model.SelectedStatus"
                                                  method="post"
                                                  class="inline"
                                                  onsubmit="return confirm('@permanentDeleteConfirm');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="admin-table-action admin-table-action--danger">Xóa vĩnh viễn</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="grid gap-4 p-3 lg:hidden">
                @foreach (var group in Model.Groups)
                {
                    var descriptionPreview = string.IsNullOrWhiteSpace(group.ShortDescription)
                        ? "Chưa có mô tả ngắn."
                        : group.ShortDescription.Length > 140 ? $"{group.ShortDescription[..140]}..." : group.ShortDescription;
                    var permanentDeleteConfirm = coreMenuGroupSlugs.Contains(group.Slug)
                        ? $"XÓA VĨNH VIỄN nhóm thực đơn lõi này? Toàn bộ {group.PageImageCount} trang menu, ảnh menu và ảnh bìa liên quan sẽ bị xóa. URL công khai /thuc-don/nhom/{group.Slug} sẽ ngừng hoạt động. Không thể hoàn tác."
                        : $"XÓA VĨNH VIỄN nhóm thực đơn này? Toàn bộ {group.PageImageCount} trang menu, ảnh menu và ảnh bìa liên quan sẽ bị xóa. Không thể hoàn tác.";

                    <article class="rounded-2xl border border-brand-border bg-brand-white p-4 shadow-soft">
                        <div class="flex gap-3">
                            @if (!string.IsNullOrWhiteSpace(group.CoverImageUrl))
                            {
                                <img src="@group.CoverImageUrl" alt="@group.Name" class="h-20 w-24 flex-none rounded-2xl border border-brand-border object-cover" />
                            }
                            else
                            {
                                <div class="grid h-20 w-24 flex-none place-items-center rounded-2xl border border-dashed border-brand-border bg-brand-light text-center text-[10px] font-semibold uppercase tracking-[0.12em] text-brand-gray">
                                    No cover
                                </div>
                            }

                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-start justify-between gap-2">
                                    <p class="break-words text-base font-black text-brand-dark">@group.Name</p>
                                    @if (group.IsPublished)
                                    {
                                        <span class="admin-badge admin-badge--success">Đang hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge--muted">Đã ẩn</span>
                                    }
                                </div>
                                <p class="mt-1 break-all text-xs text-brand-gray">@group.Slug</p>
                                <p class="mt-2 text-sm leading-6 text-brand-gray">@descriptionPreview</p>
                            </div>
                        </div>

                        <dl class="mt-4 grid grid-cols-3 gap-2 text-sm">
                            <div class="rounded-xl bg-brand-light p-3">
                                <dt class="text-[10px] font-black uppercase tracking-[0.14em] text-brand-gray">Thứ tự</dt>
                                <dd class="mt-1 font-semibold text-brand-dark">#@group.DisplayOrder</dd>
                            </div>
                            <div class="rounded-xl bg-brand-light p-3">
                                <dt class="text-[10px] font-black uppercase tracking-[0.14em] text-brand-gray">Ảnh menu</dt>
                                <dd class="mt-1 font-semibold text-brand-dark">@group.PageImageCount</dd>
                            </div>
                            <div class="rounded-xl bg-brand-light p-3">
                                <dt class="text-[10px] font-black uppercase tracking-[0.14em] text-brand-gray">Cập nhật</dt>
                                <dd class="mt-1 text-xs font-semibold text-brand-dark">@group.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd>
                            </div>
                        </dl>

                        <div class="mt-4 grid gap-2 sm:grid-cols-2">
                            <a asp-action="Images"
                               asp-route-id="@group.Id"
                               class="admin-table-action admin-table-action--primary min-h-11 w-full">
                                Quản lý ảnh
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@group.Id"
                               class="admin-table-action admin-table-action--muted min-h-11 w-full">
                                Sửa
                            </a>
                        </div>

                        <div class="mt-3 grid gap-2 border-t border-brand-border pt-3 sm:grid-cols-2">
                            <form asp-action="TogglePublished"
                                  asp-route-id="@group.Id"
                                  asp-route-q="@Model.SearchQuery"
                                  asp-route-status="@Model.SelectedStatus"
                                  method="post"
                                  class="w-full">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-table-action admin-table-action--muted min-h-11 w-full">
                                    @(group.IsPublished ? "Ẩn" : "Hiện lại")
                                </button>
                            </form>

                            @if (group.IsPublished)
                            {
                                <form asp-action="Delete"
                                      asp-route-id="@group.Id"
                                      asp-route-q="@Model.SearchQuery"
                                      asp-route-status="@Model.SelectedStatus"
                                      method="post"
                                      class="w-full"
                                      onsubmit="return confirm('Ẩn nhóm thực đơn này khỏi trạng thái công khai?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="admin-table-action admin-table-action--muted min-h-11 w-full">Ẩn nhóm</button>
                                </form>

                                <span class="admin-table-action admin-table-action--muted min-h-11 w-full justify-center opacity-70">Ẩn trước khi xóa</span>
                            }
                            else
                            {
                                <form asp-action="PermanentDelete"
                                      asp-route-id="@group.Id"
                                      asp-route-q="@Model.SearchQuery"
                                      asp-route-status="@Model.SelectedStatus"
                                      method="post"
                                      class="w-full"
                                      onsubmit="return confirm('@permanentDeleteConfirm');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="admin-table-action admin-table-action--danger min-h-11 w-full">Xóa vĩnh viễn</button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="p-6 sm:p-8">
                <div class="admin-empty">
                    <div>
                        <p class="admin-empty__title">Chưa có nhóm thực đơn phù hợp</p>
                        <p class="admin-empty__text">Hãy điều chỉnh bộ lọc hoặc tạo nhóm thực đơn mới để chuẩn bị nội dung cho menu hub thương hiệu.</p>
                        <div class="mt-6 flex flex-wrap justify-center gap-3">
                            <a asp-action="Index" class="btn-secondary">Xóa lọc</a>
                            <a asp-action="Create" class="btn-primary">Tạo nhóm thực đơn</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
