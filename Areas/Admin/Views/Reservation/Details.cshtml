@model KIGHolding.Areas.Admin.ViewModels.ReservationDetailViewModel

@{
    ViewData["Title"] = "Chi tiết đặt bàn";

    var reservationListPage = ViewData["ReservationListPage"] ?? 1;
    var reservationListSearchQuery = ViewData["ReservationListSearchQuery"];
    var reservationListStatusFilter = ViewData["ReservationListStatusFilter"];
    var reservationListBranchFilter = ViewData["ReservationListBranchFilter"];
}

<section class="admin-page">
    <div class="admin-card">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div class="max-w-3xl">
                <p class="admin-page-kicker">Reservation Detail</p>
                <h2 class="admin-card-title mt-2">@Model.CustomerName</h2>
                <p class="admin-help mt-2">Cập nhật trạng thái, theo dõi thông tin đặt bàn và ghi chú nội bộ cho ca vận hành.</p>
            </div>

            <div class="rounded-md border border-brand-border bg-brand-light px-4 py-3 text-sm text-brand-gray">
                <p class="font-semibold text-brand-dark">@Model.ReservationDate.ToString("dd/MM/yyyy") @Model.ReservationTime.ToString("HH:mm")</p>
                <p class="mt-1">@Model.BranchName</p>
            </div>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.35fr_0.9fr]">
        <div class="admin-card admin-card-muted">
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <p class="admin-label">Customer Name</p>
                    <p class="mt-2 font-semibold text-brand-dark">@Model.CustomerName</p>
                </div>
                <div>
                    <p class="admin-label">Phone</p>
                    <p class="mt-2 font-black text-brand-dark">@Model.PhoneNumber</p>
                </div>
                <div>
                    <p class="admin-label">Guest Count</p>
                    <p class="mt-2 font-semibold text-brand-dark">@Model.GuestCount</p>
                </div>
                <div>
                    <p class="admin-label">Branch</p>
                    <p class="mt-2 font-semibold text-brand-dark">@Model.BranchName</p>
                </div>
                <div>
                    <p class="admin-label">Address</p>
                    <p class="mt-2 font-semibold text-brand-dark">@Model.BranchAddress</p>
                </div>
                <div>
                    <p class="admin-label">Created</p>
                    <p class="mt-2 font-semibold text-brand-dark">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div>
                    <p class="admin-label">Updated</p>
                    <p class="mt-2 font-semibold text-brand-dark">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div>
                    <p class="admin-label">Status</p>
                    <p class="mt-2 font-semibold text-brand-dark">@Model.StatusLabel</p>
                </div>
            </div>

            <div class="mt-6">
                <p class="admin-label">Thông tin dùng bữa bổ sung</p>
                @if (string.IsNullOrWhiteSpace(Model.DiningOccasionDisplay)
                    && string.IsNullOrWhiteSpace(Model.DiningOccasionOtherNote))
                {
                    <div class="mt-2 rounded-md border border-brand-border bg-brand-white p-4 text-sm leading-6 text-brand-gray">
                        Không có thông tin bổ sung.
                    </div>
                }
                else
                {
                    <div class="mt-2 grid gap-4 sm:grid-cols-2">
                        <div class="rounded-md border border-brand-border bg-brand-white p-4">
                            <p class="admin-label">Hình thức dùng bữa</p>
                            <p class="mt-2 text-sm leading-6 text-brand-dark">
                                @(string.IsNullOrWhiteSpace(Model.DiningOccasionDisplay) ? "Không có thông tin bổ sung." : Model.DiningOccasionDisplay)
                            </p>
                        </div>
                        <div class="rounded-md border border-brand-border bg-brand-white p-4">
                            <p class="admin-label">Ghi chú hình thức khác</p>
                            <p class="mt-2 text-sm leading-6 text-brand-dark">
                                @(string.IsNullOrWhiteSpace(Model.DiningOccasionOtherNote) ? "Không có ghi chú." : Model.DiningOccasionOtherNote)
                            </p>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-6">
                <p class="admin-label">Internal Note</p>
                <div class="mt-2 rounded-md border border-brand-border bg-brand-white p-4 text-sm leading-6 text-brand-dark">
                    @(string.IsNullOrWhiteSpace(Model.Note) ? "Chưa có ghi chú nội bộ." : Model.Note)
                </div>
            </div>
        </div>

        <div class="admin-card">
            <h3 class="admin-card-title">Cập nhật trạng thái</h3>

            <form asp-area="Admin"
                  asp-controller="Reservation"
                  asp-action="UpdateStatus"
                  method="post"
                  class="mt-4 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="page" value="@reservationListPage" />
                <input type="hidden" name="searchQuery" value="@reservationListSearchQuery" />
                <input type="hidden" name="statusFilter" value="@reservationListStatusFilter" />
                <input type="hidden" name="branchFilter" value="@reservationListBranchFilter" />

                <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

                <div>
                    <label asp-for="Status" class="admin-label mb-2"></label>
                    <select asp-for="Status" asp-items="Model.StatusOptions" class="admin-select"></select>
                    <span asp-validation-for="Status" class="admin-validation"></span>
                </div>

                <div>
                    <label asp-for="Note" class="admin-label mb-2"></label>
                    <textarea asp-for="Note" rows="6" class="admin-textarea" placeholder="Ghi chú nội bộ cho bộ phận vận hành..."></textarea>
                </div>

                <button type="submit" class="btn-primary w-full">Lưu thay đổi</button>
                <a asp-area="Admin"
                   asp-controller="Reservation"
                   asp-action="Index"
                   asp-route-page="@reservationListPage"
                   asp-route-SearchQuery="@reservationListSearchQuery"
                   asp-route-StatusFilter="@reservationListStatusFilter"
                   asp-route-BranchFilter="@reservationListBranchFilter"
                   class="btn-secondary w-full justify-center">Quay lại danh sách</a>
            </form>
        </div>
    </div>
</section>
