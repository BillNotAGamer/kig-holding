@model KIGHolding.Areas.Admin.ViewModels.ReservationIndexViewModel

@{
    ViewData["Title"] = "Quản lý Đặt bàn";
}

<section class="admin-page">
    <div class="admin-page-header flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
            <p class="admin-page-kicker">Reservation Ops</p>
            <h1 class="admin-page-title">Quản lý đặt bàn</h1>
            <p class="admin-help">Theo dõi yêu cầu đặt bàn, lọc theo trạng thái hoặc chi nhánh và mở nhanh chi tiết để cập nhật tiến độ xử lý.</p>
        </div>
    </div>

    <form method="get" class="admin-card">
        <div class="grid gap-4 xl:grid-cols-[minmax(0,14rem)_minmax(0,18rem)_auto_auto] xl:items-end">
            <div>
                <label asp-for="StatusFilter" class="admin-label mb-2"></label>
                <select asp-for="StatusFilter" asp-items="Model.StatusOptions" class="admin-select"></select>
            </div>

            <div>
                <label asp-for="BranchFilter" class="admin-label mb-2"></label>
                <select asp-for="BranchFilter" asp-items="Model.BranchOptions" class="admin-select"></select>
            </div>

            <button type="submit" class="btn-primary h-12">Lọc dữ liệu</button>
            <a asp-action="Index" class="btn-secondary h-12">Xóa lọc</a>
        </div>
    </form>

    <div class="admin-table-wrap">
        @if (Model.Reservations.Any())
        {
            <div class="border-b border-brand-border bg-brand-light/60 px-4 py-4 sm:px-6">
                <p class="text-sm font-semibold text-brand-dark">Hiển thị @Model.Reservations.Count yêu cầu đặt bàn theo bộ lọc hiện tại.</p>
            </div>

            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Điện thoại</th>
                            <th>Chi nhánh</th>
                            <th>Ngày giờ</th>
                            <th>Số khách</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in Model.Reservations)
                        {
                            var statusClass = reservation.Status switch
                            {
                                ReservationStatus.Pending => "admin-badge--warning",
                                ReservationStatus.Confirmed => "admin-badge--success",
                                ReservationStatus.Arrived => "admin-badge--success",
                                ReservationStatus.Cancelled => "admin-badge--danger",
                                ReservationStatus.NoShow => "admin-badge--muted",
                                _ => "admin-badge--muted"
                            };
                            var statusDotClass = reservation.Status switch
                            {
                                ReservationStatus.Pending => "admin-status-dot--warning",
                                ReservationStatus.Confirmed => "admin-status-dot--success",
                                ReservationStatus.Arrived => "admin-status-dot--success",
                                ReservationStatus.Cancelled => "admin-status-dot--danger",
                                ReservationStatus.NoShow => "admin-status-dot--muted",
                                _ => "admin-status-dot--muted"
                            };
                            var statusLabel = reservation.Status switch
                            {
                                ReservationStatus.Pending => "Chờ xác nhận",
                                ReservationStatus.Confirmed => "Đã xác nhận",
                                ReservationStatus.Arrived => "Đã đến",
                                ReservationStatus.Cancelled => "Đã hủy",
                                ReservationStatus.NoShow => "Không đến",
                                _ => reservation.Status.ToString()
                            };
                            var rowClass = reservation.Status == ReservationStatus.Pending
                                ? "admin-row-highlight admin-row-highlight--warning"
                                : string.Empty;

                            <tr class="@rowClass">
                                <td>
                                    <p class="font-semibold text-brand-dark">@reservation.CustomerName</p>
                                    @if (reservation.Status == ReservationStatus.Pending)
                                    {
                                        <p class="mt-1 text-xs font-semibold uppercase tracking-[0.14em] text-amber-700">Cần xác nhận</p>
                                    }
                                </td>
                                <td class="font-semibold text-brand-dark">@reservation.PhoneNumber</td>
                                <td>@reservation.BranchName</td>
                                <td>
                                    <p class="font-semibold text-brand-dark">@reservation.ReservationDate.ToString("dd/MM/yyyy")</p>
                                    <p class="mt-1 text-xs text-brand-gray">@reservation.ReservationTime.ToString("HH:mm")</p>
                                </td>
                                <td class="font-semibold text-brand-dark">@reservation.GuestCount</td>
                                <td>
                                    <span class="admin-badge @statusClass">
                                        <span class="admin-status-dot @statusDotClass"></span>
                                        @statusLabel
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@reservation.Id" class="admin-table-action admin-table-action--primary">Xem chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-6 sm:p-8">
                <div class="admin-empty">
                    <div>
                        <p class="admin-empty__title">Không có đặt bàn phù hợp</p>
                        <p class="admin-empty__text">Không có yêu cầu đặt bàn nào khớp với bộ lọc hiện tại. Hãy điều chỉnh trạng thái hoặc chi nhánh để xem thêm kết quả.</p>
                        <a asp-action="Index" class="btn-secondary mt-6">Xóa lọc</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
