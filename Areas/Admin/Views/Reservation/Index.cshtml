@model KIGHolding.Areas.Admin.ViewModels.ReservationIndexViewModel

@{
    ViewData["Title"] = "Quản lý Đặt bàn";
}

<section class="admin-page">
    <div class="admin-page-header flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
            <p class="admin-page-kicker">Reservation Ops</p>
            <h1 class="admin-page-title">Quản lý đặt bàn</h1>
            <p class="admin-help">Theo dõi yêu cầu đặt bàn, lọc theo trạng thái hoặc chi nhánh và mở nhanh chi tiết để cập nhật tiến độ xử lý.</p>
        </div>
    </div>

    <form method="get" class="admin-card">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-[minmax(0,20rem)_minmax(0,14rem)_minmax(0,18rem)_auto_auto] xl:items-end">
            <div>
                <label asp-for="SearchQuery" class="admin-label mb-2"></label>
                <input asp-for="SearchQuery" class="admin-field h-12" placeholder="Tên khách hoặc số điện thoại..." />
            </div>

            <div>
                <label asp-for="StatusFilter" class="admin-label mb-2"></label>
                <select asp-for="StatusFilter" asp-items="Model.StatusOptions" class="admin-select"></select>
            </div>

            <div>
                <label asp-for="BranchFilter" class="admin-label mb-2"></label>
                <select asp-for="BranchFilter" asp-items="Model.BranchOptions" class="admin-select"></select>
            </div>

            <button type="submit" class="btn-primary h-12 w-full">Lọc dữ liệu</button>
            <a asp-action="Index" class="btn-secondary h-12 w-full">Xóa lọc</a>
        </div>
    </form>

    <div class="admin-table-wrap">
        @if (Model.Reservations.Any())
        {
            <div class="border-b border-brand-border bg-brand-light/60 px-4 py-4 sm:px-6">
                <p class="text-sm font-semibold text-brand-dark">Hiển thị @Model.Reservations.Count yêu cầu đặt bàn theo bộ lọc hiện tại.</p>
            </div>

            <div class="hidden overflow-x-auto md:block">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Điện thoại</th>
                            <th>Chi nhánh</th>
                            <th>Ngày giờ</th>
                            <th>Số khách</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in Model.Reservations)
                        {
                            var statusClass = reservation.Status switch
                            {
                                ReservationStatus.Pending => "admin-badge--warning",
                                ReservationStatus.Confirmed => "admin-badge--muted",
                                ReservationStatus.Arrived => "admin-badge--success",
                                ReservationStatus.NoShow => "admin-badge--success",
                                ReservationStatus.Cancelled => "admin-badge--danger",
                                _ => "admin-badge--muted"
                            };
                            var statusDotClass = reservation.Status switch
                            {
                                ReservationStatus.Pending => "admin-status-dot--warning",
                                ReservationStatus.Confirmed => "admin-status-dot--muted",
                                ReservationStatus.Arrived => "admin-status-dot--success",
                                ReservationStatus.NoShow => "admin-status-dot--success",
                                ReservationStatus.Cancelled => "admin-status-dot--danger",
                                _ => "admin-status-dot--muted"
                            };
                            var rowClass = reservation.Status == ReservationStatus.Pending
                                ? "admin-row-highlight admin-row-highlight--warning"
                                : string.Empty;

                            <tr class="@rowClass">
                                <td>
                                    <p class="font-semibold text-brand-dark">@reservation.CustomerName</p>
                                    @if (reservation.Status == ReservationStatus.Pending)
                                    {
                                        <p class="mt-1 text-xs font-semibold uppercase tracking-[0.14em] text-amber-700">Chờ duyệt</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(reservation.DiningOccasionDisplay))
                                    {
                                        <div class="mt-2 space-y-1 text-xs leading-5 text-brand-gray">
                                            @if (!string.IsNullOrWhiteSpace(reservation.DiningOccasionDisplay))
                                            {
                                                <p><span class="font-semibold text-brand-dark">Hình thức:</span> @reservation.DiningOccasionDisplay</p>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="font-semibold text-brand-dark">@reservation.PhoneNumber</td>
                                <td>@reservation.BranchName</td>
                                <td>
                                    <p class="font-semibold text-brand-dark">@reservation.ReservationDate.ToString("dd/MM/yyyy")</p>
                                    <p class="mt-1 text-xs text-brand-gray">@reservation.ReservationTime.ToString("HH:mm")</p>
                                </td>
                                <td class="font-semibold text-brand-dark">@reservation.GuestCount</td>
                                <td>
                                    <span class="admin-badge @statusClass">
                                        <span class="admin-status-dot @statusDotClass"></span>
                                        @reservation.StatusLabel
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@reservation.Id" class="admin-table-action admin-table-action--primary">Xem chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="grid gap-3 p-3 md:hidden">
                @foreach (var reservation in Model.Reservations)
                {
                    var statusClass = reservation.Status switch
                    {
                        ReservationStatus.Pending => "admin-badge--warning",
                        ReservationStatus.Confirmed => "admin-badge--muted",
                        ReservationStatus.Arrived => "admin-badge--success",
                        ReservationStatus.NoShow => "admin-badge--success",
                        ReservationStatus.Cancelled => "admin-badge--danger",
                        _ => "admin-badge--muted"
                    };
                    var statusDotClass = reservation.Status switch
                    {
                        ReservationStatus.Pending => "admin-status-dot--warning",
                        ReservationStatus.Confirmed => "admin-status-dot--muted",
                        ReservationStatus.Arrived => "admin-status-dot--success",
                        ReservationStatus.NoShow => "admin-status-dot--success",
                        ReservationStatus.Cancelled => "admin-status-dot--danger",
                        _ => "admin-status-dot--muted"
                    };
                    var cardClass = reservation.Status == ReservationStatus.Pending
                        ? "border-amber-200 bg-amber-50/60"
                        : "border-brand-border bg-brand-white";

                    <article class="rounded-2xl border @cardClass p-4 shadow-soft">
                        <div class="flex flex-col gap-3">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="break-words text-base font-black text-brand-dark">@reservation.CustomerName</p>
                                    <p class="mt-1 text-sm font-semibold text-brand-gray">@reservation.BranchName</p>
                                </div>
                                <span class="admin-badge @statusClass">
                                    <span class="admin-status-dot @statusDotClass"></span>
                                    @reservation.StatusLabel
                                </span>
                            </div>

                            <dl class="grid grid-cols-2 gap-3 text-sm">
                                <div class="rounded-xl bg-brand-light p-3">
                                    <dt class="text-[11px] font-black uppercase tracking-[0.14em] text-brand-gray">Thời gian</dt>
                                    <dd class="mt-1 font-semibold text-brand-dark">@reservation.ReservationDate.ToString("dd/MM/yyyy") @reservation.ReservationTime.ToString("HH:mm")</dd>
                                </div>
                                <div class="rounded-xl bg-brand-light p-3">
                                    <dt class="text-[11px] font-black uppercase tracking-[0.14em] text-brand-gray">Số khách</dt>
                                    <dd class="mt-1 font-semibold text-brand-dark">@reservation.GuestCount</dd>
                                </div>
                                <div class="col-span-2 rounded-xl bg-brand-light p-3">
                                    <dt class="text-[11px] font-black uppercase tracking-[0.14em] text-brand-gray">Điện thoại</dt>
                                    <dd class="mt-1 break-words font-semibold text-brand-dark">@reservation.PhoneNumber</dd>
                                </div>
                            </dl>

                            @if (!string.IsNullOrWhiteSpace(reservation.DiningOccasionDisplay))
                            {
                                <div class="space-y-1 rounded-xl bg-brand-light px-3 py-3 text-sm leading-6 text-brand-gray">
                                    @if (!string.IsNullOrWhiteSpace(reservation.DiningOccasionDisplay))
                                    {
                                        <p><span class="font-semibold text-brand-dark">Hình thức:</span> @reservation.DiningOccasionDisplay</p>
                                    }
                                </div>
                            }

                            <a asp-action="Details" asp-route-id="@reservation.Id" class="admin-table-action admin-table-action--primary min-h-11 w-full">Xem chi tiết</a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="p-6 sm:p-8">
                <div class="admin-empty">
                    <div>
                        <p class="admin-empty__title">Không có đặt bàn phù hợp</p>
                        <p class="admin-empty__text">Không có yêu cầu đặt bàn nào khớp với bộ lọc hiện tại. Hãy điều chỉnh tìm kiếm, trạng thái hoặc chi nhánh để xem thêm kết quả.</p>
                        <a asp-action="Index" class="btn-secondary mt-6">Xóa lọc</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
